-- =============================================================================
-- Register all builtins into the registry
-- =============================================================================
## _nebula_builtins["line_nums"]  = nebula_builtin_line_nums
## _nebula_builtins["status_bar"] = nebula_builtin_status_bar
## _nebula_builtins["search_bar"] = nebula_builtin_search_bar
## _nebula_builtins["edit_area"]  = nebula_builtin_edit_area
## _nebula_builtins["term_grid"]  = nebula_builtin_term_grid
