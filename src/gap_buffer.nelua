-- gap_buffer.nelua
-- Nebula GUI Compiler — Phase 3.6.1
--
-- 编译期定容 Gap Buffer（Compile-Time Fixed-Capacity Gap Buffer）
--
-- ★ BUG-6 已修复：此文件现在委托给 derive/gap_buffer_factory.lua，
--   消除了代码重复。所有 Gap Buffer 逻辑由 factory 统一维护。
--   本文件仅负责加载 factory 模块并重新导出 nebula_gen_gap_buffer_type()，
--   供独立 require "gap_buffer" 使用（含测试）。
--
-- 设计哲学：
--   · 零堆分配：底层由编译期固定大小的 [N]uint8 静态数组支撑（heapless 模式）
--   · 持久状态：存活在组件 Record 中，跨帧不丢失（与 Frame Arena 正交）
--   · 声明意图：通过 nebula_derive 的 max_text_len 参数在编译期确定容量
--   · 零运行时开销：所有方法均为内联展开的显式操作，无虚分发、无 GC
--
-- Gap Buffer 内存布局：
--
--   [ left_text | GAP (空洞) | right_text ]
--   ^           ^            ^            ^
--   0        gap_start    gap_end       capacity
--
--   · gap_start：光标位置（也是 gap 的起始）
--   · gap_end：gap 的结束（right_text 的起始）
--   · 文本长度 = capacity - (gap_end - gap_start)
--   · 插入字符：写入 buf[gap_start]，gap_start++（O(1)）
--   · 删除字符（Backspace）：gap_start--（O(1)）
--   · 删除字符（Delete）：gap_end++（O(1)）
--   · 移动光标：memmove gap 内容（O(N)，但 N 通常很小）
--
-- 使用方式（由 nebula_derive 自动生成，开发者无需手动调用）：
--
--   ## nebula_annotate("InputVisual", {
--        ...
--        primitives = {"hoverable", "clickable", "focusable", "editable"},
--        max_text_len = 256,   -- 编译期声明最大容量
--      })
--
-- =============================================================================

-- =============================================================================
-- ★ BUG-6 修复：委托给 derive/gap_buffer_factory.lua
--
-- 通过 require 加载 factory 模块，复用同一份 nebula_gen_gap_buffer_type() 实现。
-- 当 gap_buffer.nelua 被独立 require 时（如测试），factory 函数也会被加载到
-- 编译期全局环境中，无需手动 require "nebula_core"。
-- =============================================================================
##[[
if not nebula_gen_gap_buffer_type then
  require "derive.gap_buffer_factory"
end
]]

-- =============================================================================
-- 版本标记（供 nebula_core.nelua 版本断言使用）
-- =============================================================================
##[[
nebula_gap_buffer_version = "v0.3_phase4.x_bug6_fix"
]]
