-- =============================================================================
-- primitives.nelua
-- Nebula GUI Compiler — 交互原语层（Interaction Primitive Layer）
-- Phase 0 实现：Hoverable + Clickable
-- =============================================================================

require "nebula_core"
require "glfw_bindings"

-- =============================================================================
-- HoverableState：AABB 碰撞检测原语
-- =============================================================================
global HoverableState = @record{
  is_hovered:  boolean,
  just_entered: boolean,
  just_left:    boolean,
}

function HoverableState:update(
  mx: float32, my: float32,
  px: float32, py: float32,
  sw: float32, sh: float32
): void
  local prev_hovered = self.is_hovered
  -- AABB 碰撞检测
  self.is_hovered = (mx >= px and mx <= px + sw and
                     my >= py and my <= py + sh)
  self.just_entered = (self.is_hovered and not prev_hovered)
  self.just_left    = (not self.is_hovered and prev_hovered)
end

-- =============================================================================
-- ClickableState：鼠标按键状态原语（依赖 HoverableState）
-- =============================================================================
global ClickableState = @record{
  is_pressed:   boolean,
  just_clicked: boolean,
}

function ClickableState:update(hover: *HoverableState, is_btn_down: boolean): void
  local was_pressed = self.is_pressed
  self.is_pressed   = hover.is_hovered and is_btn_down
  -- just_clicked：从按下到释放的瞬间（在悬停区域内）
  self.just_clicked = (was_pressed and not self.is_pressed and hover.is_hovered)
end
