-- =============================================================================
-- nebula_editor.nelua — Nebula Editor Support Module
--
-- ★ P1-2 refactor: 从 app.nelua 提取的编辑器专属代码。
-- 包含搜索/替换状态、文件状态、窗口标题更新等编辑器功能。
-- 非编辑器应用无需 require 此模块。
--
-- 前置依赖：
--   · require "glfw_bindings"  — glfwSetWindowTitle
--   · _nebula_window           — 由 app.nelua 声明的全局窗口句柄
--   因此本模块应在 app.nelua 之后加载（编辑器 builtin 和 nebula_editor_main
--   会在编译期自动 require 本模块，无需手动处理加载顺序）。
--
-- 使用方式：
--   require "nebula_editor"  -- 编辑器 builtin 自动 require，一般无需手动添加
-- =============================================================================

require "glfw_bindings"
require "cstdlib_bindings"
require "nebula_constants"

-- ★ Phase 5.0 S5: MatchPos 类型始终声明（App Record 模式也需要）
global MatchPos = @record{ row: uint32, col: uint32 }

-- ★ Phase 5.0 S5: NebulaEditorState — 编辑器状态封装
-- 将原来的文件级全局变量整合为一个 record，供 App Record 模式使用。
-- 旧 demo 通过 NEBULA_EDITOR_GLOBALS_DEFINED 仍可使用全局变量。
global NebulaEditorState = @record{
  search_active:     boolean,
  search_replace:    boolean,
  search_buf:        [NEBULA_SEARCH_BUF_SIZE]uint8,
  search_len:        uint32,
  search_cursor:     uint32,
  replace_buf:       [NEBULA_REPLACE_BUF_SIZE]uint8,
  replace_len:       uint32,
  replace_cursor:    uint32,
  search_matches:    [NEBULA_MAX_SEARCH_MATCHES]MatchPos,
  search_match_count: uint32,
  search_current:    uint32,
  search_overflow:   boolean,
  file_path:         [NEBULA_FILE_PATH_BUF_SIZE]uint8,
  has_file:          boolean,
  modified:          boolean,
  highlight_id:      uint32,
}

-- ★ Phase 5.0 S5: App Record 模式的参数化函数
-- 所有函数接受 es: *NebulaEditorState 参数，不依赖任何全局变量。

-- nebula_editor_update_title_es — 更新窗口标题（App Record 模式）
global function nebula_editor_update_title_es(es: *NebulaEditorState, cursor_row: uint32, cursor_col: uint32): void
  local title: [NEBULA_TITLE_BUF_SIZE]uint8
  local fname: cstring
  if es.has_file then
    local last_slash: int32 = -1
    local fi: uint32 = 0
    while es.file_path[fi] ~= 0 and fi < 4095 do
      if es.file_path[fi] == NEBULA_CHAR_SLASH then last_slash = (@int32)(fi) end
      fi = fi + 1
    end
    local start: uint32 = last_slash >= 0 and (@uint32)(last_slash + 1) or 0
    fname = (@cstring)(&es.file_path[start])
  else
    fname = "[untitled]"
  end
  local mod_mark: cstring = es.modified and " [+]" or ""
  local sn = snprintf((@cstring)(&title[0]), 255,
    "%s%s — Ln %d, Col %d — Nebula Editor",
    fname, mod_mark,
    (@int32)(cursor_row + 1), (@int32)(cursor_col + 1))
  glfwSetWindowTitle(_nebula_window, (@cstring)(&title[0]))
end

-- nebula_search_scan_es — 朴素 O(n*m) 全文匹配扫描（App Record 模式）
global function nebula_search_scan_es(es: *NebulaEditorState, mb: auto): void
  es.search_match_count = 0
  es.search_current = 0
  es.search_overflow = false
  if es.search_len == 0 then return end
  local total_lines: uint32 = mb.line_count
  local row: uint32 = 0
  while row < total_lines and es.search_match_count < NEBULA_MAX_SEARCH_MATCHES do
    local ln = mb:get_line(row)
    local flat: [1024]uint8
    local line_len = ln:flatten(&flat[0], 1023)
    local end_pos: uint32 = line_len > es.search_len and (line_len - es.search_len + 1) or 0
    local ci: uint32 = 0
    while ci < end_pos and es.search_match_count < NEBULA_MAX_SEARCH_MATCHES do
      local match: boolean = true
      local k: uint32 = 0
      while k < es.search_len do
        if flat[ci + k] ~= es.search_buf[k] then match = false; break end
        k = k + 1
      end
      if match then
        es.search_matches[es.search_match_count].row = row
        es.search_matches[es.search_match_count].col = ci
        es.search_match_count = es.search_match_count + 1
        ci = ci + es.search_len
      else
        ci = ci + 1
      end
    end
    row = row + 1
  end
  if row < total_lines and es.search_match_count >= NEBULA_MAX_SEARCH_MATCHES then
    es.search_overflow = true
  end
end

-- nebula_search_goto_current_es — 跳转到当前匹配位置（App Record 模式）
global function nebula_search_goto_current_es(es: *NebulaEditorState, editor: auto): void
  if es.search_match_count == 0 then return end
  if es.search_current >= es.search_match_count then es.search_current = 0 end
  local m = es.search_matches[es.search_current]
  editor.cursor_row = m.row
  editor.cursor_col = m.col
  local visible_top = editor.scroll_offset_y
  local visible_bot = visible_top + editor.visual.size.y / NEBULA_EDITOR_LINE_HEIGHT
  if (@float32)(m.row) < visible_top or (@float32)(m.row) > visible_bot then
    editor.scroll_offset_y = (@float32)(m.row) * NEBULA_EDITOR_LINE_HEIGHT - editor.visual.size.y * 0.5
    if editor.scroll_offset_y < 0.0 then editor.scroll_offset_y = 0.0 end
  end
end

-- nebula_search_replace_current_es — 替换当前匹配（App Record 模式）
global function nebula_search_replace_current_es(es: *NebulaEditorState, editor: auto, mb: auto): void
  if es.search_match_count == 0 or es.replace_len == 0 then return end
  if es.search_current >= es.search_match_count then return end
  local m = es.search_matches[es.search_current]
  local ln = mb:get_line(m.row)
  -- ★ P0-4 fix: 替换前检查 gap buffer 容量
  if es.replace_len > es.search_len then
    local extra_needed = (@uint16)(es.replace_len - es.search_len)
    local gap_avail = ln.gap_end - ln.gap_start
    if gap_avail < extra_needed then
      printf("wgpu: search_replace_current: gap buffer overflow prevented (need %u, have %u)\n",
        (@uint32)(extra_needed), (@uint32)(gap_avail))
      es.search_overflow = true
      return
    end
  end
  ln:delete_range(m.col, m.col + es.search_len)
  local ins_i: uint32 = 0
  while ins_i < es.replace_len do
    ln:insert_char(es.replace_buf[ins_i])
    ins_i = ins_i + 1
  end
  es.modified = true
  nebula_search_scan_es(es, mb)
  if es.search_current >= es.search_match_count and es.search_match_count > 0 then
    es.search_current = es.search_match_count - 1
  end
  nebula_search_goto_current_es(es, editor)
end

-- nebula_search_replace_all_es — 从后往前替换全部匹配（App Record 模式）
global function nebula_search_replace_all_es(es: *NebulaEditorState, editor: auto, mb: auto): void
  if es.search_match_count == 0 or es.replace_len == 0 then return end
  local i: int32 = (@int32)(es.search_match_count) - 1
  while i >= 0 do
    local m = es.search_matches[(@uint32)(i)]
    local ln = mb:get_line(m.row)
    -- ★ P0-4 fix: 替换前检查 gap buffer 容量
    if es.replace_len > es.search_len then
      local extra_needed = (@uint16)(es.replace_len - es.search_len)
      local gap_avail = ln.gap_end - ln.gap_start
      if gap_avail < extra_needed then
        printf("wgpu: search_replace_all: gap buffer overflow prevented at row %u (need %u, have %u)\n",
          m.row, (@uint32)(extra_needed), (@uint32)(gap_avail))
        es.search_overflow = true
        i = i - 1
        continue
      end
    end
    ln:delete_range(m.col, m.col + es.search_len)
    local ins_j: uint32 = 0
    while ins_j < es.replace_len do
      ln:insert_char(es.replace_buf[ins_j])
      ins_j = ins_j + 1
    end
    i = i - 1
  end
  es.modified = true
  nebula_search_scan_es(es, mb)
end

-- =============================================================================
-- ★ Phase 5.0 S5: 旧版全局变量模式（向后兼容）
-- 当 NEBULA_EDITOR_GLOBALS_DEFINED 未设置时，声明全局变量并提供
-- 原始的全局函数（与 v1/v2/v3 demo 兼容）。
-- =============================================================================
## if not NEBULA_EDITOR_GLOBALS_DEFINED then
global _search_active: boolean = false
global _search_replace: boolean = false
global _search_buf: [NEBULA_SEARCH_BUF_SIZE]uint8
global _search_len: uint32 = 0
global _search_cursor: uint32 = 0
global _replace_buf: [NEBULA_REPLACE_BUF_SIZE]uint8
global _replace_len: uint32 = 0
global _replace_cursor: uint32 = 0
global _search_matches: [NEBULA_MAX_SEARCH_MATCHES]MatchPos
global _search_match_count: uint32 = 0
global _search_current: uint32 = 0
global _search_overflow: boolean = false

global _editor_file_path: [NEBULA_FILE_PATH_BUF_SIZE]uint8
global _editor_has_file: boolean = false
global _editor_modified: boolean = false
global _editor_highlight_id: uint32 = 0

-- nebula_editor_update_title — 更新窗口标题（全局变量模式）
global function nebula_editor_update_title(cursor_row: uint32, cursor_col: uint32): void
  local title: [NEBULA_TITLE_BUF_SIZE]uint8
  local fname: cstring
  if _editor_has_file then
    local last_slash: int32 = -1
    local fi: uint32 = 0
    while _editor_file_path[fi] ~= 0 and fi < 4095 do
      if _editor_file_path[fi] == NEBULA_CHAR_SLASH then last_slash = (@int32)(fi) end
      fi = fi + 1
    end
    local start: uint32 = last_slash >= 0 and (@uint32)(last_slash + 1) or 0
    fname = (@cstring)(&_editor_file_path[start])
  else
    fname = "[untitled]"
  end
  local mod_mark: cstring = _editor_modified and " [+]" or ""
  local sn = snprintf((@cstring)(&title[0]), 255,
    "%s%s — Ln %d, Col %d — Nebula Editor",
    fname, mod_mark,
    (@int32)(cursor_row + 1), (@int32)(cursor_col + 1))
  glfwSetWindowTitle(_nebula_window, (@cstring)(&title[0]))
end

-- nebula_search_scan — 朴素 O(n*m) 全文匹配扫描
global function nebula_search_scan(mb: auto): void
  _search_match_count = 0
  _search_current = 0
  _search_overflow = false
  if _search_len == 0 then return end
  local total_lines: uint32 = mb.line_count
  local row: uint32 = 0
  while row < total_lines and _search_match_count < NEBULA_MAX_SEARCH_MATCHES do
    local ln = mb:get_line(row)
    local flat: [1024]uint8
    local line_len = ln:flatten(&flat[0], 1023)
    local end_pos: uint32 = line_len > _search_len and (line_len - _search_len + 1) or 0
    local ci: uint32 = 0
    while ci < end_pos and _search_match_count < NEBULA_MAX_SEARCH_MATCHES do
      local match: boolean = true
      local k: uint32 = 0
      while k < _search_len do
        if flat[ci + k] ~= _search_buf[k] then match = false; break end
        k = k + 1
      end
      if match then
        _search_matches[_search_match_count].row = row
        _search_matches[_search_match_count].col = ci
        _search_match_count = _search_match_count + 1
        ci = ci + _search_len
      else
        ci = ci + 1
      end
    end
    row = row + 1
  end
  if row < total_lines and _search_match_count >= NEBULA_MAX_SEARCH_MATCHES then
    _search_overflow = true
  end
end

-- nebula_search_goto_current — 跳转到当前匹配位置
global function nebula_search_goto_current(editor: auto): void
  if _search_match_count == 0 then return end
  if _search_current >= _search_match_count then _search_current = 0 end
  local m = _search_matches[_search_current]
  editor.cursor_row = m.row
  editor.cursor_col = m.col
  local visible_top = editor.scroll_offset_y
  local visible_bot = visible_top + editor.visual.size.y / NEBULA_EDITOR_LINE_HEIGHT
  if (@float32)(m.row) < visible_top or (@float32)(m.row) > visible_bot then
    editor.scroll_offset_y = (@float32)(m.row) * NEBULA_EDITOR_LINE_HEIGHT - editor.visual.size.y * 0.5
    if editor.scroll_offset_y < 0.0 then editor.scroll_offset_y = 0.0 end
  end
end

-- nebula_search_replace_current — 替换当前匹配
global function nebula_search_replace_current(editor: auto, mb: auto): void
  if _search_match_count == 0 or _replace_len == 0 then return end
  if _search_current >= _search_match_count then return end
  local m = _search_matches[_search_current]
  local ln = mb:get_line(m.row)
  -- ★ P0-4 fix: 替换前检查 gap buffer 容量
  if _replace_len > _search_len then
    local extra_needed = (@uint16)(_replace_len - _search_len)
    local gap_avail = ln.gap_end - ln.gap_start
    if gap_avail < extra_needed then
      printf("wgpu: search_replace_current: gap buffer overflow prevented (need %u, have %u)\n",
        (@uint32)(extra_needed), (@uint32)(gap_avail))
      _search_overflow = true
      return
    end
  end
  ln:delete_range(m.col, m.col + _search_len)
  local ins_i: uint32 = 0
  while ins_i < _replace_len do
    ln:insert_char(_replace_buf[ins_i])
    ins_i = ins_i + 1
  end
  _editor_modified = true
  nebula_search_scan(mb)
  if _search_current >= _search_match_count and _search_match_count > 0 then
    _search_current = _search_match_count - 1
  end
  nebula_search_goto_current(editor)
end

-- nebula_search_replace_all — 从后往前替换全部匹配
global function nebula_search_replace_all(editor: auto, mb: auto): void
  if _search_match_count == 0 or _replace_len == 0 then return end
  local i: int32 = (@int32)(_search_match_count) - 1
  while i >= 0 do
    local m = _search_matches[(@uint32)(i)]
    local ln = mb:get_line(m.row)
    -- ★ P0-4 fix: 替换前检查 gap buffer 容量
    if _replace_len > _search_len then
      local extra_needed = (@uint16)(_replace_len - _search_len)
      local gap_avail = ln.gap_end - ln.gap_start
      if gap_avail < extra_needed then
        printf("wgpu: search_replace_all: gap buffer overflow prevented at row %u (need %u, have %u)\n",
          m.row, (@uint32)(extra_needed), (@uint32)(gap_avail))
        _search_overflow = true
        i = i - 1
        continue
      end
    end
    ln:delete_range(m.col, m.col + _search_len)
    local ins_j: uint32 = 0
    while ins_j < _replace_len do
      ln:insert_char(_replace_buf[ins_j])
      ins_j = ins_j + 1
    end
    i = i - 1
  end
  _editor_modified = true
  nebula_search_scan(mb)
end
## end
