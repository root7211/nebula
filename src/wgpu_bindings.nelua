-- =============================================================================
-- wgpu_bindings.nelua
-- wgpu-native v29.0.0.0 的 Nelua C 绑定
-- 只绑定 Phase 0 所需的最小 API 子集
-- =============================================================================

-- 链接与头文件：根据目标平台条件编译
## if NEBULA_TARGET ~= 'wasm' then
-- Native: 链接 wgpu-native 动态库，引入 wgpu-native 头文件
## linklib "wgpu_native"
## cdefine "WGPU_SKIP_PROCS"
## cinclude "<webgpu/webgpu.h>"
## cinclude "<webgpu/wgpu.h>"
## else
-- WASM: Emscripten 通过 -sUSE_WEBGPU=1 提供标准 WebGPU C bindings
-- 无需 linklib，无需 wgpu.h（wgpu-native 扩展不存在于浏览器端）
## cinclude "<webgpu/webgpu.h>"
## end

-- =============================================================================
-- 基础类型绑定（Opaque Handles）
-- =============================================================================
global WGPUInstance         <cimport, nodecl> = @pointer
global WGPUAdapter          <cimport, nodecl> = @pointer
global WGPUDevice           <cimport, nodecl> = @pointer
global WGPUQueue            <cimport, nodecl> = @pointer
global WGPUSurface          <cimport, nodecl> = @pointer
global WGPUSwapChain        <cimport, nodecl> = @pointer
global WGPURenderPipeline   <cimport, nodecl> = @pointer
global WGPUBuffer           <cimport, nodecl> = @pointer
global WGPUBindGroup        <cimport, nodecl> = @pointer
global WGPUBindGroupLayout  <cimport, nodecl> = @pointer
global WGPUPipelineLayout   <cimport, nodecl> = @pointer
global WGPUShaderModule     <cimport, nodecl> = @pointer
global WGPUCommandEncoder   <cimport, nodecl> = @pointer
global WGPURenderPassEncoder <cimport, nodecl> = @pointer
global WGPUCommandBuffer    <cimport, nodecl> = @pointer
global WGPUTextureView      <cimport, nodecl> = @pointer
global WGPUTexture          <cimport, nodecl> = @pointer

-- =============================================================================
-- WGPUStringView（v25+ 引入，替代裸 cstring）
-- =============================================================================
global WGPUStringView <cimport, nodecl> = @record{
  data:   cstring,
  length: csize,
}

-- 辅助函数：从 Nelua 字符串创建 WGPUStringView
global function wgpu_str(s: string): WGPUStringView
  return WGPUStringView{ data = s.data, length = #s }
end

-- 空字符串视图（用于可选 label）
global function wgpu_str_null(): WGPUStringView
  return WGPUStringView{ data = nilptr, length = 0 }
end

-- =============================================================================
-- 枚举类型（仅绑定 Phase 0 所需）
-- =============================================================================
global WGPUTextureFormat = @uint32
global WGPUTextureFormat_Undefined  <comptime> = (@WGPUTextureFormat)(0x00000000)
global WGPUTextureFormat_R8Unorm    <comptime> = (@WGPUTextureFormat)(0x00000001)
global WGPUTextureFormat_RGBA8Unorm <comptime> = (@WGPUTextureFormat)(0x00000012)
global WGPUTextureFormat_BGRA8Unorm <comptime> = (@WGPUTextureFormat)(0x00000017)

global WGPUPresentMode = @uint32
global WGPUPresentMode_Undefined <comptime> = (@WGPUPresentMode)(0x00000000)
global WGPUPresentMode_Fifo      <comptime> = (@WGPUPresentMode)(0x00000001)
global WGPUPresentMode_FifoRelaxed <comptime> = (@WGPUPresentMode)(0x00000002)
global WGPUPresentMode_Immediate <comptime> = (@WGPUPresentMode)(0x00000003)
global WGPUPresentMode_Mailbox   <comptime> = (@WGPUPresentMode)(0x00000004)

global WGPULoadOp = @uint32
global WGPULoadOp_Clear <comptime> = (@WGPULoadOp)(0x00000002)
global WGPULoadOp_Load  <comptime> = (@WGPULoadOp)(0x00000003)

global WGPUStoreOp = @uint32
global WGPUStoreOp_Store   <comptime> = (@WGPUStoreOp)(0x00000002)
global WGPUStoreOp_Discard <comptime> = (@WGPUStoreOp)(0x00000003)

global WGPUBufferUsage = @uint32
global WGPUBufferUsage_None         <comptime> = (@WGPUBufferUsage)(0x00000000)
global WGPUBufferUsage_MapRead      <comptime> = (@WGPUBufferUsage)(0x00000001)
global WGPUBufferUsage_MapWrite     <comptime> = (@WGPUBufferUsage)(0x00000002)
global WGPUBufferUsage_CopySrc      <comptime> = (@WGPUBufferUsage)(0x00000004)
global WGPUBufferUsage_CopyDst      <comptime> = (@WGPUBufferUsage)(0x00000008)
global WGPUBufferUsage_Index        <comptime> = (@WGPUBufferUsage)(0x00000010)
global WGPUBufferUsage_Vertex       <comptime> = (@WGPUBufferUsage)(0x00000020)
global WGPUBufferUsage_Uniform      <comptime> = (@WGPUBufferUsage)(0x00000040)
global WGPUBufferUsage_Storage      <comptime> = (@WGPUBufferUsage)(0x00000080)
global WGPUBufferUsage_Indirect     <comptime> = (@WGPUBufferUsage)(0x00000100)
global WGPUBufferUsage_QueryResolve <comptime> = (@WGPUBufferUsage)(0x00000200)

global WGPUVertexFormat = @uint32
global WGPUVertexFormat_Float32x2 <comptime> = (@WGPUVertexFormat)(0x0000001D)
global WGPUVertexFormat_Float32x4 <comptime> = (@WGPUVertexFormat)(0x0000001F)

global WGPUVertexStepMode = @uint32
global WGPUVertexStepMode_Undefined <comptime> = (@WGPUVertexStepMode)(0x00000001)
global WGPUVertexStepMode_Vertex    <comptime> = (@WGPUVertexStepMode)(0x00000002)
global WGPUVertexStepMode_Instance  <comptime> = (@WGPUVertexStepMode)(0x00000003)

global WGPUShaderStage = @uint64
global WGPUShaderStage_Vertex   <comptime> = (@WGPUShaderStage)(0x00000001)
global WGPUShaderStage_Fragment <comptime> = (@WGPUShaderStage)(0x00000002)

global WGPUBufferBindingType = @uint32
global WGPUBufferBindingType_Uniform <comptime> = (@WGPUBufferBindingType)(0x00000001)
global WGPUBufferBindingType_Storage <comptime> = (@WGPUBufferBindingType)(0x00000002)
global WGPUBufferBindingType_ReadOnlyStorage <comptime> = (@WGPUBufferBindingType)(0x00000004)

global WGPUPrimitiveTopology = @uint32
global WGPUPrimitiveTopology_TriangleList  <comptime> = (@WGPUPrimitiveTopology)(0x00000004)
global WGPUPrimitiveTopology_TriangleStrip <comptime> = (@WGPUPrimitiveTopology)(0x00000005)

global WGPUBlendOperation = @uint32
global WGPUBlendOperation_Add <comptime> = (@WGPUBlendOperation)(0x00000001)

global WGPUBlendFactor = @uint32
global WGPUBlendFactor_One              <comptime> = (@WGPUBlendFactor)(0x00000002)
global WGPUBlendFactor_Zero             <comptime> = (@WGPUBlendFactor)(0x00000001)
global WGPUBlendFactor_SrcAlpha         <comptime> = (@WGPUBlendFactor)(0x00000005)
global WGPUBlendFactor_OneMinusSrcAlpha <comptime> = (@WGPUBlendFactor)(0x00000006)

global WGPUColorWriteMask = @uint32
global WGPUColorWriteMask_All <comptime> = (@WGPUColorWriteMask)(0x0000000F)

global WGPUSType = @uint32
global WGPUSType_ShaderSourceWGSL        <comptime> = (@WGPUSType)(0x00000002)
global WGPUSType_SurfaceSourceMetalLayer           <comptime> = (@WGPUSType)(0x00000004)
global WGPUSType_SurfaceSourceWindowsHWND          <comptime> = (@WGPUSType)(0x00000005)
global WGPUSType_SurfaceSourceXlibWindow           <comptime> = (@WGPUSType)(0x00000006)
global WGPUSType_SurfaceSourceWaylandSurface       <comptime> = (@WGPUSType)(0x00000007)
global WGPUSType_SurfaceSourceCanvasHTMLSelector   <comptime> = (@WGPUSType)(0x0000000F)
## if NEBULA_TARGET ~= 'wasm' then
global WGPUSType_InstanceExtras                    <comptime> = (@WGPUSType)(0x00030006)

-- wgpu-native 扩展：后端选择枚举
-- 当前使用 WGPUInstanceBackend_All（Vulkan 优先），保留其余值供未来后端切换
global WGPUInstanceBackend = @uint32
global WGPUInstanceBackend_All    <comptime> = (@WGPUInstanceBackend)(0x00000000)
global WGPUInstanceBackend_Vulkan <comptime> = (@WGPUInstanceBackend)(0x00000001)
global WGPUInstanceBackend_GL     <comptime> = (@WGPUInstanceBackend)(0x00000002)
global WGPUInstanceBackend_Metal  <comptime> = (@WGPUInstanceBackend)(0x00000004)
global WGPUInstanceBackend_Dx12   <comptime> = (@WGPUInstanceBackend)(0x00000008)
## end

global WGPUSurfaceGetCurrentTextureStatus = @uint32
global WGPUSurfaceGetCurrentTextureStatus_Success           <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000000)
global WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal    <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000001)
global WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000002)
global WGPUSurfaceGetCurrentTextureStatus_Timeout           <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000003)
global WGPUSurfaceGetCurrentTextureStatus_Outdated          <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000004)
global WGPUSurfaceGetCurrentTextureStatus_Lost              <comptime> = (@WGPUSurfaceGetCurrentTextureStatus)(0x00000005)

global WGPURequestAdapterStatus = @uint32
global WGPURequestAdapterStatus_Success <comptime> = (@WGPURequestAdapterStatus)(0x00000001)

global WGPURequestDeviceStatus = @uint32
global WGPURequestDeviceStatus_Success <comptime> = (@WGPURequestDeviceStatus)(0x00000001)

global WGPUCallbackMode = @uint32
global WGPUCallbackMode_AllowSpontaneous <comptime> = (@WGPUCallbackMode)(0x00000003)

-- =============================================================================
-- 结构体类型（v29 API）
-- =============================================================================
global WGPUChainedStruct <cimport, nodecl> = @record{
  next:  pointer,
  sType: WGPUSType,
}

global WGPUColor <cimport, nodecl> = @record{
  r: float64,
  g: float64,
  b: float64,
  a: float64,
}

global WGPURenderPassColorAttachment <cimport, nodecl> = @record{
  nextInChain:   pointer,
  view:          WGPUTextureView,
  depthSlice:    uint32,
  resolveTarget: WGPUTextureView,
  loadOp:        WGPULoadOp,
  storeOp:       WGPUStoreOp,
  clearValue:    WGPUColor,
}

global WGPURenderPassDescriptor <cimport, nodecl> = @record{
  nextInChain:          pointer,
  label:                WGPUStringView,
  colorAttachmentCount: csize,
  colorAttachments:     *WGPURenderPassColorAttachment,
  depthStencilAttachment: pointer,
  occlusionQuerySet:    pointer,
  timestampWrites:      pointer,
}

global WGPUSurfaceTexture <cimport, nodecl> = @record{
  texture:    WGPUTexture,
  suboptimal: boolean,
  status:     WGPUSurfaceGetCurrentTextureStatus,
}

global WGPUSurfaceConfiguration <cimport, nodecl> = @record{
  nextInChain:     pointer,
  device:          WGPUDevice,
  format:          WGPUTextureFormat,
  usage:           uint64,
  width:           uint32,
  height:          uint32,
  viewFormatCount: csize,
  viewFormats:     pointer,
  alphaMode:       uint32,
  presentMode:     WGPUPresentMode,
}

global WGPUInstanceDescriptor <cimport, nodecl> = @record{
  nextInChain:          pointer,
  requiredFeatureCount: csize,
  requiredFeatures:     pointer,
  requiredLimits:       pointer,
}

-- wgpu-native v29 扩展：实例附加信息（仅 Native 端使用）
## if NEBULA_TARGET ~= 'wasm' then
global WGPUInstanceExtras <cimport, nodecl> = @record{
  chain:              WGPUChainedStruct,
  backends:           WGPUInstanceBackend,
  flags:              uint32,
  dx12ShaderCompiler: uint32,
  gles3MinorVersion:  uint32,
  glFenceBehaviour:   uint32,
  dxcPath:            WGPUStringView,
  dxcMaxShaderModel:  uint32,
  budgetForDeviceCreation: pointer,
  budgetForDeviceLoss:     pointer,
}
## end

global WGPURequestAdapterOptions <cimport, nodecl> = @record{
  nextInChain:          pointer,
  featureLevel:         uint32,
  powerPreference:      uint32,
  forceFallbackAdapter: uint32,
  backendType:          uint32,
  compatibleSurface:    WGPUSurface,
}

global WGPURequestAdapterCallbackInfo <cimport, nodecl> = @record{
  nextInChain: pointer,
  mode:        WGPUCallbackMode,
  callback:    pointer,
  userdata1:   pointer,
  userdata2:   pointer,
}

global WGPURequestDeviceCallbackInfo <cimport, nodecl> = @record{
  nextInChain: pointer,
  mode:        WGPUCallbackMode,
  callback:    pointer,
  userdata1:   pointer,
  userdata2:   pointer,
}

global WGPUDeviceDescriptor <cimport, nodecl> = @record{
  nextInChain:                  pointer,
  label:                        WGPUStringView,
  requiredFeatureCount:         csize,
  requiredFeatures:             pointer,
  requiredLimits:               pointer,
  defaultQueue:                 record{ nextInChain: pointer, label: WGPUStringView },
  deviceLostCallbackInfo:       record{ nextInChain: pointer, mode: WGPUCallbackMode, callback: pointer, userdata1: pointer, userdata2: pointer },
  uncapturedErrorCallbackInfo:  record{ nextInChain: pointer, callback: pointer, userdata1: pointer, userdata2: pointer },
}

global WGPUBufferDescriptor <cimport, nodecl> = @record{
  nextInChain:      pointer,
  label:            WGPUStringView,
  usage:            uint64,
  size:             uint64,
  mappedAtCreation: uint32,
}

global WGPUBindGroupLayoutEntry <cimport, nodecl> = @record{
  nextInChain:      pointer,
  binding:          uint32,
  _pad0:            uint32,    -- padding for 8-byte alignment of visibility
  visibility:       WGPUShaderStage,  -- WGPUFlags = uint64_t
  bindingArraySize: uint32,   -- wgpu-native v29: binding array size (0 = non-array)
  _pad1:            uint32,   -- padding for 8-byte alignment of buffer.nextInChain
  buffer:           record{
    nextInChain:      pointer,
    type:             uint32,
    hasDynamicOffset: uint32,  -- WGPUBool = uint32_t
    minBindingSize:   uint64,
  },
  sampler:          record{ nextInChain: pointer, type: uint32, _pad: uint32 },
  texture:          record{ nextInChain: pointer, sampleType: uint32, viewDimension: uint32, multisampled: uint32, _pad: uint32 },
  storageTexture:   record{ nextInChain: pointer, access: uint32, format: WGPUTextureFormat, viewDimension: uint32 },
}

global WGPUBindGroupLayoutDescriptor <cimport, nodecl> = @record{
  nextInChain: pointer,
  label:       WGPUStringView,
  entryCount:  csize,
  entries:     *WGPUBindGroupLayoutEntry,
}

global WGPUBindGroupEntry <cimport, nodecl> = @record{
  nextInChain: pointer,
  binding:     uint32,
  buffer:      WGPUBuffer,
  offset:      uint64,
  size:        uint64,
  sampler:     pointer,
  textureView: pointer,
}

global WGPUBindGroupDescriptor <cimport, nodecl> = @record{
  nextInChain: pointer,
  label:       WGPUStringView,
  layout:      WGPUBindGroupLayout,
  entryCount:  csize,
  entries:     *WGPUBindGroupEntry,
}

global WGPUPipelineLayoutDescriptor <cimport, nodecl> = @record{
  nextInChain:          pointer,
  label:                WGPUStringView,
  bindGroupLayoutCount: csize,
  bindGroupLayouts:     *WGPUBindGroupLayout,
  immediateSize:        uint32,
}

-- 着色器模块结构体
global WGPUShaderSourceWGSL <cimport, nodecl> = @record{
  chain: WGPUChainedStruct,
  code:  WGPUStringView,
}

global WGPUShaderModuleDescriptor <cimport, nodecl> = @record{
  nextInChain: *WGPUChainedStruct,
  label:       WGPUStringView,
}

global WGPUBlendComponent <cimport, nodecl> = @record{
  operation: WGPUBlendOperation,
  srcFactor: WGPUBlendFactor,
  dstFactor: WGPUBlendFactor,
}

global WGPUBlendState <cimport, nodecl> = @record{
  color: WGPUBlendComponent,
  alpha: WGPUBlendComponent,
}

global WGPUColorTargetState <cimport, nodecl> = @record{
  nextInChain: pointer,
  format:      WGPUTextureFormat,
  blend:       *WGPUBlendState,
  writeMask:   uint32,
}

global WGPUFragmentState <cimport, nodecl> = @record{
  nextInChain: pointer,
  module:      WGPUShaderModule,
  entryPoint:  WGPUStringView,
  constantCount: csize,
  constants:   pointer,
  targetCount: csize,
  targets:     *WGPUColorTargetState,
}

global WGPURenderPipelineDescriptor <cimport, nodecl> = @record{
  nextInChain: pointer,
  label:       WGPUStringView,
  layout:      WGPUPipelineLayout,
  vertex:      record{
    nextInChain:   pointer,
    module:        WGPUShaderModule,
    entryPoint:    WGPUStringView,
    constantCount: csize,
    constants:     pointer,
    bufferCount:   csize,
    buffers:       pointer,
  },
  primitive:   record{
    nextInChain:  pointer,
    topology:     WGPUPrimitiveTopology,
    stripIndexFormat: uint32,
    frontFace:    uint32,
    cullMode:     uint32,
    unclippedDepth: uint32,
  },
  depthStencil: pointer,
  multisample:  record{
    nextInChain:            pointer,
    count:                  uint32,
    mask:                   uint32,
    alphaToCoverageEnabled: uint32,
  },
  fragment:     *WGPUFragmentState,
}

-- =============================================================================
-- ★ Phase 4.2.1: Surface 来源结构体（五端）
--
-- 每个平台使用不同的 Surface 来源描述符。
-- 条件编译在 renderer.nelua 中根据 NEBULA_TARGET 选择对应的结构体。
-- SType 值均来自 webgpu-headers 官方规范：
--   https://webgpu-native.github.io/webgpu-headers/group__Enumerations.html
-- =============================================================================

-- Surface 来源（平台条件编译）
## if NEBULA_TARGET ~= 'wasm' then
-- Native 平台的 Surface 来源
global WGPUSurfaceSourceXlibWindow <cimport, nodecl> = @record{
  chain:   WGPUChainedStruct,
  display: pointer,
  window:  uint64,
}

global WGPUSurfaceSourceWaylandSurface <cimport, nodecl> = @record{
  chain:   WGPUChainedStruct,
  display: pointer,
  surface: pointer,
}

global WGPUSurfaceSourceWindowsHWND <cimport, nodecl> = @record{
  chain:     WGPUChainedStruct,
  hinstance: pointer,
  hwnd:      pointer,
}
## else
-- Web (WASM) 的 Surface 来源
global WGPUSurfaceSourceCanvasHTMLSelector <cimport, nodecl> = @record{
  chain:    WGPUChainedStruct,
  selector: cstring,
}
## end

global WGPUSurfaceDescriptor <cimport, nodecl> = @record{
  nextInChain: *WGPUChainedStruct,
  label:       WGPUStringView,
}

-- Surface 能力查询（v29 动态格式查询）
global WGPUSurfaceCapabilities <cimport, nodecl> = @record{
  nextInChain:      pointer,
  usages:           uint32,
  formatCount:      csize,
  formats:          *WGPUTextureFormat,
  presentModeCount: csize,
  presentModes:     *WGPUPresentMode,
  alphaModeCount:   csize,
  alphaModes:       pointer,
}

global WGPUTextureViewDescriptor <cimport, nodecl> = @record{
  nextInChain:     pointer,
  label:           WGPUStringView,
  format:          WGPUTextureFormat,
  dimension:       uint32,
  baseMipLevel:    uint32,
  mipLevelCount:   uint32,
  baseArrayLayer:  uint32,
  arrayLayerCount: uint32,
  aspect:          uint32,
  usage:           uint64,
}

-- =============================================================================
-- wgpu-native C 函数绑定
-- =============================================================================
global function wgpuCreateInstance(desc: *WGPUInstanceDescriptor): WGPUInstance <cimport, nodecl> end
global function wgpuInstanceCreateSurface(instance: WGPUInstance, desc: *WGPUSurfaceDescriptor): WGPUSurface <cimport, nodecl> end
global function wgpuInstanceRequestAdapter(instance: WGPUInstance, options: *WGPURequestAdapterOptions, callbackInfo: WGPURequestAdapterCallbackInfo): uint64 <cimport, nodecl> end
global function wgpuAdapterRequestDevice(adapter: WGPUAdapter, desc: *WGPUDeviceDescriptor, callbackInfo: WGPURequestDeviceCallbackInfo): uint64 <cimport, nodecl> end
global function wgpuDeviceGetQueue(device: WGPUDevice): WGPUQueue <cimport, nodecl> end
global function wgpuSurfaceConfigure(surface: WGPUSurface, config: *WGPUSurfaceConfiguration): void <cimport, nodecl> end
global function wgpuSurfaceGetCapabilities(surface: WGPUSurface, adapter: WGPUAdapter, caps: *WGPUSurfaceCapabilities): uint32 <cimport, nodecl> end
global function wgpuSurfaceCapabilitiesFreeMembers(caps: WGPUSurfaceCapabilities): void <cimport, nodecl> end
global function wgpuSurfaceGetCurrentTexture(surface: WGPUSurface, surfaceTexture: *WGPUSurfaceTexture): void <cimport, nodecl> end
global function wgpuSurfacePresent(surface: WGPUSurface): void <cimport, nodecl> end
global function wgpuTextureCreateView(texture: WGPUTexture, desc: *WGPUTextureViewDescriptor): WGPUTextureView <cimport, nodecl> end
global function wgpuTextureViewRelease(view: WGPUTextureView): void <cimport, nodecl> end
global function wgpuTextureRelease(texture: WGPUTexture): void <cimport, nodecl> end
global function wgpuDeviceCreateBuffer(device: WGPUDevice, desc: *WGPUBufferDescriptor): WGPUBuffer <cimport, nodecl> end
global function wgpuQueueWriteBuffer(queue: WGPUQueue, buffer: WGPUBuffer, offset: uint64, data: pointer, size: csize): void <cimport, nodecl> end
global function wgpuDeviceCreateBindGroupLayout(device: WGPUDevice, desc: *WGPUBindGroupLayoutDescriptor): WGPUBindGroupLayout <cimport, nodecl> end
global function wgpuDeviceCreateBindGroup(device: WGPUDevice, desc: *WGPUBindGroupDescriptor): WGPUBindGroup <cimport, nodecl> end
global function wgpuDeviceCreatePipelineLayout(device: WGPUDevice, desc: *WGPUPipelineLayoutDescriptor): WGPUPipelineLayout <cimport, nodecl> end
global function wgpuDeviceCreateShaderModule(device: WGPUDevice, desc: *WGPUShaderModuleDescriptor): WGPUShaderModule <cimport, nodecl> end
global function wgpuDeviceCreateRenderPipeline(device: WGPUDevice, desc: *WGPURenderPipelineDescriptor): WGPURenderPipeline <cimport, nodecl> end
global WGPUCommandEncoderDescriptor <cimport, nodecl> = @record{
  nextInChain: pointer,
  label:       WGPUStringView,
}
global function wgpuDeviceCreateCommandEncoder(device: WGPUDevice, desc: *WGPUCommandEncoderDescriptor): WGPUCommandEncoder <cimport, nodecl> end
global function wgpuCommandEncoderBeginRenderPass(encoder: WGPUCommandEncoder, desc: *WGPURenderPassDescriptor): WGPURenderPassEncoder <cimport, nodecl> end
global function wgpuRenderPassEncoderSetPipeline(pass: WGPURenderPassEncoder, pipeline: WGPURenderPipeline): void <cimport, nodecl> end
global function wgpuRenderPassEncoderSetBindGroup(pass: WGPURenderPassEncoder, groupIndex: uint32, group: WGPUBindGroup, dynamicOffsetCount: csize, dynamicOffsets: pointer): void <cimport, nodecl> end
global function wgpuRenderPassEncoderSetVertexBuffer(pass: WGPURenderPassEncoder, slot: uint32, buffer: WGPUBuffer, offset: uint64, size: uint64): void <cimport, nodecl> end
global function wgpuRenderPassEncoderDraw(pass: WGPURenderPassEncoder, vertexCount: uint32, instanceCount: uint32, firstVertex: uint32, firstInstance: uint32): void <cimport, nodecl> end
global function wgpuRenderPassEncoderSetScissorRect(pass: WGPURenderPassEncoder, x: uint32, y: uint32, width: uint32, height: uint32): void <cimport, nodecl> end
global function wgpuRenderPassEncoderEnd(pass: WGPURenderPassEncoder): void <cimport, nodecl> end
global function wgpuRenderPassEncoderRelease(pass: WGPURenderPassEncoder): void <cimport, nodecl> end
global WGPUCommandBufferDescriptor <cimport, nodecl> = @record{
  nextInChain: pointer,
  label:       WGPUStringView,
}
global function wgpuCommandEncoderFinish(encoder: WGPUCommandEncoder, desc: *WGPUCommandBufferDescriptor): WGPUCommandBuffer <cimport, nodecl> end
global function wgpuCommandEncoderRelease(encoder: WGPUCommandEncoder): void <cimport, nodecl> end
global function wgpuQueueSubmit(queue: WGPUQueue, commandCount: csize, commands: *WGPUCommandBuffer): void <cimport, nodecl> end
global function wgpuCommandBufferRelease(buf: WGPUCommandBuffer): void <cimport, nodecl> end
global function wgpuBindGroupRelease(bg: WGPUBindGroup): void <cimport, nodecl> end
global function wgpuBufferRelease(buffer: WGPUBuffer): void <cimport, nodecl> end
global function wgpuBufferGetSize(buffer: WGPUBuffer): uint64 <cimport, nodecl> end
global function wgpuInstanceRelease(instance: WGPUInstance): void <cimport, nodecl> end
global function wgpuAdapterRelease(adapter: WGPUAdapter): void <cimport, nodecl> end
global function wgpuDeviceRelease(device: WGPUDevice): void <cimport, nodecl> end
global function wgpuSurfaceRelease(surface: WGPUSurface): void <cimport, nodecl> end

-- =============================================================================
-- ★ Phase 2.5: 多 Pass 渲染所需的额外绑定
-- =============================================================================

-- ===== 额外的 Opaque Handle =====
global WGPUSampler <cimport, nodecl> = @pointer

-- ===== 纹理用途枚举（TextureUsage 位掩码） =====
global WGPUTextureUsage = @uint32
global WGPUTextureUsage_CopySrc          <comptime> = (@WGPUTextureUsage)(0x00000001)
global WGPUTextureUsage_CopyDst          <comptime> = (@WGPUTextureUsage)(0x00000002)
global WGPUTextureUsage_TextureBinding   <comptime> = (@WGPUTextureUsage)(0x00000004)
global WGPUTextureUsage_RenderAttachment <comptime> = (@WGPUTextureUsage)(0x00000010)

-- ===== 纹理维度 =====
global WGPUTextureDimension = @uint32
global WGPUTextureDimension_2D <comptime> = (@WGPUTextureDimension)(0x00000002)

-- ===== 纹理视图维度 =====
global WGPUTextureViewDimension = @uint32
global WGPUTextureViewDimension_2D <comptime> = (@WGPUTextureViewDimension)(0x00000002)

-- ===== 纹理 Aspect =====
global WGPUTextureAspect = @uint32
global WGPUTextureAspect_Undefined <comptime> = (@WGPUTextureAspect)(0x00000000)
global WGPUTextureAspect_All       <comptime> = (@WGPUTextureAspect)(0x00000001)

-- ===== 采样器绑定类型 =====
global WGPUSamplerBindingType = @uint32
global WGPUSamplerBindingType_Filtering <comptime> = (@WGPUSamplerBindingType)(0x00000002)

-- ===== 纹理采样类型 =====
global WGPUTextureSampleType = @uint32
global WGPUTextureSampleType_Float <comptime> = (@WGPUTextureSampleType)(0x00000002)

-- ===== 地址模式 =====
global WGPUAddressMode = @uint32
global WGPUAddressMode_ClampToEdge <comptime> = (@WGPUAddressMode)(0x00000002)

-- ===== 过滤模式 =====
global WGPUFilterMode = @uint32
global WGPUFilterMode_Nearest <comptime> = (@WGPUFilterMode)(0x00000001)
global WGPUFilterMode_Linear  <comptime> = (@WGPUFilterMode)(0x00000002)

-- ===== Mipmap 过滤模式 =====
global WGPUMipmapFilterMode = @uint32
global WGPUMipmapFilterMode_Nearest <comptime> = (@WGPUMipmapFilterMode)(0x00000001)

-- ===== 3D 尺寸 =====
global WGPUExtent3D <cimport, nodecl> = @record{
  width:              uint32,
  height:             uint32,
  depthOrArrayLayers: uint32,
}

global WGPUOrigin3D <cimport, nodecl> = @record{
  x: uint32,
  y: uint32,
  z: uint32,
}

global WGPUTexelCopyBufferLayout <cimport, nodecl> = @record{
  offset:       uint64,
  bytesPerRow:  uint32,
  rowsPerImage: uint32,
}

global WGPUVertexAttribute <cimport, nodecl> = @record{
  nextInChain:    pointer,
  format:         WGPUVertexFormat,
  offset:         uint64,
  shaderLocation: uint32,
}

global WGPUVertexBufferLayout <cimport, nodecl> = @record{
  nextInChain:    pointer,
  stepMode:       WGPUVertexStepMode,
  arrayStride:    uint64,
  attributeCount: csize,
  attributes:     *WGPUVertexAttribute,
}

-- ===== 纹理描述符 =====
global WGPUTextureDescriptor <cimport, nodecl> = @record{
  nextInChain:     pointer,
  label:           WGPUStringView,
  usage:           uint64,
  dimension:       WGPUTextureDimension,
  size:            WGPUExtent3D,
  format:          WGPUTextureFormat,
  mipLevelCount:   uint32,
  sampleCount:     uint32,
  viewFormatCount: csize,
  viewFormats:     pointer,
}

global WGPUTexelCopyTextureInfo <cimport, nodecl> = @record{
  texture:  WGPUTexture,
  mipLevel: uint32,
  origin:   WGPUOrigin3D,
  aspect:   WGPUTextureAspect,
}

-- ===== 采样器描述符 =====
global WGPUSamplerDescriptor <cimport, nodecl> = @record{
  nextInChain:   pointer,
  label:         WGPUStringView,
  addressModeU:  WGPUAddressMode,
  addressModeV:  WGPUAddressMode,
  addressModeW:  WGPUAddressMode,
  magFilter:     WGPUFilterMode,
  minFilter:     WGPUFilterMode,
  mipmapFilter:  WGPUMipmapFilterMode,
  lodMinClamp:   float32,
  lodMaxClamp:   float32,
  compare:       uint32,
  maxAnisotropy: uint16,
}

-- ===== Phase 2.5 / 3.2.2 额外函数绑定 =====
global function wgpuDeviceCreateTexture(device: WGPUDevice, desc: *WGPUTextureDescriptor): WGPUTexture <cimport, nodecl> end
global function wgpuDeviceCreateSampler(device: WGPUDevice, desc: *WGPUSamplerDescriptor): WGPUSampler <cimport, nodecl> end
global function wgpuQueueWriteTexture(queue: WGPUQueue, destination: *WGPUTexelCopyTextureInfo, data: pointer, dataSize: csize, dataLayout: *WGPUTexelCopyBufferLayout, writeSize: *WGPUExtent3D): void <cimport, nodecl> end

global function wgpuSamplerRelease(sampler: WGPUSampler): void <cimport, nodecl> end
global function wgpuShaderModuleRelease(shaderModule: WGPUShaderModule): void <cimport, nodecl> end
global function wgpuBindGroupLayoutRelease(bindGroupLayout: WGPUBindGroupLayout): void <cimport, nodecl> end
global function wgpuPipelineLayoutRelease(pipelineLayout: WGPUPipelineLayout): void <cimport, nodecl> end
global function wgpuRenderPipelineRelease(renderPipeline: WGPURenderPipeline): void <cimport, nodecl> end
global function wgpuQueueRelease(queue: WGPUQueue): void <cimport, nodecl> end
