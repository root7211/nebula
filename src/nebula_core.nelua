-- =============================================================================
-- nebula_core.nelua — 统一加载入口（Facade）
--
-- Phase 5.1 架构拆分：此文件从原 2277 行 God Module 重构为 Facade。
-- 职责：平台检测 + 按序加载子模块。
--
-- 任何 require "nebula_core" 的代码行为不变（向后兼容）。
--
-- 加载顺序（关键约束）：
--   1. nebula_types + nebula_constants（基础类型和常量）
--   2. nebula_derive_engine（编译期推导引擎，注入全局函数）
--   3. nebula_sugar（语法糖 API，依赖 derive engine 的全局函数）
-- =============================================================================

-- =============================================================================
-- ★ Phase 4.2.1: NEBULA_TARGET — 平台检测（S1 阶段编译期常量）
--
-- 在 S1 阶段确定目标平台，所有后续的条件编译（Surface 创建、主循环结构、
-- 链接选项）均依赖此全局常量。
--
-- 检测优先级：
--   1. 编译器命令行传入的 -D NEBULA_TARGET=xxx
--   2. 环境变量 NEBULA_TARGET
--   3. 自动检测（基于 Nelua 编译器的 ccinfo）
--
-- 合法值：
--   "linux"   — Linux (X11/Wayland)，默认
--   "windows" — Windows (Win32 HWND)
--   "wasm"    — Web (Emscripten + WebGPU)
--
-- 公理 A 合规性：平台检测是 S1 操作（输入在编译期已知），
-- 生成的代码中不存在任何运行时 if (platform == ...) 分支。
-- =============================================================================
##[[
  -- 第一优先级：编译器 -D 传入（已在全局表中）
  if not NEBULA_TARGET then
    -- 第二优先级：环境变量
    local env_target = os.getenv("NEBULA_TARGET")
    if env_target and env_target ~= "" then
      NEBULA_TARGET = env_target
    else
      -- 第三优先级：基于编译器信息自动检测
      -- ccinfo.is_emscripten 在 Nelua 使用 emcc 时为 true
      if ccinfo and ccinfo.is_emscripten then
        NEBULA_TARGET = "wasm"
      elseif ccinfo and ccinfo.is_windows then
        NEBULA_TARGET = "windows"
      else
        NEBULA_TARGET = "linux"
      end
    end
  end

  -- 验证合法性
  local valid_targets = { linux = true, windows = true, wasm = true }
  assert(valid_targets[NEBULA_TARGET],
    "[nebula] NEBULA_TARGET must be 'linux', 'windows', or 'wasm', got: '" .. tostring(NEBULA_TARGET) .. "'")

  -- 导出为编译期可查询的全局常量
  -- 后续代码可通过 ## if NEBULA_TARGET == 'xxx' then ... end 进行条件编译
  print("[nebula] S1: NEBULA_TARGET = " .. NEBULA_TARGET)

  -- ★ Phase 4.2.1: NEBULA_LINUX_DISPLAY — Linux 显示协议子变量
  --
  -- 仅在 NEBULA_TARGET == 'linux' 时有意义。
  -- 公理 A 合规：X11/Wayland 选择在 S1 阶段消解，不引入运行时分支。
  --
  -- 检测优先级：
  --   1. 编译器 -D NEBULA_LINUX_DISPLAY=xxx
  --   2. 环境变量 NEBULA_LINUX_DISPLAY
  --   3. 默认値 "x11"
  --
  -- 合法値：
  --   "x11"     — Linux X11（默认）
  --   "wayland" — Linux Wayland
  if NEBULA_TARGET == "linux" then
    if not NEBULA_LINUX_DISPLAY then
      local env_display = os.getenv("NEBULA_LINUX_DISPLAY")
      if env_display and env_display ~= "" then
        NEBULA_LINUX_DISPLAY = env_display
      else
        NEBULA_LINUX_DISPLAY = "x11"
      end
    end
    local valid_displays = { x11 = true, wayland = true }
    assert(valid_displays[NEBULA_LINUX_DISPLAY],
      "[nebula] NEBULA_LINUX_DISPLAY must be 'x11' or 'wayland', got: '" .. tostring(NEBULA_LINUX_DISPLAY) .. "'")
    print("[nebula] S1: NEBULA_LINUX_DISPLAY = " .. NEBULA_LINUX_DISPLAY)
  end
]]

-- ★ P1-1 refactor: 类型定义已提取到 nebula_types.nelua
-- 包含 Vec2, Vec4, Color, NebulaKey, NebulaInputState, HoverableState, ClickableState
-- 以及数学工具函数 lerp_f32, lerp_color, lerp_vec2, ease_out, ease_in
require "nebula_types"

-- ★ P2-8: 集中化运行时常量（队列尺寸、行高、字符码位、缓冲区、GPU 枚举等）
require "nebula_constants"

-- ★ Phase 5.1 架构拆分：编译期推导引擎（必须先于 sugar 加载）
-- sugar 依赖 derive engine 注入的全局函数（nebula_annotate, nebula_derive,
-- NEBULA_PRIMITIVES, nebula_app_begin/end 等）
require "nebula_derive_engine"

-- ★ Phase 5.1 架构拆分：语法糖 API + Builtin 注册表
require "nebula_sugar"
