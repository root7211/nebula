-- =============================================================================
-- nebula_types.nelua — Nebula Core Type System & Math Utilities
--
-- ★ P1-1 refactor: 从 nebula_core.nelua 提取的运行时类型和数学函数。
-- 零编译期依赖，所有 Nebula 模块的基础类型层。
--
-- 包含：
--   · 语义类型：Vec2, Vec4, Color
--   · 键盘枚举：NebulaKey
--   · 输入状态：NebulaInputState
--   · 交互原语状态：HoverableState, ClickableState
--   · 数学工具：lerp_f32, lerp_color, lerp_vec2, ease_out, ease_in
-- =============================================================================

-- -----------------------------------------------------------------------------
-- 语义类型系统（Semantic Type System）
-- -----------------------------------------------------------------------------
global Vec2  = @record{ x: float32, y: float32 }
global Vec4  = @record{ x: float32, y: float32, z: float32, w: float32 }
global Color = @record{ r: float32, g: float32, b: float32, a: float32 }

-- =============================================================================
-- 键盘控制键枚举（用于 input.key_pressed 字段）
-- =============================================================================
global NebulaKey = @enum(uint8){
  None      = 0,
  Backspace = 1,
  Delete    = 2,
  Enter     = 3,
  Tab       = 4,
  Escape    = 5,
  Left      = 6,
  Right     = 7,
  Home      = 8,
  End       = 9,
  -- ★ Phase 3.6.3: Shift 组合键变体（选区扩展）
  ShiftLeft  = 10,
  ShiftRight = 11,
  ShiftHome  = 12,
  ShiftEnd   = 13,
  -- ★ Phase 4.4 S3: Up/Down arrow keys (multiline editing)
  Up         = 14,
  Down       = 15,
  ShiftUp    = 16,
  ShiftDown  = 17,
  -- ★ Phase 4.X: 剪贴板操作键（Ctrl+C / Ctrl+V / Ctrl+X / Ctrl+A）
  Copy       = 18,
  Paste      = 19,
  Cut        = 20,
  SelectAll  = 21,
  -- ★ Phase 4.7-S5: Undo/Redo 操作键（Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z）
  Undo       = 22,
  Redo       = 23,
  -- ★ Phase 4.7-S7: 文件操作键（Ctrl+S）
  Save       = 24,
  -- ★ Phase 4.8-S5: 自动缩进（Shift+Tab 反缩进）
  ShiftTab   = 25,
  -- ★ Phase 4.8-S2: 搜索与替换
  Find       = 26,   -- Ctrl+F
  Replace    = 27,   -- Ctrl+H
  FindNext   = 28,   -- Enter（搜索栏激活时） / F3
}

-- =============================================================================
-- 统一输入状态（Unified Input State）
-- =============================================================================
global NebulaInputState = @record{
  -- 鼠标状态
  mouse_x:            float32,
  mouse_y:            float32,
  mouse_left_down:    boolean,
  mouse_left_pressed: boolean,
  mouse_left_released:boolean,
  focused_id:         uint32,
  -- 键盘事件
  char_input:         [64]uint32,
  char_count:         uint8,
  key_pressed:        NebulaKey,   -- 首个控制键（向后兼容，等价于 key_input[0]）
  key_input:          [16]NebulaKey, -- ★ P1-7: 本帧全部控制键（全量消费）
  key_count:          uint8,       -- key_input 中有效键数量
  scroll_dy:          float32,
  -- 修饰键实时状态
  mod_shift:          boolean,
  mod_ctrl:           boolean,
  mod_alt:            boolean,
  -- 视口尺寸状态
  viewport_w:         float32,
  viewport_h:         float32,
  viewport_resized:   boolean,
}

-- =============================================================================
-- 交互原语结构体
-- =============================================================================
global HoverableState = @record{
  is_hovered:   boolean,
  just_entered: boolean,
  just_left:    boolean,
}

global ClickableState = @record{
  is_pressed:   boolean,
  just_clicked: boolean,
}

-- =============================================================================
-- 数学工具函数（运行时，完全内联）
-- =============================================================================
global function lerp_f32(a: float32, b: float32, t: float32): float32
  return a + (b - a) * t
end

global function lerp_color(a: Color, b: Color, t: float32): Color
  return Color{
    r = lerp_f32(a.r, b.r, t),
    g = lerp_f32(a.g, b.g, t),
    b = lerp_f32(a.b, b.b, t),
    a = lerp_f32(a.a, b.a, t),
  }
end

global function lerp_vec2(a: Vec2, b: Vec2, t: float32): Vec2
  return Vec2{
    x = lerp_f32(a.x, b.x, t),
    y = lerp_f32(a.y, b.y, t),
  }
end

global function ease_out(t: float32): float32
  if t <= 0.0 then return 0.0 end
  if t >= 1.0 then return 1.0 end
  return 1.0 - (1.0 - t) * (1.0 - t)
end

global function ease_in(t: float32): float32
  if t <= 0.0 then return 0.0 end
  if t >= 1.0 then return 1.0 end
  return t * t
end
