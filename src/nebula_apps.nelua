-- =============================================================================
-- nebula_apps.nelua -- Application Template Library
--
-- Complete application main() function generators (text editor, terminal, etc.)
-- These are application scaffolding, not framework derivation rules.
--
-- Compile-time only, zero runtime overhead.
-- =============================================================================

require "nebula_core"
require "nebula_builtins"

