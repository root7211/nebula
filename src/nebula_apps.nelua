-- =============================================================================
-- nebula_apps.nelua -- Application Template Library
--
-- Complete application main() function generators (text editor, terminal, etc.)
-- These are application scaffolding, not framework derivation rules.
--
-- Compile-time only, zero runtime overhead.
-- =============================================================================

require "nebula_core"
require "nebula_builtins"

-- =============================================================================
-- ★ Phase 4.6-S1: nebula_main(app_type, opts)
--
-- 泛用 main 函数生成器。吸收标准样板代码（init/frame_begin/render/shutdown），
-- 用户只需提供 on_init 和 on_frame 编译期回调。
--
-- Usage:
--   ## nebula_main("ButtonApp", {
--     title = "Button V2 Demo",
--     width = 800, height = 600,
--     on_init = function(app)
--       -- app.btn:init_themed(...) 等初始化
--     end,
--     on_frame = function(app)
--       -- 每帧业务逻辑
--     end,
--     bg_r = 0.04, bg_g = 0.04, bg_b = 0.06,  -- 可选，默认深灰
--   })
--
-- =============================================================================
