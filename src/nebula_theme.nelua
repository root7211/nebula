-- =============================================================================
-- nebula_theme.nelua
-- Nebula GUI Compiler — Phase 4.5 Sugar Optimization
--
-- 内置暗色主题颜色包（One Dark 风格），消除 demo 间的颜色函数重复。
--
-- Usage:
--   require "nebula_theme"
--   local fg = nebula_theme_fg_normal()      -- 前景文字色
--   local bg = nebula_theme_bg_normal()      -- 编辑区背景
--   local bg = nebula_theme_bg_linenum()     -- 行号栏背景
-- =============================================================================

require "text_runtime"  -- nebula_pack_rgba8

-- =============================================================================
-- 编辑器核心颜色（与 One Dark 对齐）
-- =============================================================================

-- 前景 / 背景
global function nebula_theme_fg_normal(): uint32
  return nebula_pack_rgba8(210, 210, 220, 255)
end

global function nebula_theme_bg_normal(): uint32
  return nebula_pack_rgba8(22, 22, 30, 255)
end

-- 行号栏
global function nebula_theme_bg_linenum(): uint32
  return nebula_pack_rgba8(28, 28, 38, 255)
end

global function nebula_theme_fg_linenum(): uint32
  return nebula_pack_rgba8(90, 90, 110, 255)
end

global function nebula_theme_fg_separator(): uint32
  return nebula_pack_rgba8(50, 50, 70, 255)
end

-- 选区背景（VSCode 风格蓝色）
global function nebula_theme_bg_selected(): uint32
  return nebula_pack_rgba8(38, 79, 120, 255)
end

-- 光标行 / 光标
global function nebula_theme_bg_cursor_line(): uint32
  return nebula_pack_rgba8(35, 35, 50, 255)
end

global function nebula_theme_bg_cursor(): uint32
  return nebula_pack_rgba8(200, 200, 230, 255)
end

global function nebula_theme_fg_cursor(): uint32
  return nebula_pack_rgba8(22, 22, 30, 255)
end

-- =============================================================================
-- 编辑器 Visual 默认配色（用于 EditorBgVisual init）
-- =============================================================================
global function nebula_theme_editor_colors(): (Color, Color, float32, Color, Color, float32, Color, Color, float32)
  return
    Color{ r=0.08, g=0.08, b=0.12, a=1.0 },  -- default_bg
    Color{ r=0.15, g=0.15, b=0.25, a=1.0 },  -- default_border
    0.0,                                        -- default_border_width
    Color{ r=0.08, g=0.08, b=0.12, a=1.0 },  -- hovered_bg
    Color{ r=0.20, g=0.30, b=0.60, a=1.0 },  -- hovered_border
    1.0,                                        -- hovered_border_width
    Color{ r=0.10, g=0.10, b=0.16, a=1.0 },  -- pressed_bg
    Color{ r=0.30, g=0.50, b=0.90, a=1.0 },  -- pressed_border
    1.0                                         -- pressed_border_width
end
