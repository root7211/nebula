##   if not spec.layout then
##     spec.layout = { direction = "column", width = _cfg.DEFAULT_WIN_WIDTH, height = _cfg.DEFAULT_WIN_HEIGHT }
##   end
##   -- 设置根布局
##   nebula_app_set_root_layout(app_name, spec.layout)
##   -- 开始 App 注册
##   nebula_app_begin(app_name, { arena_size = spec.arena_size })
