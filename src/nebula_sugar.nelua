## -- ★ Phase 4.5 S1: nebula_component(type_name, spec)
## --
## -- 语法糖：合并 nebula_annotate + nebula_derive 为单次调用。
## -- 同时支持从 primitives 自动推导 states（如果 spec.states 未显式指定）。
## --
## -- 使用前（旧 API，12+ 行）：
## --   global ButtonVisual = @record{ ... }
## --   ##[[ nebula_annotate("ButtonVisual", {
## --     states     = {"default", "hovered", "pressed"},
## --     primitives = {"hoverable", "clickable"},
## --     transitions = {...},
## --   }) ]]
## --   ## nebula_derive("ButtonVisual")
## --
## -- 使用后（新 API，1 行）：
## --   global ButtonVisual = @record{ ... }
## --   ## nebula_component("ButtonVisual", {
## --     primitives = {"hoverable", "clickable"},
## --   })
## --
## -- spec 字段与 nebula_annotate 完全兼容。额外行为：
## --   · states 缺省时，从 primitives 的 state_transitions 自动推导
## --   · transitions 缺省时，自动生成（基于已推导的 states）
## function nebula_component(type_name, spec)
##   spec = spec or {}
##   -- 自动推导 states（如果用户未显式指定）
##   if not spec.states and spec.primitives and #spec.primitives > 0 then
##     spec.states = nebula_auto_states(spec.primitives)
##     print(("[sugar] %s: auto-derived states = {%s}"):format(
##       type_name, table.concat(spec.states, ", ")))
##   end
##   -- 自动生成 transitions（如果用户未显式指定）
##   if not spec.transitions and spec.states and #spec.states > 1 then
##     local transitions = {}
##     for i = 2, #spec.states do
##       local st = spec.states[i]
##       -- 生成 default <-> state 的双向转换
##       table.insert(transitions, {
##         from = "default", to = st,
##         on = st .. "_enter",
##       })
##       table.insert(transitions, {
##         from = st, to = "default",
##         on = st .. "_leave",
##       })
##     end
##     spec.transitions = transitions
##   end
##   nebula_annotate(type_name, spec)
##   nebula_derive(type_name)
## end
