##             auto_editor_name = c.name
##             break
##           end
##         end
##       end
##     end
##     if auto_editor_name then break end
##   end
##   -- ★ Phase 4.9.1: layout 字段提升 + children/row 简写
##   -- 在组件注册前，将顶层 layout 字段归入 c.layout，并展开 children/row 语法糖
##   for _, c in ipairs(spec.components or {}) do
##     -- children 简写: { "line_nums", "edit_area" } → container = { {ref="line_nums"}, {ref="edit_area"} }
