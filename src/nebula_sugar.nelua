##   _nebula_last_app_spec = spec
##   _nebula_last_app_name = app_name
##   -- ★ Phase 4.9.1: app 级 cell 默认值
##   local app_cell_w = (spec.cell and spec.cell.w) or _cfg.DEFAULT_CELL_W
##   local app_cell_h = (spec.cell and spec.cell.h) or _cfg.DEFAULT_CELL_H
