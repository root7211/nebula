-- =============================================================================
-- ★ Builtin Registry (Producer Factory Functions)
--
-- nebula_app's `builtin` field dispatches through this registry.
-- Pre-built producers in nebula_builtins.nelua register here.
-- Users can also register custom builtins via:
--   ## nebula_register_builtin("my_widget", function(name, opts) ... end)
-- =============================================================================
## _nebula_builtins = _nebula_builtins or {}
##
## -- ★ Phase 4.5 S2: nebula_app(app_name, spec)
## --
## -- 语法糖：合并 nebula_app_begin + 注册 + 布局 + nebula_app_end + nebula_derive_app。
## --
## -- 使用前（旧 API，10+ 行）：
## --   ##[[ nebula_app_set_root_layout("ButtonApp", {direction="column", width=800, height=600})
## --     nebula_app_begin("ButtonApp")
## --       nebula_app_register_component("btn", "ButtonVisual")
## --     nebula_app_end()
## --   ]]
## --   ## nebula_derive_app("ButtonApp")
## --
## -- 使用后（新 API，1 行）：
## --   ## nebula_app("ButtonApp", {
## --     layout = {direction="column", width=800, height=600},
## --     components = {
## --       {name="btn", type="ButtonVisual"},
## --     },
## --   })
## --
## -- ★ Phase 4.5 S2 新增：混合管线自动编排
## --   components 数组中的条目会根据 Visual 的 text_mode 自动路由到对应注册函数：
## --     · text_mode == "dense" → nebula_app_register_dense_text（需提供 producer）
## --     · 其他 → nebula_app_register_component
## --   消除了 dense_texts 分离声明的需要。dense_texts 仍可用于向后兼容。
## --
## -- spec 字段：
## --   layout      : table?   — 根布局约束（传给 nebula_app_set_root_layout）
## --   arena_size  : number?  — FrameArena 字节数
## --   components  : table[]? — 组件 [{name, type, component_id?, layout?, producer?, max_chars?, cell_w?, cell_h?}]
## --                            ★ S2: 如果 Visual 的 text_mode=="dense"，自动路由到 DenseText 注册
## --   slots       : table[]? — 动态插槽 [{name, type, max_instances?, producer?}]
## --   texts       : table[]? — 文本组件 [{name, type, bound_to?, placeholder?, mask_password?, mode?, updater?}]
## --   dense_texts : table[]? — DenseText [{name, type, max_chars?, cell_w?, cell_h?, producer?, layout?}]（向后兼容）
## --   shadows     : table[]? — 阴影组件 [{name, type, blur_radius?}]
