##   spec = spec or {}
##   local max_text_len = spec.max_text_len or 256
##   local max_lines    = spec.max_lines    or 32
##   local component_id = spec.component_id or 1
##
##   -- 推导 buffer 类型名
##   local mb_type = ("NebulaMultiBuf%d_%d"):format(max_text_len, max_lines)
##   local gb_type = ("NebulaBuf%d"):format(max_text_len)
##
##   -- 生成 record 定义
##   local record_src = ([[
## global %s = @record{
##   pos:    Vec2,
##   size:   Vec2,
##   radius: float32,
##   default_bg_color:     Color,
##   default_border_color: Color,
##   default_border_width: float32,
##   hovered_bg_color:     Color,
##   hovered_border_color: Color,
##   hovered_border_width: float32,
##   pressed_bg_color:     Color,
##   pressed_border_color: Color,
##   pressed_border_width: float32,
##   pixel_height:  float32,
##   text_origin_x: float32,
##   content_height: float32,
##   multi_buf: %s,
##   gap_buf:   %s,
## }
## ]]):format(type_name, mb_type, gb_type)
##
##   local ast = aster.parse(record_src, "<nebula_editor_visual:" .. type_name .. ">")
##   for _, stat in ipairs(ast) do
##     inject_statement(stat)
##   end
##
##   -- 调用 nebula_component
##   nebula_component(type_name, {
##     primitives   = {"multiline_editable"},
##     max_text_len = max_text_len,
##     max_lines    = max_lines,
##     component_id = component_id,
##   })
##
##   print(("[sugar] nebula_editor_visual: %s (%s + %s, id=%d)"):format(
##     type_name, mb_type, gb_type, component_id))
## end
