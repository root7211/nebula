## -- Usage:
## --   ## nebula_editor_visual("EditorVisual", {
## --     max_text_len = 256, max_lines = 256,
## --     component_id = 1,
## --   })
## --
## -- 生成等价于:
## --   global EditorVisual = @record{ pos, size, radius, 9 color fields, 3 layout fields, multi_buf, gap_buf }
## --   ## nebula_component("EditorVisual", { primitives={"multiline_editable"}, ... })
## --
