-- =============================================================================
-- renderer.nelua
-- Nebula GUI Compiler — WebGPU 渲染层
--
-- ★ Phase 4.2.1: 跨平台 Surface 创建与 Instance 初始化
-- ★ Phase 4.X:   DenseCharInstance / DenseTextUniforms record 定义
--   通过 NEBULA_TARGET + NEBULA_LINUX_DISPLAY 条件编译，在 S1 阶段消解平台分支：
--   - Linux (X11):     XlibWindow Surface + wgpu-native InstanceExtras
--   - Linux (Wayland): WaylandSurface + wgpu-native InstanceExtras
--   - Windows:         HWND Surface + Win32 GetModuleHandleA + wgpu-native InstanceExtras
--   - Web (Wasm):      Canvas HTML Selector + 标准 WebGPU API
--
-- Phase 2.3.1: 抽取公共 API `nebula_pipeline_base_init`
--   封装 WGPU 管线、BindGroupLayout、Uniform Buffer 的创建逻辑。
--
-- Phase 2.3.3: 移除硬编码的 NebulaRectUniforms / RECT_SHADER_WGSL /
--   NebulaRectPipeline，彻底实现“形即渲染”架构。
-- =============================================================================

require "nebula_core"
require "wgpu_bindings"
require "glfw_bindings"

## cinclude "<stdio.h>"
## cinclude "<string.h>"
## cinclude "<stdlib.h>"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function memcpy(dst: pointer, src: pointer, n: csize): pointer <cimport, nodecl> end

-- =============================================================================
-- NebulaRenderer：WebGPU 设备与 Surface 的生命周期管理
-- =============================================================================
global NebulaRenderer = @record{
  instance: WGPUInstance,
  adapter:  WGPUAdapter,
  device:   WGPUDevice,
  queue:    WGPUQueue,
  surface:  WGPUSurface,
  width:    uint32,
  height:   uint32,
  format:   WGPUTextureFormat,
}

-- 回调函数：Adapter 请求完成
local adapter_result: WGPUAdapter = nilptr
## if NEBULA_TARGET ~= 'wasm' then
-- Native (v29): callback(status, adapter, message, userdata1, userdata2)
local function on_adapter(status: uint32, adapter: WGPUAdapter, msg: WGPUStringView, ud1: pointer, ud2: pointer): void
  if status == 1 then -- WGPURequestAdapterStatus_Success
    adapter_result = adapter
  else
    printf("wgpu: adapter request failed\n")
  end
end
## else
-- WASM (Emscripten): callback(status, adapter, message, userdata)
local function on_adapter(status: uint32, adapter: WGPUAdapter, msg: cstring, ud: pointer): void
  if status == 0 then -- WGPURequestAdapterStatus_Success (Emscripten: 0 = success)
    adapter_result = adapter
  else
    printf("wgpu: adapter request failed (status=%u)\n", status)
  end
end
## end

-- 回调函数：Device 请求完成
local device_result: WGPUDevice = nilptr
## if NEBULA_TARGET ~= 'wasm' then
-- Native (v29): callback(status, device, message, userdata1, userdata2)
local function on_device(status: uint32, device: WGPUDevice, msg: WGPUStringView, ud1: pointer, ud2: pointer): void
  if status == 1 then -- WGPURequestDeviceStatus_Success
    device_result = device
  else
    printf("wgpu: device request failed\n")
  end
end
## else
-- WASM (Emscripten): callback(status, device, message, userdata)
local function on_device(status: uint32, device: WGPUDevice, msg: cstring, ud: pointer): void
  if status == 0 then -- WGPURequestDeviceStatus_Success (Emscripten: 0 = success)
    device_result = device
  else
    printf("wgpu: device request failed (status=%u)\n", status)
  end
end
## end

function NebulaRenderer:init(window: GLFWwindow, w: uint32, h: uint32): boolean
  -- ★ MEM-1 fix: 防止重复初始化导致 GPU 资源泄漏
  if self.device ~= nilptr then
    printf("wgpu: warning — NebulaRenderer:init() called on already-initialized renderer, aborting to prevent GPU leak\n")
    return false
  end

  self.width  = w
  self.height = h

  -- 1. 创建 Instance（★ Phase 4.2.1: 条件链接 wgpu-native 扩展）
  --    Native 端使用 WGPUInstanceExtras 选择后端；Web 端直接使用标准 WebGPU C API。
  ## if NEBULA_TARGET ~= 'wasm' then
  -- Native (Linux/Windows): 使用 wgpu-native 扩展，Vulkan/Dx12 优先
  local inst_extras = WGPUInstanceExtras{
    chain    = WGPUChainedStruct{ next = nilptr, sType = WGPUSType_InstanceExtras },
    backends = WGPUInstanceBackend_All,
    flags    = 0,
    dx12ShaderCompiler = 0,
    gles3MinorVersion  = 0,
    glFenceBehaviour   = 0,
    dxcPath   = wgpu_str_null(),
    dxcMaxShaderModel  = 0,
    budgetForDeviceCreation = nilptr,
    budgetForDeviceLoss     = nilptr,
  }
  local inst_desc = WGPUInstanceDescriptor{
    nextInChain = (@pointer)(&inst_extras)
  }
  self.instance = wgpuCreateInstance(&inst_desc)
  if self.instance == nilptr then
    printf("wgpu: failed to create instance\n")
    return false
  end

  -- 2. 创建 Surface
  ## if NEBULA_LINUX_DISPLAY ~= 'wayland' then
  -- Linux (X11) 路径
  local xlib_src = WGPUSurfaceSourceXlibWindow{
    chain   = WGPUChainedStruct{
      next  = nilptr,
      sType = WGPUSType_SurfaceSourceXlibWindow,
    },
    display = glfwGetX11Display(),
    window  = glfwGetX11Window(window),
  }
  local surf_desc = WGPUSurfaceDescriptor{
    nextInChain = (@*WGPUChainedStruct)(&xlib_src),
    label       = wgpu_str_null(),
  }
  ## elseif NEBULA_LINUX_DISPLAY == 'wayland' then
  -- Linux (Wayland) 路径
  local wl_src = WGPUSurfaceSourceWaylandSurface{
    chain   = WGPUChainedStruct{
      next  = nilptr,
      sType = WGPUSType_SurfaceSourceWaylandSurface,
    },
    display = glfwGetWaylandDisplay(),
    surface = glfwGetWaylandWindow(window),
  }
  local surf_desc = WGPUSurfaceDescriptor{
    nextInChain = (@*WGPUChainedStruct)(&wl_src),
    label       = wgpu_str_null(),
  }
  ## end
  ## if NEBULA_TARGET == 'windows' then
  -- Windows (HWND) 路径
  local hwnd_src = WGPUSurfaceSourceWindowsHWND{
    chain = WGPUChainedStruct{
      next  = nilptr,
      sType = WGPUSType_SurfaceSourceWindowsHWND,
    },
    hinstance = GetModuleHandleA(nilptr),
    hwnd      = glfwGetWin32Window(window),
  }
  local surf_desc = WGPUSurfaceDescriptor{
    nextInChain = (@*WGPUChainedStruct)(&hwnd_src),
    label       = wgpu_str_null(),
  }
  ## end
  self.surface = wgpuInstanceCreateSurface(self.instance, &surf_desc)
  if self.surface == nilptr then
    printf("wgpu: failed to create surface\n")
    return false
  end

  -- 3. 请求 Adapter
  local adapter_opts = WGPURequestAdapterOptions{
    nextInChain          = nilptr,
    featureLevel         = 0,
    powerPreference      = 0,
    forceFallbackAdapter = 0,
    backendType          = 0,
    compatibleSurface    = self.surface,
  }
  local adapter_cb = WGPURequestAdapterCallbackInfo{
    nextInChain = nilptr,
    mode        = WGPUCallbackMode_AllowSpontaneous,
    callback    = (@pointer)(&on_adapter),
    userdata1   = nilptr,
    userdata2   = nilptr,
  }
  adapter_result = nilptr
  wgpuInstanceRequestAdapter(self.instance, &adapter_opts, adapter_cb)
  self.adapter = adapter_result
  if self.adapter == nilptr then
    printf("wgpu: no adapter\n")
    return false
  end

  -- 4. 请求 Device
  local dev_desc = WGPUDeviceDescriptor{
    nextInChain          = nilptr,
    label                = wgpu_str("nebula-device"),
    requiredFeatureCount = 0,
    requiredFeatures     = nilptr,
    requiredLimits       = nilptr,
    defaultQueue         = {nextInChain = nilptr, label = wgpu_str_null()},
    deviceLostCallbackInfo = {
      nextInChain = nilptr,
      mode        = WGPUCallbackMode_AllowSpontaneous,
      callback    = nilptr,
      userdata1   = nilptr,
      userdata2   = nilptr,
    },
    uncapturedErrorCallbackInfo = {
      nextInChain = nilptr,
      callback    = nilptr,
      userdata1   = nilptr,
      userdata2   = nilptr,
    },
  }
  local device_cb = WGPURequestDeviceCallbackInfo{
    nextInChain = nilptr,
    mode        = WGPUCallbackMode_AllowSpontaneous,
    callback    = (@pointer)(&on_device),
    userdata1   = nilptr,
    userdata2   = nilptr,
  }
  device_result = nilptr
  wgpuAdapterRequestDevice(self.adapter, &dev_desc, device_cb)
  self.device = device_result
  if self.device == nilptr then
    printf("wgpu: no device\n")
    return false
  end

  self.queue = wgpuDeviceGetQueue(self.device)

  -- 5. 查询 Surface 支持的格式
  --    wgpu-native v29 要求通过 wgpuSurfaceGetCapabilities 查询，不可硬编码
  local caps: WGPUSurfaceCapabilities = {}
  local caps_status = wgpuSurfaceGetCapabilities(self.surface, self.adapter, &caps)
  if caps_status ~= 1 or caps.formatCount == 0 then
    printf("wgpu: failed to get surface capabilities\n")
    return false
  end

  -- 选择非 sRGB 格式（sRGB 格式会对线性输出做自动 gamma 编码，导致颜色变暗）
  -- 优先级：BGRA8Unorm(27) > RGBA8Unorm(22) > 第一个可用格式
  local fmt_ptr = (@*[0]WGPUTextureFormat)(caps.formats)
  self.format = fmt_ptr[0]
  local found_preferred = false

  local i: uint32 = 0
  while i < caps.formatCount do
    if fmt_ptr[i] == WGPUTextureFormat_BGRA8Unorm then
      self.format = WGPUTextureFormat_BGRA8Unorm
      found_preferred = true
      break
    end
    i = i + 1
  end

  if not found_preferred then
    i = 0
    while i < caps.formatCount do
      if fmt_ptr[i] == WGPUTextureFormat_RGBA8Unorm then
        self.format = WGPUTextureFormat_RGBA8Unorm
        found_preferred = true
        break
      end
      i = i + 1
    end
  end

  if not found_preferred then
    self.format = WGPUTextureFormat_BGRA8Unorm  -- 回退
  end

  printf("wgpu: surface format = %u (non-sRGB)\n", self.format)
  wgpuSurfaceCapabilitiesFreeMembers(caps)

  ## elseif NEBULA_TARGET == 'wasm' then
  -- =========================================================================
  -- WASM 路径：使用 emscripten_webgpu_get_device() 获取 JS 预初始化的 Device
  --
  -- Emscripten 4.0.6 的 wgpuInstanceRequestAdapter 是异步的（Promise-based），
  -- C 端无法同步等待。正确做法是在 JS 层 (shell.html) 通过
  -- Module.preinitializedWebGPUDevice 预先创建好 device，然后在 C 端直接获取。
  -- =========================================================================
  self.device = emscripten_webgpu_get_device()
  if self.device == nilptr then
    printf("wgpu: emscripten_webgpu_get_device() returned null\n")
    return false
  end
  printf("wgpu: got pre-initialized device from JS\n")

  self.queue = wgpuDeviceGetQueue(self.device)

  -- 在 WASM 端，创建 instance 和 surface 仍然需要（用于 surface configure）
  self.instance = wgpuCreateInstance(nilptr)
  if self.instance == nilptr then
    printf("wgpu: failed to create instance\n")
    return false
  end

  -- Canvas surface
  local canvas_src = WGPUSurfaceSourceCanvasHTMLSelector{
    chain = WGPUChainedStruct{
      next  = nilptr,
      sType = WGPUSType_SurfaceSourceCanvasHTMLSelector,
    },
    selector = "#nebula-canvas",
  }
  local surf_desc = WGPUSurfaceDescriptor{
    nextInChain = (@*WGPUChainedStruct)(&canvas_src),
    label       = nilptr,
  }
  self.surface = wgpuInstanceCreateSurface(self.instance, &surf_desc)
  if self.surface == nilptr then
    printf("wgpu: failed to create surface\n")
    return false
  end

  -- adapter 在 WASM 端不需要保存（已由 JS 处理），设为 nil
  self.adapter = nilptr

  -- Surface 格式：浏览器通常使用 BGRA8Unorm
  self.format = wgpuSurfaceGetPreferredFormat(self.surface, self.adapter)
  if self.format == WGPUTextureFormat_Undefined then
    self.format = WGPUTextureFormat_BGRA8Unorm
  end
  printf("wgpu: surface format = %u (browser preferred)\n", self.format)
  ## end

  -- 6. 配置 Surface
  local surf_cfg = WGPUSurfaceConfiguration{
    nextInChain     = nilptr,
    device          = self.device,
    format          = self.format,
    usage           = 0x00000010, -- WGPUTextureUsage_RenderAttachment
    width           = self.width,
    height          = self.height,
    viewFormatCount = 0,
    viewFormats     = nilptr,
    alphaMode       = 0, -- WGPUCompositeAlphaMode_Auto
    presentMode     = WGPUPresentMode_Fifo,
  }
  wgpuSurfaceConfigure(self.surface, &surf_cfg)

  printf("wgpu: renderer initialized (%dx%d)\n", self.width, self.height)
  return true
end

-- =============================================================================
-- ★ BUG-3 修复：nebula_create_uniform_buffer
--
-- 创建一个 Uniform Buffer。Slug 管线的 init 方法需要此函数。
-- 前置声明，供后续 pipeline_base_init / textured_init / textured_vertex_init 调用。
-- =============================================================================
global function nebula_create_uniform_buffer(
  out_buf:  *WGPUBuffer,
  renderer: *NebulaRenderer,
  size:     csize,
  label:    cstring
): boolean
  local buf_desc = WGPUBufferDescriptor{
    nextInChain      = nilptr,
    label            = wgpu_str(label),
    usage            = (@uint64)(WGPUBufferUsage_Uniform) | (@uint64)(WGPUBufferUsage_CopyDst),
    size             = (@uint64)(size),
    mappedAtCreation = 0,
  }
  $out_buf = wgpuDeviceCreateBuffer(renderer.device, &buf_desc)
  if $out_buf == nilptr then
    printf("wgpu: failed to create uniform buffer (%s)\n", label)
    return false
  end
  return true
end

-- =============================================================================
-- ★ 内部辅助函数：消除管线初始化的重复代码
--
-- _nebula_build_render_pipeline:
--   封装 Shader 编译 + PipelineLayout + BlendState + RenderPipeline 创建。
--   三个公共 init 函数（base / textured / textured_vertex）共享此逻辑。
--
-- _nebula_make_textured_bgl_entries:
--   填充带纹理管线的 3 个 BindGroupLayout 条目（uniform + texture + sampler）。
--   textured_init 和 textured_vertex_init 共享此逻辑。
-- =============================================================================

local function _nebula_build_render_pipeline(
  out_pipeline:   *WGPURenderPipeline,
  device:         WGPUDevice,
  bgl:            *WGPUBindGroupLayout,
  wgsl_source:    cstring,
  target_format:  WGPUTextureFormat,
  vertex_layout:  *WGPUVertexBufferLayout,
  label:          cstring
): boolean
  -- 1. Shader 模块
  local wgsl_src = WGPUShaderSourceWGSL{
    chain = WGPUChainedStruct{
      next  = nilptr,
      sType = WGPUSType_ShaderSourceWGSL,
    },
    code = wgpu_str(wgsl_source),
  }
  local shader_desc = WGPUShaderModuleDescriptor{
    nextInChain = (@*WGPUChainedStruct)(&wgsl_src),
    label       = wgpu_str(label),
  }
  local shader = wgpuDeviceCreateShaderModule(device, &shader_desc)
  if shader == nilptr then
    printf("wgpu: failed to create shader module (%s)\n", label)
    return false
  end

  -- 2. PipelineLayout
  local pl_desc = WGPUPipelineLayoutDescriptor{
    nextInChain          = nilptr,
    label                = wgpu_str(label),
    bindGroupLayoutCount = 1,
    bindGroupLayouts     = bgl,
  }
  local pipeline_layout = wgpuDeviceCreatePipelineLayout(device, &pl_desc)

  -- 3. Alpha 混合状态（所有 nebula 管线共用标准 SrcAlpha over 混合）
  local blend_state = WGPUBlendState{
    color = WGPUBlendComponent{
      operation = WGPUBlendOperation_Add,
      srcFactor = WGPUBlendFactor_SrcAlpha,
      dstFactor = WGPUBlendFactor_OneMinusSrcAlpha,
    },
    alpha = WGPUBlendComponent{
      operation = WGPUBlendOperation_Add,
      srcFactor = WGPUBlendFactor_One,
      dstFactor = WGPUBlendFactor_OneMinusSrcAlpha,
    },
  }
  local color_target = WGPUColorTargetState{
    nextInChain = nilptr,
    format      = target_format,
    blend       = &blend_state,
    writeMask   = (@uint32)(WGPUColorWriteMask_All),
  }
  local frag_state = WGPUFragmentState{
    nextInChain   = nilptr,
    module        = shader,
    entryPoint    = wgpu_str("fs_main"),
    constantCount = 0,
    constants     = nilptr,
    targetCount   = 1,
    targets       = &color_target,
  }

  -- 4. 顶点缓冲配置
  local buf_count: csize = 0
  local buf_ptr: *WGPUVertexBufferLayout = nilptr
  if vertex_layout ~= nilptr then
    buf_count = 1
    buf_ptr = vertex_layout
  end

  -- 5. RenderPipeline
## if NEBULA_TARGET ~= 'wasm' then
  local rp_desc = WGPURenderPipelineDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    layout      = pipeline_layout,
    vertex      = {
      nextInChain   = nilptr,
      module        = shader,
      entryPoint    = wgpu_str("vs_main"),
      constantCount = 0,
      constants     = nilptr,
      bufferCount   = buf_count,
      buffers       = buf_ptr,
    },
    primitive = {
      nextInChain       = nilptr,
      topology          = WGPUPrimitiveTopology_TriangleList,
      stripIndexFormat  = 0,
      frontFace         = 0,
      cullMode          = 0,
      unclippedDepth    = 0,
    },
    depthStencil = nilptr,
    multisample  = {
      nextInChain             = nilptr,
      count                   = 1,
      mask                    = 0xFFFFFFFF,
      alphaToCoverageEnabled  = 0,
    },
    fragment = &frag_state,
  }
## else
  local rp_desc = WGPURenderPipelineDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    layout      = pipeline_layout,
    vertex      = {
      nextInChain   = nilptr,
      module        = shader,
      entryPoint    = wgpu_str("vs_main"),
      constantCount = 0,
      constants     = nilptr,
      bufferCount   = buf_count,
      buffers       = buf_ptr,
    },
    primitive = {
      nextInChain       = nilptr,
      topology          = WGPUPrimitiveTopology_TriangleList,
      stripIndexFormat  = 0,
      frontFace         = 0,
      cullMode          = 0,
    },
    depthStencil = nilptr,
    multisample  = {
      nextInChain             = nilptr,
      count                   = 1,
      mask                    = 0xFFFFFFFF,
      alphaToCoverageEnabled  = 0,
    },
    fragment = &frag_state,
  }
## end
  $out_pipeline = wgpuDeviceCreateRenderPipeline(device, &rp_desc)
  wgpuShaderModuleRelease(shader)
  wgpuPipelineLayoutRelease(pipeline_layout)
  if $out_pipeline == nilptr then
    printf("wgpu: failed to create render pipeline (%s)\n", label)
    return false
  end

  return true
end

local function _nebula_make_textured_bgl_entries(
  entries: *[3]WGPUBindGroupLayoutEntry,
  uniform_size: csize
): void
  -- binding 0: uniform buffer
  entries[0] = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = 0,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Vertex) | (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {
      nextInChain      = nilptr,
      type             = (@uint32)(WGPUBufferBindingType_Uniform),
      hasDynamicOffset = 0,
      minBindingSize   = (@uint64)(uniform_size),
    },
    sampler        = {nextInChain = nilptr, type = 0},
    texture        = {nextInChain = nilptr, sampleType = 0, viewDimension = 0, multisampled = 0},
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
  -- binding 1: texture
  entries[1] = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = 1,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {nextInChain = nilptr, type = 0, hasDynamicOffset = 0, minBindingSize = 0},
    sampler     = {nextInChain = nilptr, type = 0},
    texture     = {
      nextInChain    = nilptr,
      sampleType     = (@uint32)(WGPUTextureSampleType_Float),
      viewDimension  = (@uint32)(WGPUTextureViewDimension_2D),
      multisampled   = 0,
    },
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
  -- binding 2: sampler
  entries[2] = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = 2,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {nextInChain = nilptr, type = 0, hasDynamicOffset = 0, minBindingSize = 0},
    sampler     = {nextInChain = nilptr, type = (@uint32)(WGPUSamplerBindingType_Filtering)},
    texture     = {nextInChain = nilptr, sampleType = 0, viewDimension = 0, multisampled = 0},
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
end

-- =============================================================================
-- Phase 2.3.1: nebula_pipeline_base_init
--
-- 所有派生的 <T>Pipeline:init 都将委托调用此函数。本函数封装：
--   1. 创建 Uniform Buffer（大小由调用方传入）
--   2. 创建 BindGroupLayout（单个 uniform binding）
--   3. 创建 BindGroup
--   4. 编译 WGSL 着色器模块
--   5. 创建渲染管线（全屏三角形 + Alpha 混合）
--
-- 通过将这些样板代码集中到一处，派生的管线代码可以保持极其简短，
-- 同时所有管线共享相同的 blend/primitive/multisample 设定，避免各
-- 自为政造成的渲染表现不一致。
--
-- 参数：
--   out_pipeline    — 输出：WGPURenderPipeline 句柄
--   out_bgl         — 输出：WGPUBindGroupLayout 句柄
--   out_ubuf        — 输出：WGPUBuffer（uniform buffer）句柄
--   out_bind_group  — 输出：WGPUBindGroup 句柄
--   renderer        — 关联的 NebulaRenderer（提供 device/format）
--   wgsl_source     — WGSL 着色器源码（NUL 结尾 C 字符串）
--   uniform_size    — Uniform buffer 的字节大小
--   label           — 调试用标签前缀（例如 "button" / "card"）
--
-- 返回：成功返回 true；任一步骤失败返回 false 并打印 wgpu 错误。
-- =============================================================================
global function nebula_pipeline_base_init(
  out_pipeline:   *WGPURenderPipeline,
  out_bgl:        *WGPUBindGroupLayout,
  out_ubuf:       *WGPUBuffer,
  out_bind_group: *WGPUBindGroup,
  renderer:       *NebulaRenderer,
  wgsl_source:    cstring,
  uniform_size:   csize,
  label:          cstring
): boolean
  local device = renderer.device

  -- 1. Uniform Buffer
  if not nebula_create_uniform_buffer(out_ubuf, renderer, uniform_size, label) then
    return false
  end

  -- 2. BindGroupLayout（单个 uniform binding）
  local entry = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = 0,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Vertex) | (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {
      nextInChain      = nilptr,
      type             = (@uint32)(WGPUBufferBindingType_Uniform),
      hasDynamicOffset = 0,
      minBindingSize   = (@uint64)(uniform_size),
    },
    sampler        = {nextInChain = nilptr, type = 0},
    texture        = {nextInChain = nilptr, sampleType = 0, viewDimension = 0, multisampled = 0},
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
  local bgl_desc = WGPUBindGroupLayoutDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    entryCount  = 1,
    entries     = &entry,
  }
  $out_bgl = wgpuDeviceCreateBindGroupLayout(device, &bgl_desc)
  if $out_bgl == nilptr then
    printf("wgpu: failed to create bind group layout (%s)\n", label)
    -- ★ 审计修复：释放已创建的 uniform buffer
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end

  -- 3. BindGroup
  local bg_entry = WGPUBindGroupEntry{
    nextInChain = nilptr,
    binding     = 0,
    buffer      = $out_ubuf,
    offset      = 0,
    size        = (@uint64)(uniform_size),
    sampler     = nilptr,
    textureView = nilptr,
  }
  local bg_desc = WGPUBindGroupDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    layout      = $out_bgl,
    entryCount  = 1,
    entries     = &bg_entry,
  }
  $out_bind_group = wgpuDeviceCreateBindGroup(device, &bg_desc)
  if $out_bind_group == nilptr then
    printf("wgpu: failed to create bind group (%s)\n", label)
    -- ★ 审计修复：释放已创建的资源
    wgpuBindGroupLayoutRelease($out_bgl)
    $out_bgl = nilptr
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end

  -- 4. Shader + Pipeline（委托公共辅助函数）
  return _nebula_build_render_pipeline(
    out_pipeline, device, out_bgl, wgsl_source,
    renderer.format, nilptr, label
  )
end

-- =============================================================================
-- ★ Phase 3.2.2: 纹理上传与顶点缓冲基础设施
-- =============================================================================

global NebulaPosUvVertex = @record{
  position: Vec2,
  uv:       Vec2,
}

global function nebula_upload_texture(
  out_texture:   *WGPUTexture,
  out_view:      *WGPUTextureView,
  renderer:      *NebulaRenderer,
  pixels:        pointer,
  width:         uint32,
  height:        uint32,
  format:        WGPUTextureFormat,
  bytes_per_row: uint32,
  label:         cstring
): boolean
  local tex_desc = WGPUTextureDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    usage           = (@uint64)(WGPUTextureUsage_CopyDst) | (@uint64)(WGPUTextureUsage_TextureBinding),
    dimension       = WGPUTextureDimension_2D,
    size            = WGPUExtent3D{ width = width, height = height, depthOrArrayLayers = 1 },
    format          = format,
    mipLevelCount   = 1,
    sampleCount     = 1,
    viewFormatCount = 0,
    viewFormats     = nilptr,
  }
  $out_texture = wgpuDeviceCreateTexture(renderer.device, &tex_desc)
  if $out_texture == nilptr then
    printf("wgpu: failed to create upload texture (%s)\n", label)
    return false
  end

## if NEBULA_TARGET ~= 'wasm' then
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    format          = format,
    dimension       = (@uint32)(WGPUTextureViewDimension_2D),
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = (@uint32)(WGPUTextureAspect_All),
    usage           = 0,
  }
## else
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    format          = format,
    dimension       = (@uint32)(WGPUTextureViewDimension_2D),
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = (@uint32)(WGPUTextureAspect_All),
  }
## end
  $out_view = wgpuTextureCreateView($out_texture, &view_desc)
  if $out_view == nilptr then
    printf("wgpu: failed to create upload texture view (%s)\n", label)
    wgpuTextureRelease($out_texture)
    $out_texture = nilptr
    return false
  end

  if pixels ~= nilptr and width > 0 and height > 0 then
    local dst = WGPUTexelCopyTextureInfo{
      texture  = $out_texture,
      mipLevel = 0,
      origin   = WGPUOrigin3D{ x = 0, y = 0, z = 0 },
      aspect   = WGPUTextureAspect_All,
    }
    local layout = WGPUTexelCopyBufferLayout{
      offset       = 0,
      bytesPerRow  = bytes_per_row,
      rowsPerImage = height,
    }
    local write_size = WGPUExtent3D{ width = width, height = height, depthOrArrayLayers = 1 }
    local data_size = (@csize)((@uint64)(bytes_per_row) * (@uint64)(height))
    wgpuQueueWriteTexture(renderer.queue, &dst, pixels, data_size, &layout, &write_size)
  end

  printf("wgpu: texture uploaded (%s, %ux%u)\n", label, width, height)
  return true
end

global function nebula_init_pos_uv_vertex_layout(
  out_layout: *WGPUVertexBufferLayout,
  attrs:      *WGPUVertexAttribute
): void
  local attrs_ptr = (@*[0]WGPUVertexAttribute)(attrs)
  attrs_ptr[0] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x2,
    offset         = 0,
    shaderLocation = 0,
  }
  attrs_ptr[1] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x2,
    offset         = (@uint64)(#Vec2),
    shaderLocation = 1,
  }
  $out_layout = WGPUVertexBufferLayout{
        stepMode       = WGPUVertexStepMode_Vertex,
    arrayStride    = (@uint64)(#NebulaPosUvVertex),
    attributeCount = 2,
    attributes     = (@*WGPUVertexAttribute)(attrs_ptr),
  }
end

-- =============================================================================
-- Phase 2.3.3 以前此处保留过 NebulaRectUniforms / RECT_SHADER_WGSL /
-- NebulaRectPipeline 的兼容三件套。Phase 2.3.4 后所有 examples 和 headless_test
-- 均已迁移到 nebula_derive 生成的 <T>Uniforms / <T>Pipeline，因此此兼容层
-- 已于清理阶段删除。参见 docs/PLAN_PHASE2_3.md 验收标准第 2 项。
-- =============================================================================

-- =============================================================================
-- ★ Phase 2.5: 离屏渲染基础设施
--
-- 为多 Pass 渲染（Shadow / Blur）提供离屏纹理创建、采样器创建
-- 和带纹理绑定的管线初始化函数。
-- =============================================================================

-- =============================================================================
-- nebula_create_render_target
--
-- 分配一个指定尺寸的离屏纹理（BGRA8Unorm），同时创建其 TextureView。
-- 用途标记为 RenderAttachment | TextureBinding，使其既可作为渲染目标，
-- 又可在后续 Pass 中作为纹理采样源。
--
-- 参数：
--   out_texture  — 输出：WGPUTexture 句柄
--   out_view     — 输出：WGPUTextureView 句柄
--   renderer     — 关联的 NebulaRenderer
--   w, h         — 纹理尺寸
--   label        — 调试标签
--
-- 返回：成功返回 true
-- =============================================================================
global function nebula_create_render_target(
  out_texture: *WGPUTexture,
  out_view:    *WGPUTextureView,
  renderer:    *NebulaRenderer,
  w: uint32, h: uint32,
  label: cstring
): boolean
  local tex_desc = WGPUTextureDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    usage           = (@uint64)(WGPUTextureUsage_RenderAttachment) | (@uint64)(WGPUTextureUsage_TextureBinding),
    dimension       = WGPUTextureDimension_2D,
    size            = WGPUExtent3D{ width = w, height = h, depthOrArrayLayers = 1 },
    format          = renderer.format,
    mipLevelCount   = 1,
    sampleCount     = 1,
    viewFormatCount = 0,
    viewFormats     = nilptr,
  }
  $out_texture = wgpuDeviceCreateTexture(renderer.device, &tex_desc)
  if $out_texture == nilptr then
    printf("wgpu: failed to create render target texture (%s)\n", label)
    return false
  end

## if NEBULA_TARGET ~= 'wasm' then
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    format          = renderer.format,
    dimension       = (@uint32)(WGPUTextureViewDimension_2D),
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = (@uint32)(WGPUTextureAspect_All),
    usage           = 0,
  }
## else
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str(label),
    format          = renderer.format,
    dimension       = (@uint32)(WGPUTextureViewDimension_2D),
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = (@uint32)(WGPUTextureAspect_All),
  }
## end
  $out_view = wgpuTextureCreateView($out_texture, &view_desc)
  if $out_view == nilptr then
    printf("wgpu: failed to create render target view (%s)\n", label)
    return false
  end

  printf("wgpu: render target created (%s, %dx%d)\n", label, w, h)
  return true
end

-- =============================================================================
-- nebula_create_sampler
--
-- 创建一个线性过滤、边缘钳位的采样器，用于模糊 Pass 的纹理采样。
--
-- 参数：
--   renderer — 关联的 NebulaRenderer
--
-- 返回：WGPUSampler 句柄（nilptr 表示失败）
-- =============================================================================
global function nebula_create_sampler(renderer: *NebulaRenderer): WGPUSampler
  local desc = WGPUSamplerDescriptor{
    nextInChain   = nilptr,
    label         = wgpu_str("nebula-blur-sampler"),
    addressModeU  = WGPUAddressMode_ClampToEdge,
    addressModeV  = WGPUAddressMode_ClampToEdge,
    addressModeW  = WGPUAddressMode_ClampToEdge,
    magFilter     = WGPUFilterMode_Linear,
    minFilter     = WGPUFilterMode_Linear,
    mipmapFilter  = WGPUMipmapFilterMode_Nearest,
    lodMinClamp   = 0.0,
    lodMaxClamp   = 1.0,
    compare       = 0,
    maxAnisotropy = 1,
  }
  local sampler = wgpuDeviceCreateSampler(renderer.device, &desc)
  if sampler == nilptr then
    printf("wgpu: failed to create sampler\n")
  end
  return sampler
end

-- =============================================================================
-- nebula_pipeline_textured_init
--
-- 与 nebula_pipeline_base_init 类似，但 BindGroupLayout 包含三个条目：
--   binding 0: Uniform Buffer
--   binding 1: Texture（2D, float, filterable）
--   binding 2: Sampler（filtering）
--
-- 用于模糊 Pass 的管线初始化，这些 Pass 需要从上一个 Pass 的离屏纹理中采样。
--
-- 参数：
--   out_pipeline    — 输出：WGPURenderPipeline
--   out_bgl         — 输出：WGPUBindGroupLayout
--   out_ubuf        — 输出：WGPUBuffer（blur uniform buffer）
--   renderer        — NebulaRenderer
--   wgsl_source     — WGSL 着色器源码
--   uniform_size    — Blur uniform 字节大小
--   target_format   — 渲染目标的纹理格式
--   label           — 调试标签
--
-- 返回：成功返回 true
-- =============================================================================
global function nebula_pipeline_textured_init(
  out_pipeline:   *WGPURenderPipeline,
  out_bgl:        *WGPUBindGroupLayout,
  out_ubuf:       *WGPUBuffer,
  renderer:       *NebulaRenderer,
  wgsl_source:    cstring,
  uniform_size:   csize,
  target_format:  WGPUTextureFormat,
  label:          cstring
): boolean
  local device = renderer.device

  -- 1. Uniform Buffer
  if not nebula_create_uniform_buffer(out_ubuf, renderer, uniform_size, label) then
    return false
  end

  -- 2. BindGroupLayout（3 entries: uniform + texture + sampler）
  local entries: [3]WGPUBindGroupLayoutEntry
  _nebula_make_textured_bgl_entries(&entries, uniform_size)

  local bgl_desc = WGPUBindGroupLayoutDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    entryCount  = 3,
    entries     = &entries[0],
  }
  $out_bgl = wgpuDeviceCreateBindGroupLayout(device, &bgl_desc)
  if $out_bgl == nilptr then
    printf("wgpu: failed to create textured bind group layout (%s)\n", label)
    -- ★ 审计修复：释放已创建的 uniform buffer
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end

  -- 3. Shader + Pipeline（委托公共辅助函数）
  if not _nebula_build_render_pipeline(
    out_pipeline, device, out_bgl, wgsl_source,
    target_format, nilptr, label
  ) then
    -- ★ 审计修复：释放已创建的资源
    wgpuBindGroupLayoutRelease($out_bgl)
    $out_bgl = nilptr
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end
  return true
end

-- =============================================================================
-- nebula_pipeline_textured_vertex_init
--
-- 为需要采样纹理且依赖显式顶点缓冲的管线创建：
--   binding 0: Uniform Buffer
--   binding 1: Texture
--   binding 2: Sampler
--   vertex   : 单个顶点缓冲布局（Position + UV 等）
-- =============================================================================
global function nebula_pipeline_textured_vertex_init(
  out_pipeline:   *WGPURenderPipeline,
  out_bgl:        *WGPUBindGroupLayout,
  out_ubuf:       *WGPUBuffer,
  renderer:       *NebulaRenderer,
  wgsl_source:    cstring,
  uniform_size:   csize,
  target_format:  WGPUTextureFormat,
  vertex_layout:  *WGPUVertexBufferLayout,
  label:          cstring
): boolean
  local device = renderer.device

  -- 1. Uniform Buffer
  if not nebula_create_uniform_buffer(out_ubuf, renderer, uniform_size, label) then
    return false
  end

  -- 2. BindGroupLayout（3 entries: uniform + texture + sampler）
  local entries: [3]WGPUBindGroupLayoutEntry
  _nebula_make_textured_bgl_entries(&entries, uniform_size)

  local bgl_desc = WGPUBindGroupLayoutDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    entryCount  = 3,
    entries     = &entries[0],
  }
  $out_bgl = wgpuDeviceCreateBindGroupLayout(device, &bgl_desc)
  if $out_bgl == nilptr then
    printf("wgpu: failed to create textured vertex bind group layout (%s)\n", label)
    -- ★ 审计修复：释放已创建的 uniform buffer
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end

  -- 3. Shader + Pipeline（委托公共辅助函数，传入 vertex_layout）
  if not _nebula_build_render_pipeline(
    out_pipeline, device, out_bgl, wgsl_source,
    target_format, vertex_layout, label
  ) then
    -- ★ 审计修复：释放已创建的资源
    wgpuBindGroupLayoutRelease($out_bgl)
    $out_bgl = nilptr
    wgpuBufferRelease($out_ubuf)
    $out_ubuf = nilptr
    return false
  end
  return true
end

-- =============================================================================
-- nebula_create_textured_bind_group
--
-- 为带纹理采样的管线创建 BindGroup，绑定 uniform buffer + 纹理视图 + 采样器。
-- =============================================================================
global function nebula_create_textured_bind_group(
  renderer:     *NebulaRenderer,
  bgl:          WGPUBindGroupLayout,
  ubuf:         WGPUBuffer,
  tex_view:     WGPUTextureView,
  sampler:      WGPUSampler,
  uniform_size: csize,
  label:        cstring
): WGPUBindGroup
  local entries: [3]WGPUBindGroupEntry
  entries[0] = WGPUBindGroupEntry{
    nextInChain = nilptr,
    binding     = 0,
    buffer      = ubuf,
    offset      = 0,
    size        = (@uint64)(uniform_size),
    sampler     = nilptr,
    textureView = nilptr,
  }
  entries[1] = WGPUBindGroupEntry{
    nextInChain = nilptr,
    binding     = 1,
    buffer      = nilptr,
    offset      = 0,
    size        = 0,
    sampler     = nilptr,
    textureView = tex_view,
  }
  entries[2] = WGPUBindGroupEntry{
    nextInChain = nilptr,
    binding     = 2,
    buffer      = nilptr,
    offset      = 0,
    size        = 0,
    sampler     = sampler,
    textureView = nilptr,
  }

  local bg_desc = WGPUBindGroupDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    layout      = bgl,
    entryCount  = 3,
    entries     = &entries[0],
  }
  return wgpuDeviceCreateBindGroup(renderer.device, &bg_desc)
end

-- =============================================================================
-- nebula_create_blur_bind_group
--
-- 为模糊 Pass 创建 BindGroup。保留旧名称以兼容 Phase 2.5 阴影代码路径。
-- =============================================================================
global function nebula_create_blur_bind_group(
  renderer:     *NebulaRenderer,
  bgl:          WGPUBindGroupLayout,
  ubuf:         WGPUBuffer,
  tex_view:     WGPUTextureView,
  sampler:      WGPUSampler,
  uniform_size: csize,
  label:        cstring
): WGPUBindGroup
  return nebula_create_textured_bind_group(renderer, bgl, ubuf, tex_view, sampler, uniform_size, label)
end

-- =============================================================================
-- ★ Phase 3.3: nebula_create_storage_buffer
--
-- 创建一个 Storage Buffer，用于存储实例化渲染中所有实例的数据数组。
--
-- Storage Buffer 与 Uniform Buffer 的关键区别：
--   · Uniform Buffer：大小限制为 65536 字节，适合少量全局参数。
--   · Storage Buffer：大小仅受设备内存限制，适合大量实例数据。
--
-- 在 WGSL 着色器中，通过 var<storage, read> 绑定。
-- 在 Nelua 运行时，通过 wgpuQueueWriteBuffer 整体更新。
--
-- 参数：
--   out_buf   — 输出：WGPUBuffer 句柄
--   renderer  — 关联的 NebulaRenderer
--   size      — Buffer 字节大小（通常为 max_instances * sizeof(InstanceData)）
--   label     — 调试标签
--
-- 返回：成功返回 true
-- =============================================================================
-- ★ BUG-5 修复：添加 data 参数，支持创建时上传初始数据
global function nebula_create_storage_buffer(
  out_buf:  *WGPUBuffer,
  renderer: *NebulaRenderer,
  data:     pointer,
  size:     csize,
  label:    cstring
): boolean
  local buf_desc = WGPUBufferDescriptor{
    nextInChain      = nilptr,
    label            = wgpu_str(label),
    usage            = (@uint64)(WGPUBufferUsage_Storage) | (@uint64)(WGPUBufferUsage_CopyDst),
    size             = (@uint64)(size),
    mappedAtCreation = 0,
  }
  $out_buf = wgpuDeviceCreateBuffer(renderer.device, &buf_desc)
  if $out_buf == nilptr then
    printf("wgpu: failed to create storage buffer (%s)\n", label)
    return false
  end
  if data ~= nilptr and size > 0 then
    wgpuQueueWriteBuffer(renderer.queue, $out_buf, 0, data, size)
  end
  printf("wgpu: storage buffer created (%s, %llu bytes)\n", label, (@uint64)(size))
  return true
end

-- =============================================================================
-- ★ Phase 3.3: nebula_create_vertex_buffer
--
-- 创建一个顶点缓冲区并可选地上传初始数据。
-- 此函数已在 Phase 3.2.2 的 pipeline_factory.lua 中通过内联使用，
-- 现将其提升为公共 API 以便其他模块直接调用。
-- =============================================================================
global function nebula_create_vertex_buffer(
  out_buf:  *WGPUBuffer,
  renderer: *NebulaRenderer,
  data:     pointer,
  size:     csize,
  label:    cstring
): boolean
  local buf_desc = WGPUBufferDescriptor{
    nextInChain      = nilptr,
    label            = wgpu_str(label),
    usage            = (@uint64)(WGPUBufferUsage_Vertex) | (@uint64)(WGPUBufferUsage_CopyDst),
    size             = (@uint64)(size),
    mappedAtCreation = 0,
  }
  $out_buf = wgpuDeviceCreateBuffer(renderer.device, &buf_desc)
  if $out_buf == nilptr then
    printf("wgpu: failed to create vertex buffer (%s)\n", label)
    return false
  end
  if data ~= nilptr and size > 0 then
    wgpuQueueWriteBuffer(renderer.queue, $out_buf, 0, data, size)
  end
  return true
end

-- =============================================================================
-- ★ Phase 4.X: 高密度文本 Record 定义
--
-- DenseCharInstance (32 bytes): per-char 实例数据，通过 Storage Buffer 传递。
-- DenseTextUniforms (16 bytes): viewport + cell_size uniform。
--
-- 这两个 record 的内存布局必须与 shader_compose.lua 中的 WGSL struct 精确对齐：
--   WGSL DenseCharInstance: pos_x(f32) pos_y(f32) uv_x(f32) uv_y(f32) uv_w(f32) uv_h(f32) fg_color(u32) bg_color(u32)
--   WGSL DenseTextUniforms: viewport(vec2<f32>) cell_w(f32) cell_h(f32)
-- =============================================================================

global DenseCharInstance = @record{
  pos_x:    float32,   -- 字符左上角 X（像素坐标）
  pos_y:    float32,   -- 字符左上角 Y（像素坐标）
  uv_x:     float32,   -- atlas 纹理 U 起点
  uv_y:     float32,   -- atlas 纹理 V 起点
  uv_w:     float32,   -- atlas 纹理 U 宽度
  uv_h:     float32,   -- atlas 纹理 V 高度
  fg_color: uint32,    -- RGBA8 packed 前景色（unpack4x8unorm 解包）
  bg_color: uint32,    -- RGBA8 packed 背景色
}

global DenseTextUniforms = @record{
  viewport_w: float32,  -- 视口宽度（像素）
  viewport_h: float32,  -- 视口高度（像素）
  cell_w:     float32,  -- 等宽字符单元格宽度（像素）
  cell_h:     float32,  -- 等宽字符单元格高度（像素）
}

-- 辅助函数：将 RGBA (0-255) 四通道打包为 uint32（与 WGSL unpack4x8unorm 一致）
global function nebula_pack_rgba8(r: uint8, g: uint8, b: uint8, a: uint8): uint32
  return (@uint32)(r) | ((@uint32)(g) << 8) | ((@uint32)(b) << 16) | ((@uint32)(a) << 24)
end

-- =============================================================================
-- ★ Phase 4.2.3-S2: Slug Pipeline Helper Functions
--
-- 由 pipeline_factory.lua 生成的 SlugTextPipeline:init 调用。
-- 封装 BindGroupLayout / BindGroup / RenderPipeline 创建的公共逻辑。
-- =============================================================================

-- 填充一个 BindGroupLayoutEntry 为 Uniform Buffer 绑定
global function nebula_bgl_entry_uniform(out: *WGPUBindGroupLayoutEntry, binding: uint32): void
  $out = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = binding,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Vertex) | (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {
      nextInChain      = nilptr,
      type             = (@uint32)(WGPUBufferBindingType_Uniform),
      hasDynamicOffset = 0,
      minBindingSize   = 0,
    },
    sampler        = {nextInChain = nilptr, type = 0},
    texture        = {nextInChain = nilptr, sampleType = 0, viewDimension = 0, multisampled = 0},
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
end

-- 填充一个 BindGroupLayoutEntry 为 Read-Only Storage Buffer 绑定
global function nebula_bgl_entry_storage_ro(out: *WGPUBindGroupLayoutEntry, binding: uint32): void
  $out = WGPUBindGroupLayoutEntry{
    nextInChain = nilptr,
    binding     = binding,
    visibility  = (@WGPUShaderStage)(WGPUShaderStage_Vertex) | (@WGPUShaderStage)(WGPUShaderStage_Fragment),
    buffer      = {
      nextInChain      = nilptr,
      type             = (@uint32)(WGPUBufferBindingType_ReadOnlyStorage),
      hasDynamicOffset = 0,
      minBindingSize   = 0,
    },
    sampler        = {nextInChain = nilptr, type = 0},
    texture        = {nextInChain = nilptr, sampleType = 0, viewDimension = 0, multisampled = 0},
    storageTexture = {nextInChain = nilptr, access = 0, format = WGPUTextureFormat_Undefined, viewDimension = 0},
  }
end

-- 从 entries 数组创建 BindGroupLayout
global function nebula_create_bind_group_layout(
  renderer:    *NebulaRenderer,
  entries:     *WGPUBindGroupLayoutEntry,
  entry_count: csize,
  label:       cstring
): WGPUBindGroupLayout
  local desc = WGPUBindGroupLayoutDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    entryCount  = entry_count,
    entries     = entries,
  }
  local bgl = wgpuDeviceCreateBindGroupLayout(renderer.device, &desc)
  if bgl == nilptr then
    printf("wgpu: failed to create bind group layout (%s)\n", label)
  end
  return bgl
end

-- 填充一个 BindGroupEntry 为 Buffer 绑定
global function nebula_bge_buffer(
  out:     *WGPUBindGroupEntry,
  binding: uint32,
  buffer:  WGPUBuffer,
  offset:  uint64,
  size:    uint64
): void
  $out = WGPUBindGroupEntry{
    nextInChain = nilptr,
    binding     = binding,
    buffer      = buffer,
    offset      = offset,
    size        = size,
    sampler     = nilptr,
    textureView = nilptr,
  }
end

-- 从 entries 数组创建 BindGroup
global function nebula_create_bind_group(
  renderer:    *NebulaRenderer,
  layout:      WGPUBindGroupLayout,
  entries:     *WGPUBindGroupEntry,
  entry_count: csize,
  label:       cstring
): WGPUBindGroup
  local desc = WGPUBindGroupDescriptor{
    nextInChain = nilptr,
    label       = wgpu_str(label),
    layout      = layout,
    entryCount  = entry_count,
    entries     = entries,
  }
  local bg = wgpuDeviceCreateBindGroup(renderer.device, &desc)
  if bg == nilptr then
    printf("wgpu: failed to create bind group (%s)\n", label)
  end
  return bg
end

-- 从 BindGroupLayout + WGSL + VertexLayout 创建 RenderPipeline
global function nebula_create_render_pipeline_with_layout(
  renderer:      *NebulaRenderer,
  bgl:           WGPUBindGroupLayout,
  wgsl_source:   cstring,
  wgsl_len:      csize,
  target_format: WGPUTextureFormat,
  vertex_layout: *WGPUVertexBufferLayout,
  label:         cstring
): WGPURenderPipeline
  local out_pipeline: WGPURenderPipeline = nilptr
  if not _nebula_build_render_pipeline(
    &out_pipeline, renderer.device, &bgl,
    wgsl_source, target_format, vertex_layout, label
  ) then
    return nilptr
  end
  return out_pipeline
end

-- =============================================================================
-- ★ Phase 4.2.2: nebula_init_slug_vertex_layout
--
-- Slug 文本顶点布局初始化（5 x vec4<f32> = 80 bytes/vertex）。
-- 由 pipeline_factory.lua 生成的 SlugTextPipeline:init 调用。
-- =============================================================================
global function nebula_init_slug_vertex_layout(
  out_layout: *WGPUVertexBufferLayout,
  attrs:      *WGPUVertexAttribute
): void
  local attrs_ptr = (@*[0]WGPUVertexAttribute)(attrs)
  -- attr0: pos (vec4<f32>)
  attrs_ptr[0] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x4,
    offset         = 0,
    shaderLocation = 0,
  }
  -- attr1: tex (vec4<f32>)
  attrs_ptr[1] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x4,
    offset         = 16,
    shaderLocation = 1,
  }
  -- attr2: bnd (vec4<f32>)
  attrs_ptr[2] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x4,
    offset         = 32,
    shaderLocation = 2,
  }
  -- attr3: jac (vec4<f32>) — Phase 4.2.2 D-4.1-B: Jacobian inverse
  attrs_ptr[3] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x4,
    offset         = 48,
    shaderLocation = 3,
  }
  -- attr4: col (vec4<f32>)
  attrs_ptr[4] = WGPUVertexAttribute{
        format         = WGPUVertexFormat_Float32x4,
    offset         = 64,
    shaderLocation = 4,
  }
  $out_layout = WGPUVertexBufferLayout{
        stepMode       = WGPUVertexStepMode_Vertex,
    arrayStride    = 80,  -- 5 x vec4<f32> = 80 bytes
    attributeCount = 5,
    attributes     = (@*WGPUVertexAttribute)(attrs_ptr),
  }
end
