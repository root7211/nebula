-- =============================================================================
-- src/harfbuzz_bindings.nelua
-- Nebula GUI Compiler — Phase 4.2.3-S0
--
-- HarfBuzz 核心 C API 的 Nelua 绑定。
-- 仅绑定预处理阶段（S0）所需的最小 API 子集：
--   · Blob / Face / Font 生命周期管理
--   · Buffer 创建与字符添加
--   · hb_shape() 文本塑形
--   · Glyph info / position 结果提取
--
-- 设计哲学（公理 A）：
--   · HarfBuzz 仅在 S0（预处理）阶段使用，绝不进入 S2（运行时）。
--   · 本绑定文件仅被 tools/font_preprocessor_cjk.nelua 引用。
--   · 运行时的排版退化为静态查表（O(1)），零 HarfBuzz 依赖。
--
-- 用法：
--   require 'harfbuzz_bindings'
--   -- 编译时需要 -lharfbuzz
-- =============================================================================

## cinclude '<harfbuzz/hb.h>'
## linklib 'harfbuzz'

-- =============================================================================
-- 基本类型
-- =============================================================================
global hb_bool_t:      type = @cint
global hb_codepoint_t: type = @uint32
global hb_position_t:  type = @int32
global hb_mask_t:      type = @uint32
global hb_tag_t:       type = @uint32

-- =============================================================================
-- 方向枚举
-- =============================================================================
global HB_DIRECTION_INVALID: cint <comptime> = 0
global HB_DIRECTION_LTR:     cint <comptime> = 4
global HB_DIRECTION_RTL:     cint <comptime> = 5
global HB_DIRECTION_TTB:     cint <comptime> = 6
global HB_DIRECTION_BTT:     cint <comptime> = 7

-- =============================================================================
-- 脚本枚举（常用子集）
-- =============================================================================
-- HB_TAG('L','a','t','n') = 0x4C61746E
global HB_SCRIPT_LATIN: uint32 <comptime> = 0x4C61746E
-- HB_TAG('H','a','n','i') = 0x48616E69
global HB_SCRIPT_HAN:   uint32 <comptime> = 0x48616E69

-- =============================================================================
-- 内存模式枚举（blob 用）
-- =============================================================================
global HB_MEMORY_MODE_READONLY: cint <comptime> = 1

-- =============================================================================
-- 不透明句柄类型（forward declarations）
-- =============================================================================
global hb_blob_t:     type <cimport, nodecl, forwarddecl> = @record{}
global hb_face_t:     type <cimport, nodecl, forwarddecl> = @record{}
global hb_font_t:     type <cimport, nodecl, forwarddecl> = @record{}
global hb_buffer_t:   type <cimport, nodecl, forwarddecl> = @record{}
global hb_language_t: type = @pointer  -- opaque pointer to hb_language_impl_t

-- =============================================================================
-- hb_feature_t — OpenType 特性开关
-- =============================================================================
global hb_feature_t: type <cimport, nodecl> = @record{
  tag:   hb_tag_t,
  value: uint32,
  start: cuint,
  end_:  cuint,  -- 'end' is a Nelua keyword, use end_
}

-- =============================================================================
-- hb_glyph_info_t — 塑形输出：字形标识
-- =============================================================================
global hb_glyph_info_t: type <cimport, nodecl> = @record{
  codepoint: hb_codepoint_t,  -- 塑形后为 glyph index
  mask:      hb_mask_t,
  cluster:   uint32,
  var1:      uint32,
  var2:      uint32,
}

-- =============================================================================
-- hb_glyph_position_t — 塑形输出：字形定位
-- =============================================================================
global hb_glyph_position_t: type <cimport, nodecl> = @record{
  x_advance: hb_position_t,
  y_advance: hb_position_t,
  x_offset:  hb_position_t,
  y_offset:  hb_position_t,
  var:       uint32,  -- private
}

-- =============================================================================
-- Blob API
-- =============================================================================
global function hb_blob_create(
  data: cstring,
  length: cuint,
  mode: cint,
  user_data: pointer,
  destroy: pointer
): *hb_blob_t <cimport, nodecl> end

global function hb_blob_destroy(blob: *hb_blob_t): void <cimport, nodecl> end

-- =============================================================================
-- Face API
-- =============================================================================
global function hb_face_create(
  blob: *hb_blob_t,
  index: cuint
): *hb_face_t <cimport, nodecl> end

global function hb_face_destroy(face: *hb_face_t): void <cimport, nodecl> end

global function hb_face_get_upem(face: *hb_face_t): cuint <cimport, nodecl> end

-- =============================================================================
-- Font API
-- =============================================================================
global function hb_font_create(face: *hb_face_t): *hb_font_t <cimport, nodecl> end

global function hb_font_destroy(font: *hb_font_t): void <cimport, nodecl> end

global function hb_font_set_scale(
  font: *hb_font_t,
  x_scale: cint,
  y_scale: cint
): void <cimport, nodecl> end

global function hb_font_get_h_extents(
  font: *hb_font_t,
  extents: pointer
): hb_bool_t <cimport, nodecl> end

global function hb_font_get_glyph_extents(
  font: *hb_font_t,
  glyph: hb_codepoint_t,
  extents: pointer
): hb_bool_t <cimport, nodecl> end

-- =============================================================================
-- Buffer API
-- =============================================================================
global function hb_buffer_create(): *hb_buffer_t <cimport, nodecl> end

global function hb_buffer_destroy(buffer: *hb_buffer_t): void <cimport, nodecl> end

global function hb_buffer_reset(buffer: *hb_buffer_t): void <cimport, nodecl> end

global function hb_buffer_clear_contents(buffer: *hb_buffer_t): void <cimport, nodecl> end

global function hb_buffer_add_codepoints(
  buffer: *hb_buffer_t,
  text: *hb_codepoint_t,
  text_length: cint,
  item_offset: cuint,
  item_length: cint
): void <cimport, nodecl> end

global function hb_buffer_add_utf32(
  buffer: *hb_buffer_t,
  text: *uint32,
  text_length: cint,
  item_offset: cuint,
  item_length: cint
): void <cimport, nodecl> end

global function hb_buffer_set_direction(
  buffer: *hb_buffer_t,
  direction: cint
): void <cimport, nodecl> end

global function hb_buffer_set_script(
  buffer: *hb_buffer_t,
  script: uint32
): void <cimport, nodecl> end

global function hb_buffer_set_language(
  buffer: *hb_buffer_t,
  language: hb_language_t
): void <cimport, nodecl> end

global function hb_buffer_get_length(
  buffer: *hb_buffer_t
): cuint <cimport, nodecl> end

global function hb_buffer_get_glyph_infos(
  buffer: *hb_buffer_t,
  length: *cuint
): *hb_glyph_info_t <cimport, nodecl> end

global function hb_buffer_get_glyph_positions(
  buffer: *hb_buffer_t,
  length: *cuint
): *hb_glyph_position_t <cimport, nodecl> end

global function hb_buffer_guess_segment_properties(
  buffer: *hb_buffer_t
): void <cimport, nodecl> end

-- =============================================================================
-- Shape API
-- =============================================================================
global function hb_shape(
  font: *hb_font_t,
  buffer: *hb_buffer_t,
  features: *hb_feature_t,
  num_features: cuint
): void <cimport, nodecl> end

-- =============================================================================
-- Language API
-- =============================================================================
global function hb_language_from_string(
  str: cstring,
  len: cint
): hb_language_t <cimport, nodecl> end

-- =============================================================================
-- Tag helper
-- =============================================================================
global function hb_tag_from_string(
  str: cstring,
  len: cint
): hb_tag_t <cimport, nodecl> end

-- =============================================================================
-- Glyph extents (used by hb_font_get_glyph_extents)
-- =============================================================================
global hb_glyph_extents_t: type <cimport, nodecl> = @record{
  x_bearing: hb_position_t,
  y_bearing: hb_position_t,
  width:     hb_position_t,
  height:    hb_position_t,
}
