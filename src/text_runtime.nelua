require "renderer"
require "liberation_sans_ascii_48_metrics"
require "liberation_sans_slug_metrics"  -- ★ BUG-7 修复：Slug 路径所需的 NebulaSlugGlyph 等符号

## cinclude "<stdio.h>"
## cinclude "<string.h>"
## cinclude "<stdlib.h>"

global FILE: type <cimport,nodecl,forwarddecl> = @record{}
global function fopen(path: cstring, mode: cstring): *FILE <cimport, nodecl> end
global function fclose(fp: *FILE): cint <cimport, nodecl> end
global function fread(ptr: pointer, size: csize, count: csize, fp: *FILE): csize <cimport, nodecl> end
global function fscanf(fp: *FILE, fmt: cstring, ...: cvarargs): cint <cimport, nodecl> end
global function fgetc(fp: *FILE): cint <cimport, nodecl> end
global function malloc(size: csize): pointer <cimport, nodecl> end
global function free(ptr: pointer): void <cimport, nodecl> end
global function strlen(s: cstring): csize <cimport, nodecl> end

global NebulaAsciiFontAtlas = @record{
  texture: WGPUTexture,
  view:    WGPUTextureView,
  sampler: WGPUSampler,
  width:   uint32,
  height:  uint32,
}

global NebulaTextMesh = @record{
  vertex_buffer:      WGPUBuffer,
  vertex_buffer_size: uint64,
  vertex_count:       uint32,
  width:              float32,
  height:             float32,
}

function NebulaTextMesh:init(): void
  self.vertex_buffer = nilptr
  self.vertex_buffer_size = 0
  self.vertex_count = 0
  self.width = 0.0
  self.height = 0.0
end

local function nebula_ascii_glyph_for_codepoint(cp: cint, out_glyph: *NebulaGeneratedAsciiGlyph): boolean
  local fallback = 63 -- '?'
  if cp < NEBULA_ASCII_FIRST_CODEPOINT or cp > NEBULA_ASCII_LAST_CODEPOINT then
    cp = fallback
  end
  local idx = cp - NEBULA_ASCII_FIRST_CODEPOINT
  if idx < 0 or idx >= NEBULA_ASCII_GLYPH_COUNT then
    return false
  end
  $out_glyph = NEBULA_ASCII_GLYPHS[idx]
  return true
end

local function nebula_text_read_pgm_gray8(path: cstring, out_pixels: **cuchar, out_w: *uint32, out_h: *uint32): boolean
  local fp = fopen(path, "rb")
  if fp == nilptr then
    printf("text: failed to open atlas %s\n", path)
    return false
  end

  local magic: [3]cchar
  local w: cint = 0
  local h: cint = 0
  local maxv: cint = 0
  if fscanf(fp, "%2s", &magic[0]) ~= 1 then fclose(fp) return false end
  if magic[0] ~= 'P' or magic[1] ~= '5' then
    printf("text: unsupported atlas header in %s\n", path)
    fclose(fp)
    return false
  end
  if fscanf(fp, "%d %d %d", &w, &h, &maxv) ~= 3 then
    printf("text: failed to parse atlas header %s\n", path)
    fclose(fp)
    return false
  end
  if maxv ~= 255 then
    printf("text: unsupported atlas max value %d\n", maxv)
    fclose(fp)
    return false
  end
  if fgetc(fp) < 0 then
    fclose(fp)
    return false
  end

  local bytes = (@csize)(w * h)
  local pixels = (@*cuchar)(malloc(bytes))
  if pixels == nilptr then
    fclose(fp)
    return false
  end
  local nread = fread(pixels, 1, bytes, fp)
  fclose(fp)
  if nread ~= bytes then
    free(pixels)
    printf("text: atlas payload truncated %s\n", path)
    return false
  end

  $out_pixels = pixels
  $out_w = (@uint32)(w)
  $out_h = (@uint32)(h)
  return true
end

global function nebula_text_create_sampler(renderer: *NebulaRenderer, label: cstring): WGPUSampler
  local desc = WGPUSamplerDescriptor{
    nextInChain   = nilptr,
    label         = wgpu_str(label),
    addressModeU  = WGPUAddressMode_ClampToEdge,
    addressModeV  = WGPUAddressMode_ClampToEdge,
    addressModeW  = WGPUAddressMode_ClampToEdge,
    magFilter     = WGPUFilterMode_Linear,
    minFilter     = WGPUFilterMode_Linear,
    mipmapFilter  = WGPUMipmapFilterMode_Nearest,
    lodMinClamp   = 0.0,
    lodMaxClamp   = 1.0,
    compare       = 0,
    maxAnisotropy = 1,
  }
  return wgpuDeviceCreateSampler(renderer.device, &desc)
end

global function nebula_text_load_ascii_font(out_font: *NebulaAsciiFontAtlas, renderer: *NebulaRenderer): boolean
  local pixels: *cuchar = nilptr
  local w: uint32 = 0
  local h: uint32 = 0
  if not nebula_text_read_pgm_gray8(NEBULA_ASCII_ATLAS_PATH, &pixels, &w, &h) then
    return false
  end

  local tex: WGPUTexture = nilptr
  local view: WGPUTextureView = nilptr
  local ok = nebula_upload_texture(
    &tex,
    &view,
    renderer,
    pixels,
    w,
    h,
    WGPUTextureFormat_R8Unorm,
    w,
    "nebula-ascii-atlas"
  )
  free(pixels)
  if not ok then
    return false
  end

  local sampler = nebula_text_create_sampler(renderer, "nebula-ascii-sampler")
  if sampler == nilptr then
    return false
  end

  $out_font = NebulaAsciiFontAtlas{
    texture = tex,
    view = view,
    sampler = sampler,
    width = w,
    height = h,
  }
  return true
end

global function nebula_text_mesh_upload(renderer: *NebulaRenderer, mesh: *NebulaTextMesh, data: pointer, size: csize, vertex_count: uint32, label: cstring): boolean
  if mesh.vertex_buffer ~= nilptr and mesh.vertex_buffer_size < (@uint64)(size) then
    wgpuBufferRelease(mesh.vertex_buffer)
    mesh.vertex_buffer = nilptr
    mesh.vertex_buffer_size = 0
  end
  if vertex_count == 0 or size == 0 then
    mesh.vertex_count = 0
    return true
  end
  if mesh.vertex_buffer == nilptr then
    if not nebula_create_vertex_buffer(&mesh.vertex_buffer, renderer, data, size, label) then
      return false
    end
    mesh.vertex_buffer_size = (@uint64)(size)
  else
    wgpuQueueWriteBuffer(renderer.queue, mesh.vertex_buffer, 0, data, size)
  end
  mesh.vertex_count = vertex_count
  return true
end

global function nebula_ascii_text_build_vertices(
  text: cstring,
  origin_x: float32,
  origin_y: float32,
  pixel_height: float32,
  out_vertices: *NebulaPosUvVertex,
  max_vertices: uint32,
  out_width: *float32,
  out_height: *float32
): uint32
  if text == nilptr then
    $out_width = 0.0
    $out_height = 0.0
    return 0
  end

  local scale = pixel_height / NEBULA_ASCII_PIXEL_HEIGHT
  local line_height = (NEBULA_ASCII_ASCENT - NEBULA_ASCII_DESCENT + NEBULA_ASCII_LINE_GAP) * scale
  local baseline_start = origin_y + NEBULA_ASCII_ASCENT * scale
  local pen_x = origin_x
  local baseline_y = baseline_start
  local min_x = origin_x
  local min_y = origin_y
  local max_x = origin_x
  local max_y = origin_y
  local saw_quad = false
  local vertex_count: uint32 = 0
  local i: csize = 0
  local text_len = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local verts_ptr = (@*[0]NebulaPosUvVertex)(out_vertices)

  while i < text_len and vertex_count + 6 <= max_vertices do
    local cp = (@cint)(text_bytes[i])
    if cp == 10 then
      pen_x = origin_x
      baseline_y = baseline_y + line_height
      if baseline_y > max_y then max_y = baseline_y end
      i = i + 1
    elseif cp == 13 then
      i = i + 1
    else
      local glyph: NebulaGeneratedAsciiGlyph
      if nebula_ascii_glyph_for_codepoint(cp, &glyph) then
        local x0 = pen_x + (@float32)(glyph.xoff) * scale
        local y0 = baseline_y + (@float32)(glyph.yoff) * scale
        local x1 = x0 + (@float32)(glyph.width) * scale
        local y1 = y0 + (@float32)(glyph.height) * scale

        if glyph.width > 0 and glyph.height > 0 then
          verts_ptr[vertex_count + 0] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y0 }, uv = Vec2{ x = glyph.u0, y = glyph.v0 } }
          verts_ptr[vertex_count + 1] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y0 }, uv = Vec2{ x = glyph.u1, y = glyph.v0 } }
          verts_ptr[vertex_count + 2] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y1 }, uv = Vec2{ x = glyph.u1, y = glyph.v1 } }
          verts_ptr[vertex_count + 3] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y0 }, uv = Vec2{ x = glyph.u0, y = glyph.v0 } }
          verts_ptr[vertex_count + 4] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y1 }, uv = Vec2{ x = glyph.u1, y = glyph.v1 } }
          verts_ptr[vertex_count + 5] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y1 }, uv = Vec2{ x = glyph.u0, y = glyph.v1 } }
          vertex_count = vertex_count + 6
          if not saw_quad then
            min_x = x0
            min_y = y0
            max_x = x1
            max_y = y1
            saw_quad = true
          else
            if x0 < min_x then min_x = x0 end
            if y0 < min_y then min_y = y0 end
            if x1 > max_x then max_x = x1 end
            if y1 > max_y then max_y = y1 end
          end
        end
        pen_x = pen_x + glyph.advance * scale
        if pen_x > max_x then max_x = pen_x end
      end
      i = i + 1
    end
  end

  if not saw_quad then
    max_y = origin_y + line_height
    min_y = origin_y
    max_x = pen_x
    min_x = origin_x
  end

  if max_x < min_x then max_x = min_x end
  if max_y < min_y then max_y = min_y end
  $out_width = max_x - min_x
  $out_height = max_y - min_y
  return vertex_count
end

-- =============================================================================
-- ★ Phase 3.6.2: nebula_text_compute_advances
--
-- 纯排版函数：计算文本中每个字符的累计 X 偏移（advance 数组）。
--
-- 设计哲学（公理 B）：
--   · 此函数不写入任何持久状态（L1），不依赖 Arena 分配。
--   · 调用方在栈上分配 [N+1]float32 临时数组，调用完毕即丢弃。
--   · out_advances[i] = 字符 i 的左边缘相对于文本起始点的 X 像素偏移
--   · out_advances[len] = 文本总宽度（末尾哨兵，用于最后一个字符的右边缘判定）
--
-- 参数：
--   text         : cstring   — 要排版的 C 字符串（UTF-8 ASCII 子集）
--   pixel_height : float32   — 目标像素高度（与渲染时一致）
--   out_advances : *float32  — 输出数组，调用方提供，长度 >= strlen(text)+1
--   max_chars    : uint32    — out_advances 的最大元素数（含末尾哨兵）
--
-- 返回：实际写入 out_advances 的有效字符数（不含末尾哨兵）
-- =============================================================================
global function nebula_text_compute_advances(
  text:         cstring,
  pixel_height: float32,
  out_advances: *[0]float32,
  max_chars:    uint32
): uint32
  if text == nilptr or max_chars == 0 then
    return 0
  end
  local scale = pixel_height / NEBULA_ASCII_PIXEL_HEIGHT
  local pen_x: float32 = 0.0
  local i: csize = 0
  local text_len = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local count: uint32 = 0

  while i < text_len and count + 1 < max_chars do
    out_advances[count] = pen_x
    local cp = (@cint)(text_bytes[i])
    -- 忽略换行符（单行输入框不处理多行）
    if cp ~= 10 and cp ~= 13 then
      local glyph: NebulaGeneratedAsciiGlyph
      if nebula_ascii_glyph_for_codepoint(cp, &glyph) then
        pen_x = pen_x + glyph.advance * scale
      end
    end
    count = count + 1
    i = i + 1
  end
  -- 末尾哨兵：文本总宽度（最后一个字符的右边缘）
  if count < max_chars then
    out_advances[count] = pen_x
  end
  return count
end

-- =============================================================================
-- ★ Phase 3.6.2: nebula_text_hit_test
--
-- 命中测试：将鼠标相对于文本起始点的 X 坐标映射到字符间隙索引（光标位置）。
--
-- 使用"过半判定"（Half-char Heuristic）：
--   · 如果 local_x 落在字符 i 的左半区，光标置于 i 之前（索引 i）
--   · 如果 local_x 落在字符 i 的右半区，光标置于 i 之后（索引 i+1）
--
-- 参数：
--   local_x    : float32  — 鼠标 X 坐标相对于文本起始点的偏移（像素）
--   advances   : *float32 — nebula_text_compute_advances 的输出数组（含末尾哨兵）
--   char_count : uint32   — 文本字符数（不含哨兵）
--
-- 返回：光标应插入的位置（0 = 最左，char_count = 最右）
-- =============================================================================
global function nebula_text_hit_test(
  local_x:    float32,
  advances:   *[0]float32,
  char_count: uint32
): uint32
  if char_count == 0 then return 0 end
  -- 鼠标在文本左侧
  if local_x <= 0.0 then return 0 end
  -- 线性扫描（N <= 255，O(N) 完全可接受）
  local i: uint32 = 0
  while i < char_count do
    local left  = advances[i]
    local right = advances[i + 1]
    local mid   = (left + right) * 0.5
    if local_x < mid then
      return i
    end
    i = i + 1
  end
  -- 鼠标在文本右侧
  return char_count
end

-- =============================================================================
-- ★ Phase 4.1: Slug 文本渲染运行时支持
--
-- 设计哲学（公理 A）：
--   · NebulaSlugVertex 是纯值类型，不持有任何 GPU 资源生命周期。
--   · nebula_slug_text_build_vertices 是纯函数：输入文本字符串 + 字形表，
--     输出顶点数组，不写入任何持久状态（L1）。
--   · GPU 上传由调用方（TextContext:set_text）负责，符合公理 B。
--
-- 顶点格式（64 bytes/vertex，4 x vec4<f32>）：
--   attr0: vec4<f32> — (pos_x, pos_y, glyph_x_min, glyph_y_min)
--   attr1: vec4<f32> — (glyph_x_max, glyph_y_max, curve_offset, curve_count)
--   attr2: vec4<f32> — (band_offset, band_count, ref_offset, scale)
--   attr3: vec4<f32> — (color_r, color_g, color_b, color_a)
--
-- 每个字形由 2 个三角形（6 个顶点）组成，覆盖字形的 AABB 包围盒。
-- 片段着色器通过 Slug 算法在包围盒内精确计算覆盖率。
-- =============================================================================

global NebulaSlugVertex = @record{
  attr0: Vec4,
  attr1: Vec4,
  attr2: Vec4,
  attr3: Vec4,
}

global function nebula_slug_text_build_vertices(
  text:         cstring,
  origin_x:     float32,
  origin_y:     float32,
  pixel_height: float32,
  color:        Color,
  glyphs:       *[0]NebulaSlugGlyph,
  out_vertices: *[0]NebulaSlugVertex,
  max_vertices: uint32,
  out_width:    *float32,
  out_height:   *float32
): uint32
  if text == nilptr then
    $out_width  = 0.0
    $out_height = 0.0
    return 0
  end

  local FONT_UNITS: float32 = (@float32)(NEBULA_SLUG_ASCENT - NEBULA_SLUG_DESCENT)
  local scale = pixel_height / FONT_UNITS
  local pen_x:        float32 = origin_x
  local vertex_count: uint32  = 0
  local text_len  = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local max_x: float32 = origin_x
  local line_height = pixel_height

  local i: csize = 0
  while i < text_len do
    local cp = (@cint)(text_bytes[i])

    if cp == 10 or cp == 13 then
      i = i + 1
      goto slug_next
    end

    if cp >= NEBULA_SLUG_FIRST_CODEPOINT and cp <= NEBULA_SLUG_LAST_CODEPOINT then
      local glyph_idx = cp - NEBULA_SLUG_FIRST_CODEPOINT
      local glyph = glyphs[glyph_idx]

      if glyph.curve_count > 0 and vertex_count + 6 <= max_vertices then
        local gx0 = pen_x + glyph.x_min * scale
        local gx1 = pen_x + glyph.x_max * scale
        local gy0 = origin_y - glyph.y_max * scale
        local gy1 = origin_y - glyph.y_min * scale

        local cf = (@float32)(glyph.curve_offset)
        local cc = (@float32)(glyph.curve_count)
        local bf = (@float32)(glyph.band_offset)
        local rf = (@float32)(glyph.ref_offset)

        -- 三角形 1
        out_vertices[vertex_count + 0] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx0, y=gy0, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        out_vertices[vertex_count + 1] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx1, y=gy0, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        out_vertices[vertex_count + 2] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx1, y=gy1, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        -- 三角形 2
        out_vertices[vertex_count + 3] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx0, y=gy0, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        out_vertices[vertex_count + 4] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx1, y=gy1, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        out_vertices[vertex_count + 5] = NebulaSlugVertex{
          attr0 = Vec4{ x=gx0, y=gy1, z=glyph.x_min*scale, w=glyph.y_min*scale },
          attr1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc },
          attr2 = Vec4{ x=bf, y=rf, z=scale, w=0.0 },
          attr3 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a },
        }
        vertex_count = vertex_count + 6
      end

      pen_x = pen_x + glyph.advance * scale
      if pen_x > max_x then max_x = pen_x end
    end

    ::slug_next::
    i = i + 1
  end

  $out_width  = max_x - origin_x
  $out_height = line_height
  return vertex_count
end
