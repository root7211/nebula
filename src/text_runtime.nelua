require "renderer"
require "liberation_sans_ascii_48_metrics"
require "liberation_sans_slug_metrics"  -- ★ BUG-7 修复：Slug 路径所需的 NebulaSlugGlyph 等符号
require "cjk_shaping_tables"            -- ★ Phase 4.2.3-S2: CJK shaping 表（GB2312 一级 3755 字）

## cinclude "<stdio.h>"
## cinclude "<string.h>"
## cinclude "<stdlib.h>"

global FILE: type <cimport,nodecl,forwarddecl> = @record{}
global function fopen(path: cstring, mode: cstring): *FILE <cimport, nodecl> end
global function fclose(fp: *FILE): cint <cimport, nodecl> end
global function fread(ptr: pointer, size: csize, count: csize, fp: *FILE): csize <cimport, nodecl> end
global function fscanf(fp: *FILE, fmt: cstring, ...: cvarargs): cint <cimport, nodecl> end
global function fgetc(fp: *FILE): cint <cimport, nodecl> end
global function malloc(size: csize): pointer <cimport, nodecl> end
global function free(ptr: pointer): void <cimport, nodecl> end
global function strlen(s: cstring): csize <cimport, nodecl> end

-- ★ MEM-2 fix: 模块级静态缓冲区替代 malloc/free，保持零堆设计一致性
-- 已知 atlas 最大尺寸为 1024x1024 = 1MB
local NEBULA_MAX_ATLAS_BYTES <comptime> = 1024 * 1024
local _atlas_pixel_buf: [NEBULA_MAX_ATLAS_BYTES]cuchar

global NebulaAsciiFontAtlas = @record{
  texture: WGPUTexture,
  view:    WGPUTextureView,
  sampler: WGPUSampler,
  width:   uint32,
  height:  uint32,
}

global NebulaTextMesh = @record{
  vertex_buffer:      WGPUBuffer,
  vertex_buffer_size: uint64,
  vertex_count:       uint32,
  width:              float32,
  height:             float32,
}

function NebulaTextMesh:init(): void
  self.vertex_buffer = nilptr
  self.vertex_buffer_size = 0
  self.vertex_count = 0
  self.width = 0.0
  self.height = 0.0
end

local function nebula_ascii_glyph_for_codepoint(cp: cint, out_glyph: *NebulaGeneratedAsciiGlyph): boolean
  local fallback = 63 -- '?'
  if cp < NEBULA_ASCII_FIRST_CODEPOINT or cp > NEBULA_ASCII_LAST_CODEPOINT then
    cp = fallback
  end
  local idx = cp - NEBULA_ASCII_FIRST_CODEPOINT
  if idx < 0 or idx >= NEBULA_ASCII_GLYPH_COUNT then
    return false
  end
  $out_glyph = NEBULA_ASCII_GLYPHS[idx]
  return true
end

local function nebula_text_read_pgm_gray8(path: cstring, out_pixels: **cuchar, out_w: *uint32, out_h: *uint32): boolean
  local fp = fopen(path, "rb")
  if fp == nilptr then
    printf("text: failed to open atlas %s\n", path)
    return false
  end

  local w: cint = 0
  local h: cint = 0
  local maxv: cint = 0
  -- 用 fgetc 逐字节读取避免 nelua 常量折叠
  local m0: cint = fgetc(fp)
  local m1: cint = fgetc(fp)
  if m0 < 0 or m1 < 0 then fclose(fp) return false end
  if m0 ~= (@cint)(80) or m1 ~= (@cint)(53) then  -- 'P'=80, '5'=53
    printf("text: unsupported atlas header in %s\n", path)
    fclose(fp)
    return false
  end
  if fscanf(fp, "%d %d %d", &w, &h, &maxv) ~= 3 then
    printf("text: failed to parse atlas header %s\n", path)
    fclose(fp)
    return false
  end
  if maxv ~= 255 then
    printf("text: unsupported atlas max value %d\n", maxv)
    fclose(fp)
    return false
  end
  if fgetc(fp) < 0 then
    fclose(fp)
    return false
  end

  local bytes = (@csize)(w * h)
  -- ★ MEM-2 fix: 使用模块级静态缓冲区替代 malloc，避免运行时堆分配
  if bytes > NEBULA_MAX_ATLAS_BYTES then
    printf("text: atlas too large (%d bytes, max %d) %s\n", bytes, NEBULA_MAX_ATLAS_BYTES, path)
    fclose(fp)
    return false
  end
  local pixels = &_atlas_pixel_buf[0]
  local nread = fread(pixels, 1, bytes, fp)
  fclose(fp)
  if nread ~= bytes then
    printf("text: atlas payload truncated %s\n", path)
    return false
  end

  $out_pixels = (@*cuchar)(pixels)
  $out_w = (@uint32)(w)
  $out_h = (@uint32)(h)
  return true
end

global function nebula_text_create_sampler(renderer: *NebulaRenderer, label: cstring): WGPUSampler
  local desc = WGPUSamplerDescriptor{
    nextInChain   = nilptr,
    label         = wgpu_str(label),
    addressModeU  = WGPUAddressMode_ClampToEdge,
    addressModeV  = WGPUAddressMode_ClampToEdge,
    addressModeW  = WGPUAddressMode_ClampToEdge,
    magFilter     = WGPUFilterMode_Linear,
    minFilter     = WGPUFilterMode_Linear,
    mipmapFilter  = WGPUMipmapFilterMode_Nearest,
    lodMinClamp   = 0.0,
    lodMaxClamp   = 1.0,
    compare       = 0,
    maxAnisotropy = 1,
  }
  return wgpuDeviceCreateSampler(renderer.device, &desc)
end

global function nebula_text_load_ascii_font(out_font: *NebulaAsciiFontAtlas, renderer: *NebulaRenderer): boolean
  local pixels: *cuchar = nilptr
  local w: uint32 = 0
  local h: uint32 = 0
  if not nebula_text_read_pgm_gray8(NEBULA_ASCII_ATLAS_PATH, &pixels, &w, &h) then
    return false
  end

  local tex: WGPUTexture = nilptr
  local view: WGPUTextureView = nilptr
  local ok = nebula_upload_texture(
    &tex,
    &view,
    renderer,
    pixels,
    w,
    h,
    WGPUTextureFormat_R8Unorm,
    w,
    "nebula-ascii-atlas"
  )
  -- ★ MEM-2 fix: 静态缓冲区无需 free，上传完成后缓冲区可被下次加载复用
  if not ok then
    return false
  end

  local sampler = nebula_text_create_sampler(renderer, "nebula-ascii-sampler")
  if sampler == nilptr then
    return false
  end

  $out_font = NebulaAsciiFontAtlas{
    texture = tex,
    view = view,
    sampler = sampler,
    width = w,
    height = h,
  }
  return true
end

global function nebula_text_mesh_upload(renderer: *NebulaRenderer, mesh: *NebulaTextMesh, data: pointer, size: csize, vertex_count: uint32, label: cstring): boolean
  if mesh.vertex_buffer ~= nilptr and mesh.vertex_buffer_size < (@uint64)(size) then
    wgpuBufferRelease(mesh.vertex_buffer)
    mesh.vertex_buffer = nilptr
    mesh.vertex_buffer_size = 0
  end
  if vertex_count == 0 or size == 0 then
    mesh.vertex_count = 0
    return true
  end
  if mesh.vertex_buffer == nilptr then
    if not nebula_create_vertex_buffer(&mesh.vertex_buffer, renderer, data, size, label) then
      return false
    end
    mesh.vertex_buffer_size = (@uint64)(size)
  else
    wgpuQueueWriteBuffer(renderer.queue, mesh.vertex_buffer, 0, data, size)
  end
  mesh.vertex_count = vertex_count
  return true
end

global function nebula_ascii_text_build_vertices(
  text: cstring,
  origin_x: float32,
  origin_y: float32,
  pixel_height: float32,
  out_vertices: *NebulaPosUvVertex,
  max_vertices: uint32,
  out_width: *float32,
  out_height: *float32
): uint32
  if text == nilptr then
    $out_width = 0.0
    $out_height = 0.0
    return 0
  end

  local scale = pixel_height / NEBULA_ASCII_PIXEL_HEIGHT
  local line_height = (NEBULA_ASCII_ASCENT - NEBULA_ASCII_DESCENT + NEBULA_ASCII_LINE_GAP) * scale
  local baseline_start = origin_y + NEBULA_ASCII_ASCENT * scale
  local pen_x = origin_x
  local baseline_y = baseline_start
  local min_x = origin_x
  local min_y = origin_y
  local max_x = origin_x
  local max_y = origin_y
  local saw_quad = false
  local vertex_count: uint32 = 0
  local i: csize = 0
  local text_len = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local verts_ptr = (@*[0]NebulaPosUvVertex)(out_vertices)

  while i < text_len and vertex_count + 6 <= max_vertices do
    local cp = (@cint)(text_bytes[i])
    if cp == 10 then
      pen_x = origin_x
      baseline_y = baseline_y + line_height
      if baseline_y > max_y then max_y = baseline_y end
      i = i + 1
    elseif cp == 13 then
      i = i + 1
    else
      local glyph: NebulaGeneratedAsciiGlyph
      if nebula_ascii_glyph_for_codepoint(cp, &glyph) then
        local x0 = pen_x + (@float32)(glyph.xoff) * scale
        local y0 = baseline_y + (@float32)(glyph.yoff) * scale
        local x1 = x0 + (@float32)(glyph.width) * scale
        local y1 = y0 + (@float32)(glyph.height) * scale

        if glyph.width > 0 and glyph.height > 0 then
          verts_ptr[vertex_count + 0] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y0 }, uv = Vec2{ x = glyph.u0, y = glyph.v0 } }
          verts_ptr[vertex_count + 1] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y0 }, uv = Vec2{ x = glyph.u1, y = glyph.v0 } }
          verts_ptr[vertex_count + 2] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y1 }, uv = Vec2{ x = glyph.u1, y = glyph.v1 } }
          verts_ptr[vertex_count + 3] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y0 }, uv = Vec2{ x = glyph.u0, y = glyph.v0 } }
          verts_ptr[vertex_count + 4] = NebulaPosUvVertex{ position = Vec2{ x = x1, y = y1 }, uv = Vec2{ x = glyph.u1, y = glyph.v1 } }
          verts_ptr[vertex_count + 5] = NebulaPosUvVertex{ position = Vec2{ x = x0, y = y1 }, uv = Vec2{ x = glyph.u0, y = glyph.v1 } }
          vertex_count = vertex_count + 6
          if not saw_quad then
            min_x = x0
            min_y = y0
            max_x = x1
            max_y = y1
            saw_quad = true
          else
            if x0 < min_x then min_x = x0 end
            if y0 < min_y then min_y = y0 end
            if x1 > max_x then max_x = x1 end
            if y1 > max_y then max_y = y1 end
          end
        end
        pen_x = pen_x + glyph.advance * scale
        if pen_x > max_x then max_x = pen_x end
      end
      i = i + 1
    end
  end

  if not saw_quad then
    max_y = origin_y + line_height
    min_y = origin_y
    max_x = pen_x
    min_x = origin_x
  end

  if max_x < min_x then max_x = min_x end
  if max_y < min_y then max_y = min_y end
  $out_width = max_x - min_x
  $out_height = max_y - min_y
  return vertex_count
end

-- =============================================================================
-- ★ Phase 3.6.2: nebula_text_compute_advances
--
-- 纯排版函数：计算文本中每个字符的累计 X 偏移（advance 数组）。
--
-- 设计哲学（公理 B）：
--   · 此函数不写入任何持久状态（L1），不依赖 Arena 分配。
--   · 调用方在栈上分配 [N+1]float32 临时数组，调用完毕即丢弃。
--   · out_advances[i] = 字符 i 的左边缘相对于文本起始点的 X 像素偏移
--   · out_advances[len] = 文本总宽度（末尾哨兵，用于最后一个字符的右边缘判定）
--
-- 参数：
--   text         : cstring   — 要排版的 C 字符串（UTF-8 ASCII 子集）
--   pixel_height : float32   — 目标像素高度（与渲染时一致）
--   out_advances : *float32  — 输出数组，调用方提供，长度 >= strlen(text)+1
--   max_chars    : uint32    — out_advances 的最大元素数（含末尾哨兵）
--
-- 返回：实际写入 out_advances 的有效字符数（不含末尾哨兵）
-- =============================================================================
global function nebula_text_compute_advances(
  text:         cstring,
  pixel_height: float32,
  out_advances: *[0]float32,
  max_chars:    uint32
): uint32
  if text == nilptr or max_chars == 0 then
    return 0
  end
  local scale = pixel_height / NEBULA_ASCII_PIXEL_HEIGHT
  local pen_x: float32 = 0.0
  local i: csize = 0
  local text_len = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local count: uint32 = 0

  while i < text_len and count + 1 < max_chars do
    out_advances[count] = pen_x
    local cp = (@cint)(text_bytes[i])
    -- 忽略换行符（单行输入框不处理多行）
    if cp ~= 10 and cp ~= 13 then
      local glyph: NebulaGeneratedAsciiGlyph
      if nebula_ascii_glyph_for_codepoint(cp, &glyph) then
        pen_x = pen_x + glyph.advance * scale
      end
    end
    count = count + 1
    i = i + 1
  end
  -- 末尾哨兵：文本总宽度（最后一个字符的右边缘）
  if count < max_chars then
    out_advances[count] = pen_x
  end
  return count
end

-- =============================================================================
-- ★ Phase 3.6.2: nebula_text_hit_test
--
-- 命中测试：将鼠标相对于文本起始点的 X 坐标映射到字符间隙索引（光标位置）。
--
-- 使用"过半判定"（Half-char Heuristic）：
--   · 如果 local_x 落在字符 i 的左半区，光标置于 i 之前（索引 i）
--   · 如果 local_x 落在字符 i 的右半区，光标置于 i 之后（索引 i+1）
--
-- 参数：
--   local_x    : float32  — 鼠标 X 坐标相对于文本起始点的偏移（像素）
--   advances   : *float32 — nebula_text_compute_advances 的输出数组（含末尾哨兵）
--   char_count : uint32   — 文本字符数（不含哨兵）
--
-- 返回：光标应插入的位置（0 = 最左，char_count = 最右）
-- =============================================================================
global function nebula_text_hit_test(
  local_x:    float32,
  advances:   *[0]float32,
  char_count: uint32
): uint32
  if char_count == 0 then return 0 end
  -- 鼠标在文本左侧
  if local_x <= 0.0 then return 0 end
  -- 线性扫描（N <= 255，O(N) 完全可接受）
  local i: uint32 = 0
  while i < char_count do
    local left  = advances[i]
    local right = advances[i + 1]
    local mid   = (left + right) * 0.5
    if local_x < mid then
      return i
    end
    i = i + 1
  end
  -- 鼠标在文本右侧
  return char_count
end

-- =============================================================================
-- ★ Phase 4.2.2: Slug 文本渲染运行时支持
--
-- 设计哲学（公理 A）：
--   · NebulaSlugVertex 是纯值类型，不持有任何 GPU 资源生命周期。
--   · nebula_slug_text_build_vertices 是纯函数：输入文本字符串 + 字形表，
--     输出顶点数组，不写入任何持久状态（L1）。
--   · GPU 上传由调用方（TextContext:set_text）负责，符合公理 B。
--
-- ★ Phase 4.2.2 D-4.1-B: 顶点格式升级为 80 bytes/vertex（5 x vec4<f32>）：
--   attr0: vec4<f32> — (pos_x, pos_y, glyph_x_min, glyph_y_min)
--   attr1: vec4<f32> — (glyph_x_max, glyph_y_max, curve_offset, curve_count)
--   attr2: vec4<f32> — (band_offset, h_band_count, v_band_count, scale)
--   attr3: vec4<f32> — (inv_scale_x, inv_scale_y, 0, 0) — Jacobian 逆矩阵
--   attr4: vec4<f32> — (color_r, color_g, color_b, color_a)
--
-- 每个字形由 2 个三角形（6 个顶点）组成，覆盖字形的 AABB 包围盒。
-- 片段着色器通过 Slug 算法在包围盒内精确计算覆盖率。
-- =============================================================================

global NebulaSlugVertex = @record{
  attr0: Vec4,
  attr1: Vec4,
  attr2: Vec4,
  attr3: Vec4,  -- ★ Phase 4.2.2: Jacobian inverse
  attr4: Vec4,  -- ★ Phase 4.2.2: color (was attr3)
}

global function nebula_slug_text_build_vertices(
  text:         cstring,
  origin_x:     float32,
  origin_y:     float32,
  pixel_height: float32,
  color:        Color,
  glyphs:       *[0]NebulaSlugGlyph,
  out_vertices: *[0]NebulaSlugVertex,
  max_vertices: uint32,
  out_width:    *float32,
  out_height:   *float32
): uint32
  if text == nilptr then
    $out_width  = 0.0
    $out_height = 0.0
    return 0
  end

  local FONT_UNITS: float32 = (@float32)(NEBULA_SLUG_ASCENT - NEBULA_SLUG_DESCENT)
  local scale = pixel_height / FONT_UNITS
  local pen_x:        float32 = origin_x
  local vertex_count: uint32  = 0
  local text_len  = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local max_x: float32 = origin_x
  local line_height = pixel_height

  -- ★ Phase 4.2.2 D-4.1-B: Jacobian 逆矩阵
  -- 对于正交投影 + 均匀缩放，inv_scale = 1.0 / scale
  local inv_scale: float32 = 1.0 / scale

  local i: csize = 0
  while i < text_len do
    local cp = (@cint)(text_bytes[i])

    if cp == 10 or cp == 13 then
      i = i + 1
      goto slug_next
    end

    if cp >= NEBULA_SLUG_FIRST_CODEPOINT and cp <= NEBULA_SLUG_LAST_CODEPOINT then
      local glyph_idx = cp - NEBULA_SLUG_FIRST_CODEPOINT
      local glyph = glyphs[glyph_idx]

      if glyph.curve_count > 0 and vertex_count + 6 <= max_vertices then
        local gx0 = pen_x + glyph.x_min * scale
        local gx1 = pen_x + glyph.x_max * scale
        local gy0 = origin_y - glyph.y_max * scale
        local gy1 = origin_y - glyph.y_min * scale

        local cf = (@float32)(glyph.curve_offset)
        local cc = (@float32)(glyph.curve_count)
        local bf = (@float32)(glyph.band_offset)
        -- ★ Phase 4.2.2: per-glyph band counts
        local hbc = (@float32)(glyph.h_band_count)
        local vbc = (@float32)(glyph.v_band_count)

        -- ★ Phase 4.2.2: 构建 5-attribute 顶点
        local a0_tl = Vec4{ x=gx0, y=gy0, z=glyph.x_min*scale, w=glyph.y_min*scale }
        local a0_tr = Vec4{ x=gx1, y=gy0, z=glyph.x_min*scale, w=glyph.y_min*scale }
        local a0_bl = Vec4{ x=gx0, y=gy1, z=glyph.x_min*scale, w=glyph.y_min*scale }
        local a0_br = Vec4{ x=gx1, y=gy1, z=glyph.x_min*scale, w=glyph.y_min*scale }
        local a1 = Vec4{ x=glyph.x_max*scale, y=glyph.y_max*scale, z=cf, w=cc }
        local a2 = Vec4{ x=bf, y=hbc, z=vbc, w=scale }
        local a3 = Vec4{ x=inv_scale, y=inv_scale, z=0.0, w=0.0 }  -- Jacobian inverse
        local a4 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a }

        -- 三角形 1
        out_vertices[vertex_count + 0] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        out_vertices[vertex_count + 1] = NebulaSlugVertex{ attr0=a0_tr, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        out_vertices[vertex_count + 2] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        -- 三角形 2
        out_vertices[vertex_count + 3] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        out_vertices[vertex_count + 4] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        out_vertices[vertex_count + 5] = NebulaSlugVertex{ attr0=a0_bl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
        vertex_count = vertex_count + 6
      end

      pen_x = pen_x + glyph.advance * scale
      if pen_x > max_x then max_x = pen_x end
    end

    ::slug_next::
    i = i + 1
  end

  $out_width  = max_x - origin_x
  $out_height = line_height
  return vertex_count
end

-- =============================================================================
-- ★ Phase 4.2.3-S2: CJK 运行时排版支持
--
-- 设计哲学（公理 A — 阶段封闭性）：
--   · S2 运行时零 HarfBuzz 依赖。所有排版操作通过查表完成。
--   · NEBULA_CJK_GLYPHS 和 NEBULA_CJK_CODEPOINTS 是 S0/S1 产物，
--     编译期常量，L0 永久层数据。
--   · 排版输出（advances 数组、顶点数组）为 L2 帧级数据。
--
-- 三个核心函数：
--   1. nebula_cjk_glyph_lookup — 码点→索引，O(log N) 二分查找
--   2. nebula_cjk_text_compute_advances — 纯查表排版，O(N)
--   3. nebula_cjk_slug_text_build_vertices — CJK Slug 顶点生成
-- =============================================================================

-- ★ Phase 4.2.3-S2 Task 2.3: 码点→CJK 字形索引二分查找
-- NEBULA_CJK_CODEPOINTS 已按升序排列，支持 O(log N) 查找。
-- 返回 -1 表示未找到（字体不覆盖该码点）。
global function nebula_cjk_glyph_lookup(codepoint: uint32): int32
  -- 使用独立的 NEBULA_CJK_CODEPOINTS 数组做二分查找（cache-friendly）
  local lo: int32 = 0
  local hi: int32 = NEBULA_CJK_GLYPH_COUNT - 1
  while lo <= hi do
    local mid = lo + ((hi - lo) >> 1)
    local mid_cp = NEBULA_CJK_CODEPOINTS[mid]
    if mid_cp == codepoint then
      return mid
    elseif mid_cp < codepoint then
      lo = mid + 1
    else
      hi = mid - 1
    end
  end
  return -1
end

-- ★ Phase 4.2.3-S2 Task 2.1: CJK 文本排版 — 纯查表 O(N)
-- 计算 UTF-8 CJK 文本中每个字符的累计 X 偏移。
-- 支持 ASCII + CJK 混排：ASCII 字符走已有的 ASCII 字形表，CJK 走 S1 表。
--
-- 参数：
--   text         : cstring   — UTF-8 编码文本
--   pixel_height : float32   — 目标像素高度
--   out_advances : *float32  — 输出数组，长度 >= 字符数+1
--   max_chars    : uint32    — out_advances 最大元素数（含末尾哨兵）
--
-- 返回：实际写入的有效字符数（不含哨兵）
global function nebula_cjk_text_compute_advances(
  text:         cstring,
  pixel_height: float32,
  out_advances: *[0]float32,
  max_chars:    uint32
): uint32
  if text == nilptr or max_chars == 0 then
    return 0
  end
  -- CJK: scale 基于 UPEM
  local cjk_scale = pixel_height / (@float32)(NEBULA_CJK_UPEM)
  -- ASCII: scale 基于 Slug font units
  local ascii_scale = pixel_height / (@float32)(NEBULA_SLUG_ASCENT - NEBULA_SLUG_DESCENT)
  local pen_x: float32 = 0.0
  local text_len = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local count: uint32 = 0
  local i: csize = 0

  while i < text_len and count + 1 < max_chars do
    out_advances[count] = pen_x
    local b0 = text_bytes[i]

    -- UTF-8 解码
    local codepoint: uint32 = 0
    local byte_len: csize = 1
    if b0 < 0x80 then
      codepoint = (@uint32)(b0)
    elseif b0 < 0xE0 and i + 1 < text_len then
      codepoint = ((@uint32)(b0 & 0x1F) << 6) | (@uint32)(text_bytes[i+1] & 0x3F)
      byte_len = 2
    elseif b0 < 0xF0 and i + 2 < text_len then
      codepoint = ((@uint32)(b0 & 0x0F) << 12) | ((@uint32)(text_bytes[i+1] & 0x3F) << 6) | (@uint32)(text_bytes[i+2] & 0x3F)
      byte_len = 3
    elseif i + 3 < text_len then
      codepoint = ((@uint32)(b0 & 0x07) << 18) | ((@uint32)(text_bytes[i+1] & 0x3F) << 12) | ((@uint32)(text_bytes[i+2] & 0x3F) << 6) | (@uint32)(text_bytes[i+3] & 0x3F)
      byte_len = 4
    end

    -- 跳过换行
    if codepoint ~= 10 and codepoint ~= 13 then
      -- 尝试 CJK 查表
      local cjk_idx = nebula_cjk_glyph_lookup(codepoint)
      if cjk_idx >= 0 then
        pen_x = pen_x + (@float32)(NEBULA_CJK_GLYPHS[cjk_idx].advance) * cjk_scale
      else
        -- Fallback 到 ASCII Slug 字形表
        local cp = (@cint)(codepoint)
        if cp >= NEBULA_SLUG_FIRST_CODEPOINT and cp <= NEBULA_SLUG_LAST_CODEPOINT then
          local glyph_idx = cp - NEBULA_SLUG_FIRST_CODEPOINT
          pen_x = pen_x + NEBULA_SLUG_GLYPHS[glyph_idx].advance * ascii_scale
        end
      end
    end

    count = count + 1
    i = i + byte_len
  end

  -- 末尾哨兵
  if count < max_chars then
    out_advances[count] = pen_x
  end
  return count
end

-- ★ Phase 4.2.3-S2 Task 2.2: CJK Slug 文本顶点生成
-- 支持 ASCII + CJK 混排，两种字符使用各自的 Slug 字形数据。
-- CJK 字形暂使用 shaping 表的边界框信息生成 placeholder 四边形，
-- 等待 CJK Slug 曲线数据（Phase 4.2.3 Step 1.4）生成后
-- 可直接替换为真正的 Slug band 渲染。
--
-- 当前策略：
--   · ASCII 字符：使用已有的 Slug 曲线数据（NebulaSlugGlyph），精确渲染
--   · CJK 字符：使用 shaping 表的 advance/bearing 生成填充矩形
--     （curve_count=0 的 placeholder，片段着色器会渲染为纯色块）
global function nebula_cjk_slug_text_build_vertices(
  text:         cstring,
  origin_x:     float32,
  origin_y:     float32,
  pixel_height: float32,
  color:        Color,
  slug_glyphs:  *[0]NebulaSlugGlyph,
  out_vertices: *[0]NebulaSlugVertex,
  max_vertices: uint32,
  out_width:    *float32,
  out_height:   *float32
): uint32
  if text == nilptr then
    $out_width  = 0.0
    $out_height = 0.0
    return 0
  end

  -- ASCII Slug 尺度
  local ASCII_FONT_UNITS: float32 = (@float32)(NEBULA_SLUG_ASCENT - NEBULA_SLUG_DESCENT)
  local ascii_scale = pixel_height / ASCII_FONT_UNITS
  -- CJK 尺度
  local cjk_scale = pixel_height / (@float32)(NEBULA_CJK_UPEM)

  local pen_x:        float32 = origin_x
  local vertex_count: uint32  = 0
  local text_len  = strlen(text)
  local text_bytes = (@*[0]uint8)(text)
  local max_x: float32 = origin_x
  local line_height = pixel_height

  -- Jacobian inverse（正交投影 + 均匀缩放）
  local ascii_inv_scale: float32 = 1.0 / ascii_scale
  local cjk_inv_scale: float32 = 1.0 / cjk_scale

  local i: csize = 0
  while i < text_len do
    local b0 = text_bytes[i]

    -- UTF-8 解码
    local codepoint: uint32 = 0
    local byte_len: csize = 1
    if b0 < 0x80 then
      codepoint = (@uint32)(b0)
    elseif b0 < 0xE0 and i + 1 < text_len then
      codepoint = ((@uint32)(b0 & 0x1F) << 6) | (@uint32)(text_bytes[i+1] & 0x3F)
      byte_len = 2
    elseif b0 < 0xF0 and i + 2 < text_len then
      codepoint = ((@uint32)(b0 & 0x0F) << 12) | ((@uint32)(text_bytes[i+1] & 0x3F) << 6) | (@uint32)(text_bytes[i+2] & 0x3F)
      byte_len = 3
    elseif i + 3 < text_len then
      codepoint = ((@uint32)(b0 & 0x07) << 18) | ((@uint32)(text_bytes[i+1] & 0x3F) << 12) | ((@uint32)(text_bytes[i+2] & 0x3F) << 6) | (@uint32)(text_bytes[i+3] & 0x3F)
      byte_len = 4
    end

    if codepoint == 10 or codepoint == 13 then
      i = i + byte_len
      goto cjk_slug_next
    end

    -- 尝试 CJK 路径
    do
      local cjk_idx = nebula_cjk_glyph_lookup(codepoint)
      if cjk_idx >= 0 then
        local cjk_g = &NEBULA_CJK_GLYPHS[cjk_idx]
        -- CJK placeholder：使用 bearing/size 生成填充矩形
        -- curve_count=0 告诉 Slug 着色器这是纯色块
        if vertex_count + 6 <= max_vertices then
          local gx0 = pen_x + (@float32)(cjk_g.x_bearing) * cjk_scale
          local gy0 = origin_y - (@float32)(cjk_g.y_bearing) * cjk_scale
          local gx1 = gx0 + (@float32)(cjk_g.width) * cjk_scale
          local gy1 = gy0 - (@float32)(cjk_g.height) * cjk_scale

          -- attr1.w = 0 (curve_count=0) signals solid fill to the fragment shader
          local a0_tl = Vec4{ x=gx0, y=gy0, z=0.0, w=0.0 }
          local a0_tr = Vec4{ x=gx1, y=gy0, z=0.0, w=0.0 }
          local a0_bl = Vec4{ x=gx0, y=gy1, z=0.0, w=0.0 }
          local a0_br = Vec4{ x=gx1, y=gy1, z=0.0, w=0.0 }
          local a1 = Vec4{ x=0.0, y=0.0, z=0.0, w=0.0 }  -- curve_offset=0, curve_count=0
          local a2 = Vec4{ x=0.0, y=0.0, z=0.0, w=cjk_scale }
          local a3 = Vec4{ x=cjk_inv_scale, y=cjk_inv_scale, z=0.0, w=0.0 }
          local a4 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a }

          out_vertices[vertex_count + 0] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 1] = NebulaSlugVertex{ attr0=a0_tr, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 2] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 3] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 4] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 5] = NebulaSlugVertex{ attr0=a0_bl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          vertex_count = vertex_count + 6
        end

        pen_x = pen_x + (@float32)(cjk_g.advance) * cjk_scale
        if pen_x > max_x then max_x = pen_x end
        i = i + byte_len
        goto cjk_slug_next
      end
    end

    -- Fallback: ASCII Slug 路径（复用已有逻辑）
    do
      local cp = (@cint)(codepoint)
      if cp >= NEBULA_SLUG_FIRST_CODEPOINT and cp <= NEBULA_SLUG_LAST_CODEPOINT then
        local glyph_idx = cp - NEBULA_SLUG_FIRST_CODEPOINT
        local glyph = slug_glyphs[glyph_idx]

        if glyph.curve_count > 0 and vertex_count + 6 <= max_vertices then
          local gx0 = pen_x + glyph.x_min * ascii_scale
          local gx1 = pen_x + glyph.x_max * ascii_scale
          local gy0 = origin_y - glyph.y_max * ascii_scale
          local gy1 = origin_y - glyph.y_min * ascii_scale

          local cf = (@float32)(glyph.curve_offset)
          local cc = (@float32)(glyph.curve_count)
          local bf = (@float32)(glyph.band_offset)
          local hbc = (@float32)(glyph.h_band_count)
          local vbc = (@float32)(glyph.v_band_count)

          local a0_tl = Vec4{ x=gx0, y=gy0, z=glyph.x_min*ascii_scale, w=glyph.y_min*ascii_scale }
          local a0_tr = Vec4{ x=gx1, y=gy0, z=glyph.x_min*ascii_scale, w=glyph.y_min*ascii_scale }
          local a0_bl = Vec4{ x=gx0, y=gy1, z=glyph.x_min*ascii_scale, w=glyph.y_min*ascii_scale }
          local a0_br = Vec4{ x=gx1, y=gy1, z=glyph.x_min*ascii_scale, w=glyph.y_min*ascii_scale }
          local a1 = Vec4{ x=glyph.x_max*ascii_scale, y=glyph.y_max*ascii_scale, z=cf, w=cc }
          local a2 = Vec4{ x=bf, y=hbc, z=vbc, w=ascii_scale }
          local a3 = Vec4{ x=ascii_inv_scale, y=ascii_inv_scale, z=0.0, w=0.0 }
          local a4 = Vec4{ x=color.r, y=color.g, z=color.b, w=color.a }

          out_vertices[vertex_count + 0] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 1] = NebulaSlugVertex{ attr0=a0_tr, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 2] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 3] = NebulaSlugVertex{ attr0=a0_tl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 4] = NebulaSlugVertex{ attr0=a0_br, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          out_vertices[vertex_count + 5] = NebulaSlugVertex{ attr0=a0_bl, attr1=a1, attr2=a2, attr3=a3, attr4=a4 }
          vertex_count = vertex_count + 6
        end

        pen_x = pen_x + glyph.advance * ascii_scale
        if pen_x > max_x then max_x = pen_x end
      end
    end

    ::cjk_slug_next::
    i = i + byte_len
  end

  $out_width  = max_x - origin_x
  $out_height = line_height
  return vertex_count
end

-- =============================================================================
-- Phase 4.X: 等宽网格辅助函数
--
-- 根据 (row, col, codepoint) + 网格参数填充一个 DenseCharInstance。
-- 从 NEBULA_ASCII_GLYPHS 查找 UV 坐标。纯辅助函数，不强制使用。
-- =============================================================================

--- 从 ASCII 码点查找字形在 atlas 中的 UV 坐标
--- 如果字符不在 [32, 126] 范围内，回退到 '?' (63)
global function nebula_dense_glyph_lookup(codepoint: uint32): NebulaGeneratedAsciiGlyph
  if codepoint >= (@uint32)(NEBULA_ASCII_FIRST_CODEPOINT) and
     codepoint <= (@uint32)(NEBULA_ASCII_LAST_CODEPOINT) then
    return NEBULA_ASCII_GLYPHS[codepoint - (@uint32)(NEBULA_ASCII_FIRST_CODEPOINT)]
  end
  -- fallback: '?' = codepoint 63
  return NEBULA_ASCII_GLYPHS[63 - (@uint32)(NEBULA_ASCII_FIRST_CODEPOINT)]
end

--- 填充一个 DenseCharInstance，用于等宽字符网格渲染
---
--- @param inst      输出指针
--- @param row       行号（从 0 开始）
--- @param col       列号（从 0 开始）
--- @param codepoint ASCII 码点 (32-126)
--- @param origin_x  网格左上角 X 像素偏移
--- @param origin_y  网格左上角 Y 像素偏移
--- @param cell_w    单元格宽度（像素）
--- @param cell_h    单元格高度（像素）
--- @param fg_packed RGBA8 packed 前景色
--- @param bg_packed RGBA8 packed 背景色
global function nebula_dense_grid_fill_instance(
  inst:      *DenseCharInstance,
  row:       uint32,
  col:       uint32,
  codepoint: uint32,
  origin_x:  float32,
  origin_y:  float32,
  cell_w:    float32,
  cell_h:    float32,
  fg_packed: uint32,
  bg_packed: uint32
): void
  local glyph = nebula_dense_glyph_lookup(codepoint)
  inst.pos_x    = origin_x + (@float32)(col) * cell_w
  inst.pos_y    = origin_y + (@float32)(row) * cell_h
  inst.uv_x     = glyph.u0
  inst.uv_y     = glyph.v0
  inst.uv_w     = glyph.u1 - glyph.u0
  inst.uv_h     = glyph.v1 - glyph.v0
  inst.fg_color = fg_packed
  inst.bg_color = bg_packed
end
