-- =============================================================================
-- app.nelua — Nebula GUI Compiler Phase 3.8 / Phase 3.10.5
--
-- 统一输入收集层 + 帧渲染封装
--   · nebula_input_install_callbacks(window) — 注册 GLFW 回调
--   · nebula_collect_input(window, input, dt) — 每帧输入快照
--   · ★ Phase 3.8: nebula_frame_render(renderer, app, input, dt, r, g, b)
--     泛型帧渲染函数，封装全部 WGPU 渲染样板（Surface/RenderPass/submit/present）
-- =============================================================================

## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula_core"
require "glfw_bindings"

-- =============================================================================
-- 内部全局事件队列（环形缓冲区，仅在 app.nelua 内部可见）
-- 回调函数写入，nebula_collect_input 读取并清空。
-- =============================================================================
global _nebula_char_queue:  [64]uint32   -- Unicode 码位队列
global _nebula_char_head:   uint8 = 0
global _nebula_char_tail:   uint8 = 0

global _nebula_key_queue:   [64]NebulaKey  -- 控制键队列（扩展至 64，支持快速按键重复）
global _nebula_key_head:    uint8 = 0
global _nebula_key_tail:    uint8 = 0

-- =============================================================================
-- ★ Phase 3.12: 内部全局：视口 Resize 状态
-- =============================================================================
global _nebula_viewport_w:       float32 = 0.0
global _nebula_viewport_h:       float32 = 0.0
global _nebula_viewport_resized: boolean = false

-- =============================================================================
-- GLFW 回调：鼠标滚动
-- =============================================================================
global _nebula_scroll_dy: float32 = 0.0

global function _nebula_scroll_callback(window: GLFWwindow, xoffset: float64, yoffset: float64): void
  _nebula_scroll_dy = _nebula_scroll_dy + (@float32)(yoffset)
end

-- =============================================================================
-- ★ Phase 3.12: GLFW 回调： Framebuffer Resize
-- 由 GLFW 在窗口尺寸变化时自动调用。
-- 写入全局状态，由 nebula_collect_input 在下一帧读取。
-- =============================================================================
global function _nebula_framebuffer_size_callback(window: GLFWwindow, width: int32, height: int32): void
  _nebula_viewport_w       = (@float32)(width)
  _nebula_viewport_h       = (@float32)(height)
  _nebula_viewport_resized = true
end

-- =============================================================================
-- GLFW 回调：字符输入（Unicode 可打印字符）
-- =============================================================================
global function _nebula_char_callback(window: GLFWwindow, codepoint: uint32): void
  local next = (_nebula_char_tail + 1) % 64
  if next ~= _nebula_char_head then  -- 队列未满
    _nebula_char_queue[_nebula_char_tail] = codepoint
    _nebula_char_tail = next
  end
end

-- =============================================================================
-- GLFW 回调：控制键（Backspace / Delete / Enter / Tab / 方向键 / Home / End）
--
-- ★ Phase 3.6.3: 识别 Shift+方向键/Home/End，映射为 ShiftLeft/ShiftRight/
--   ShiftHome/ShiftEnd 变体，供选区扩展交互原语使用。
-- =============================================================================
global function _nebula_key_callback(
  window:   GLFWwindow,
  key:      int32,
  scancode: int32,
  action:   int32,
  mods:     int32
): void
  -- 只处理按下和重复（不处理释放）
  if action == GLFW_RELEASE then return end

  local nk: NebulaKey = NebulaKey.None
  -- ★ Phase 3.6.3: 在回调中直接读取 mods 判断 Shift，避免额外的全局状态
  local shift_down = (mods & GLFW_MOD_SHIFT) ~= 0
  local ctrl_down  = (mods & GLFW_MOD_CONTROL) ~= 0

  -- ★ Phase 4.X: Ctrl 组合键优先（剪贴板 + 全选）
  if ctrl_down then
    if     key == GLFW_KEY_C then nk = NebulaKey.Copy      -- Ctrl+C
    elseif key == GLFW_KEY_V then nk = NebulaKey.Paste     -- Ctrl+V
    elseif key == GLFW_KEY_X then nk = NebulaKey.Cut       -- Ctrl+X
    elseif key == GLFW_KEY_A then nk = NebulaKey.SelectAll -- Ctrl+A
    -- ★ Phase 4.7-S5: Undo/Redo
    elseif key == GLFW_KEY_Z then                          -- Ctrl+Z
      if shift_down then
        nk = NebulaKey.Redo                                -- Ctrl+Shift+Z = Redo
      else
        nk = NebulaKey.Undo                                -- Ctrl+Z = Undo
      end
    elseif key == GLFW_KEY_Y then nk = NebulaKey.Redo      -- Ctrl+Y
    -- ★ Phase 4.7-S7: Save
    elseif key == GLFW_KEY_S then nk = NebulaKey.Save      -- Ctrl+S
    -- ★ Phase 4.8-S2: Find / Replace
    elseif key == GLFW_KEY_F then nk = NebulaKey.Find      -- Ctrl+F
    elseif key == GLFW_KEY_H then nk = NebulaKey.Replace   -- Ctrl+H
    end
  end

  if nk == NebulaKey.None then
  if     key == GLFW_KEY_BACKSPACE then nk = NebulaKey.Backspace
  elseif key == GLFW_KEY_DELETE    then nk = NebulaKey.Delete
  elseif key == GLFW_KEY_ENTER     then nk = NebulaKey.Enter
  elseif key == GLFW_KEY_KP_ENTER  then nk = NebulaKey.Enter
  elseif key == GLFW_KEY_TAB       then nk = shift_down and NebulaKey.ShiftTab or NebulaKey.Tab
  elseif key == GLFW_KEY_ESCAPE    then nk = NebulaKey.Escape
  -- ★ Phase 3.6.3: Shift 组合键变体——选区扩展
  elseif key == GLFW_KEY_LEFT  then nk = shift_down and NebulaKey.ShiftLeft  or NebulaKey.Left
  elseif key == GLFW_KEY_RIGHT then nk = shift_down and NebulaKey.ShiftRight or NebulaKey.Right
  elseif key == GLFW_KEY_HOME  then nk = shift_down and NebulaKey.ShiftHome  or NebulaKey.Home
  elseif key == GLFW_KEY_END   then nk = shift_down and NebulaKey.ShiftEnd   or NebulaKey.End
  -- ★ Phase 4.4 S3: Up/Down arrow keys (multiline editing)
  elseif key == GLFW_KEY_UP    then nk = shift_down and NebulaKey.ShiftUp    or NebulaKey.Up
  elseif key == GLFW_KEY_DOWN  then nk = shift_down and NebulaKey.ShiftDown  or NebulaKey.Down
  -- ★ Phase 4.8-S2: F3 = FindNext (non-ctrl key)
  elseif key == GLFW_KEY_F3    then nk = NebulaKey.FindNext  -- F3
  end
  end -- close: if nk == NebulaKey.None

  if nk ~= NebulaKey.None then
    local next = (_nebula_key_tail + 1) % 64
    if next ~= _nebula_key_head then
      _nebula_key_queue[_nebula_key_tail] = nk
      _nebula_key_tail = next
    end
  end
end

-- =============================================================================
-- nebula_input_install_callbacks(window)
--
-- 在主循环开始前调用一次，将上述两个回调注册到 GLFW 窗口。
-- =============================================================================
global function nebula_input_install_callbacks(window: GLFWwindow): void
  glfwSetCharCallback(window, _nebula_char_callback)
  glfwSetKeyCallback(window,  _nebula_key_callback)
  glfwSetScrollCallback(window, _nebula_scroll_callback)
  -- ★ Phase 3.12: 注册 framebuffer resize 回调
  glfwSetFramebufferSizeCallback(window, _nebula_framebuffer_size_callback)
end

-- nebula_collect_input: 每帧输入快照
-- 读取鼠标/字符队列/控制键队列/修饰键状态，写入 *NebulaInputState。
global function nebula_collect_input(
  window:  GLFWwindow,
  input:   *NebulaInputState,
  dt:      float32
): void
  -- ---- 鼠标 ----
  local mx_f64: float64 = 0.0
  local my_f64: float64 = 0.0
  glfwGetCursorPos(window, &mx_f64, &my_f64)
  input.mouse_x = (@float32)(mx_f64)
  input.mouse_y = (@float32)(my_f64)

  local prev_down = input.mouse_left_down
  local cur_down  = (glfwGetMouseButton(window, GLFW_MOUSE_BUTTON_LEFT) == GLFW_PRESS)
  input.mouse_left_down     = cur_down
  input.mouse_left_pressed  = (cur_down and not prev_down)
  input.mouse_left_released = (not cur_down and prev_down)

  -- ---- 字符输入：从队列提取到 input.char_input ----
  input.char_count = 0
  while _nebula_char_head ~= _nebula_char_tail and input.char_count < 64 do
    input.char_input[input.char_count] = _nebula_char_queue[_nebula_char_head]
    input.char_count = input.char_count + 1
    _nebula_char_head = (_nebula_char_head + 1) % 64
  end

  -- ---- 控制键：每帧取一个（FIFO，支持按键重复） ----
  if _nebula_key_head ~= _nebula_key_tail then
    input.key_pressed = _nebula_key_queue[_nebula_key_head]
    _nebula_key_head = (_nebula_key_head + 1) % 64
  else
    input.key_pressed = NebulaKey.None
  end

  -- ---- 滚动 ----
  input.scroll_dy = _nebula_scroll_dy
  _nebula_scroll_dy = 0.0

  -- ---- ★ Phase 3.6.3: 修饰键实时采样（非队列化，直接读取 GLFW 键状态） ----
  -- 每帧直接采样而非通过回调队列，确保修饰键状态与当前帧的鼠标/键盘事件严格同步
  input.mod_shift = (glfwGetKey(window, GLFW_KEY_LEFT_SHIFT)   == GLFW_PRESS) or
                   (glfwGetKey(window, GLFW_KEY_RIGHT_SHIFT)  == GLFW_PRESS)
  input.mod_ctrl  = (glfwGetKey(window, GLFW_KEY_LEFT_CONTROL) == GLFW_PRESS) or
                   (glfwGetKey(window, GLFW_KEY_RIGHT_CONTROL) == GLFW_PRESS)
  input.mod_alt   = (glfwGetKey(window, GLFW_KEY_LEFT_ALT)     == GLFW_PRESS) or
                   (glfwGetKey(window, GLFW_KEY_RIGHT_ALT)    == GLFW_PRESS)

  -- ---- ★ Phase 3.12: 视口尺寸状态（响应式重排） ----
  -- 从全局回调状态读取 resize 事件，读取后清除标志位（每帧只触发一次）
  input.viewport_resized = _nebula_viewport_resized
  if _nebula_viewport_resized then
    input.viewport_w = _nebula_viewport_w
    input.viewport_h = _nebula_viewport_h
    _nebula_viewport_resized = false  -- 清除标志位，下一帧不再触发
  end
end

-- ★ Phase 3.11: nebula_init / nebula_should_close / nebula_shutdown
-- 便利性封装：消除 main() 中的 GLFW/WGPU 样板代码，兑现 30 行愿景。
--
-- 使用方式：
--   local renderer: NebulaRenderer
--   local app:      MyApp
--   if not nebula_init(&renderer, &app, "My Window", 800, 600) then return 1 end
--   while not nebula_should_close() do
--     nebula_frame_render(&renderer, &app, ...)
--   end
--   nebula_shutdown(&renderer)
--   return 0

-- 内部全局：当前窗口句柄（由 nebula_init 设置，nebula_should_close 使用）
global _nebula_window: GLFWwindow = nilptr

-- nebula_init: 封装 GLFW 初始化、窗口创建、回调注册、渲染器初始化、App 初始化
-- 泛型参数 app 必须实现 :init(renderer, vw, vh) 方法（由 nebula_derive_app 自动生成）
global function nebula_init(
  renderer:    *NebulaRenderer,
  app:         auto,
  title:       cstring,
  win_w:       int32,
  win_h:       int32
): boolean
  if glfwInit() == 0 then
    return false
  end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  -- ★ Phase 3.12: 开启窗口可调整大小，支持响应式重排
  glfwWindowHint(GLFW_RESIZABLE, GLFW_TRUE)
  _nebula_window = glfwCreateWindow(win_w, win_h, title, nilptr, nilptr)
  if _nebula_window == nilptr then
    glfwTerminate()
    return false
  end
  nebula_input_install_callbacks(_nebula_window)
  -- ★ Phase 3.12: 初始化视口全局状态
  _nebula_viewport_w = (@float32)(win_w)
  _nebula_viewport_h = (@float32)(win_h)
  _nebula_viewport_resized = false
  if not renderer:init(_nebula_window, (@float32)(win_w), (@float32)(win_h)) then
    glfwDestroyWindow(_nebula_window)
    glfwTerminate()
    return false
  end
  if not app:init(renderer, (@float32)(win_w), (@float32)(win_h)) then
    nebula_shutdown(renderer)
    glfwDestroyWindow(_nebula_window)
    glfwTerminate()
    return false
  end
  return true
end

-- nebula_should_close: 封装 glfwWindowShouldClose，作为主循环条件
global function nebula_should_close(): boolean
  return glfwWindowShouldClose(_nebula_window) ~= 0
end

-- nebula_poll_events: 封装 glfwPollEvents（可选，也可直接调用 glfwPollEvents）
global function nebula_poll_events(): void
  glfwPollEvents()
end

-- nebula_shutdown: 封装 WGPU/GLFW 资源释放
global function nebula_shutdown(renderer: *NebulaRenderer): void
  wgpuQueueRelease(renderer.queue)
  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(_nebula_window)
  glfwTerminate()
end

-- ★ Phase 4.5-S3: nebula_frame_begin
-- 帧循环整合：poll_events + dt 计算 + input 收集，省去 ~5 行样板。
-- 性能：1 次函数调用 + 4 次赋值 ≈ ~5ns/frame（帧预算 16.6ms 的 0.00003%）。
global _nebula_prev_time: float64 = 0.0

global function nebula_frame_begin(input: *NebulaInputState): float32
  nebula_poll_events()
  local now = glfwGetTime()
  local dt = (@float32)(now - _nebula_prev_time)
  _nebula_prev_time = now
  nebula_collect_input(_nebula_window, input, dt)
  return dt
end

-- ★ Phase 3.8: nebula_frame_render
-- 泛型帧渲染函数：Surface 获取 → RenderPass 创建 → app:update+draw → submit+present
-- 公理 C（形即渲染）：渲染循环不持有帧间状态；泛型展开后等价于手写静态代码。
require "wgpu_bindings"
require "renderer"

-- ★ P1-8 refactor: Surface 重配置共享函数
-- 从 nebula_frame_render 和 nebula_frame_render_multipass 提取。
global function _nebula_reconfigure_surface(renderer: *NebulaRenderer, input: *NebulaInputState): void
  if input.viewport_resized then
    local new_w = (@uint32)(input.viewport_w)
    local new_h = (@uint32)(input.viewport_h)
    if new_w > 0 and new_h > 0 then
      renderer.width  = new_w
      renderer.height = new_h
      local surf_cfg = WGPUSurfaceConfiguration{
        nextInChain     = nilptr,
        device          = renderer.device,
        format          = renderer.format,
        usage           = 0x00000010, -- WGPUTextureUsage_RenderAttachment
        width           = new_w,
        height          = new_h,
        viewFormatCount = 0,
        viewFormats     = nilptr,
        alphaMode       = #[NEBULA_TARGET ~= 'wasm' and 1 or 0]#, -- Auto: 1=native, 0=WASM/Emscripten
        presentMode     = WGPUPresentMode_Fifo,
      }
      wgpuSurfaceConfigure(renderer.surface, &surf_cfg)
    end
  end
end

global function nebula_frame_render(
  renderer:  *NebulaRenderer,
  app:       auto,
  input:     *NebulaInputState,
  dt:        float32,
  clear_r:   float64,
  clear_g:   float64,
  clear_b:   float64
): void
  -- 0. Surface 重配置
  _nebula_reconfigure_surface(renderer, input)

  -- 1. 获取 Surface 当前纹理
  local surface_tex: WGPUSurfaceTexture
  wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
  local status = surface_tex.status
  if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
     status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal and
     status ~= WGPUSurfaceGetCurrentTextureStatus_Success then
    return  -- 跳帧：Surface 暂时不可用（最小化、resize 等）
  end

  -- 2. 创建 TextureView
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str_null(),
    format          = renderer.format,
    dimension       = 2,
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = WGPUTextureAspect_All,
  }
  local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

  -- 3. 创建 CommandEncoder 和 RenderPass
  local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)
## if NEBULA_TARGET ~= 'wasm' then
  local clear_color = WGPURenderPassColorAttachment{
    nextInChain   = nilptr,
    view          = view,
    depthSlice    = 0xFFFFFFFF,
    resolveTarget = nilptr,
    loadOp        = WGPULoadOp_Clear,
    storeOp       = WGPUStoreOp_Store,
    clearValue    = WGPUColor{ r = clear_r, g = clear_g, b = clear_b, a = 1.0 },
  }
## else
  local clear_color = WGPURenderPassColorAttachment{
    view          = view,
    depthSlice    = 0xFFFFFFFF,
    resolveTarget = nilptr,
    loadOp        = WGPULoadOp_Clear,
    storeOp       = WGPUStoreOp_Store,
    clearValue    = WGPUColor{ r = clear_r, g = clear_g, b = clear_b, a = 1.0 },
  }
## end
  local pass_desc = WGPURenderPassDescriptor{
    nextInChain             = nilptr,
    label                   = wgpu_str_null(),
    colorAttachmentCount    = 1,
    colorAttachments        = &clear_color,
    depthStencilAttachment  = nilptr,
    occlusionQuerySet       = nilptr,
    timestampWrites         = nilptr,
  }
  local pass = wgpuCommandEncoderBeginRenderPass(encoder, &pass_desc)

  -- 4. App Update + Draw（泛型展开，零虚函数开销）
  app:update(input, dt)
  app:draw(pass)

  -- 5. 结束 RenderPass，提交并呈现
  wgpuRenderPassEncoderEnd(pass)
  wgpuRenderPassEncoderRelease(pass)

  local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
  wgpuCommandEncoderRelease(encoder)
  wgpuQueueSubmit(renderer.queue, 1, &cmd)
  wgpuCommandBufferRelease(cmd)

## if NEBULA_TARGET ~= 'wasm' then
  wgpuSurfacePresent(renderer.surface)
## end
  wgpuTextureViewRelease(view)
  wgpuTextureRelease(surface_tex.texture)
end

-- ★ Phase 3.10.5: nebula_frame_render_multipass
-- 多 Pass 帧渲染函数：Surface 获取 → 阴影离屏 Pass → Surface 主 Pass → submit+present
--
-- 公理 C（形即渲染）：泛型展开后等价于手写静态代码。
-- 与 nebula_frame_render 的区别：
--   · app 需要实现 draw_pre_pass(encoder, renderer) 方法（在 Surface Pass 前执行离屏渲染）
--   · app 需要实现 draw_surface_pass(pass) 方法（在 Surface Pass 中执行合成+主体绘制）
--   · 这两个方法由 app_factory.lua 中的 nebula_app_register_shadow 自动生成
global function nebula_frame_render_multipass(
  renderer:  *NebulaRenderer,
  app:       auto,
  input:     *NebulaInputState,
  dt:        float32,
  clear_r:   float64,
  clear_g:   float64,
  clear_b:   float64
): void
  -- 0. Surface 重配置
  _nebula_reconfigure_surface(renderer, input)

  -- 1. 获取 Surface 当前纹理
  local surface_tex: WGPUSurfaceTexture
  wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
  local status = surface_tex.status
  if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
     status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal and
     status ~= WGPUSurfaceGetCurrentTextureStatus_Success then
    return  -- 跳帧：Surface 暂时不可用
  end

  -- 2. 创建 TextureView
  local view_desc = WGPUTextureViewDescriptor{
    nextInChain     = nilptr,
    label           = wgpu_str_null(),
    format          = renderer.format,
    dimension       = 2,
    baseMipLevel    = 0,
    mipLevelCount   = 1,
    baseArrayLayer  = 0,
    arrayLayerCount = 1,
    aspect          = WGPUTextureAspect_All,
  }
  local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

  -- 3. App Update
  app:update(input, dt)

  -- 4. 创建 CommandEncoder
  local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)

  -- 5. ★ Phase 3.10.5: 执行阴影离屏 Pass（Pass 1-3）
  --    app:draw_pre_pass 由 app_factory 自动生成，封装所有阴影组件的 draw_shadow 调用
  app:draw_pre_pass(encoder, renderer)

  -- 6. Surface 主 Pass（Pass 4）
## if NEBULA_TARGET ~= 'wasm' then
  local clear_color = WGPURenderPassColorAttachment{
    nextInChain   = nilptr,
    view          = view,
    depthSlice    = 0xFFFFFFFF,
    resolveTarget = nilptr,
    loadOp        = WGPULoadOp_Clear,
    storeOp       = WGPUStoreOp_Store,
    clearValue    = WGPUColor{ r = clear_r, g = clear_g, b = clear_b, a = 1.0 },
  }
## else
  local clear_color = WGPURenderPassColorAttachment{
    view          = view,
    depthSlice    = 0xFFFFFFFF,
    resolveTarget = nilptr,
    loadOp        = WGPULoadOp_Clear,
    storeOp       = WGPUStoreOp_Store,
    clearValue    = WGPUColor{ r = clear_r, g = clear_g, b = clear_b, a = 1.0 },
  }
## end
  local pass_desc = WGPURenderPassDescriptor{
    nextInChain             = nilptr,
    label                   = wgpu_str_null(),
    colorAttachmentCount    = 1,
    colorAttachments        = &clear_color,
    depthStencilAttachment  = nilptr,
    occlusionQuerySet       = nilptr,
    timestampWrites         = nilptr,
  }
  local pass = wgpuCommandEncoderBeginRenderPass(encoder, &pass_desc)

  -- 7. ★ Phase 3.10.5: 在 Surface Pass 中先合成阴影，再绘制主体
  --    app:draw_surface_pass 由 app_factory 自动生成，封装 draw_composite + draw 调用
  app:draw_surface_pass(pass)

  -- 8. 结束 RenderPass，提交并呈现
  wgpuRenderPassEncoderEnd(pass)
  wgpuRenderPassEncoderRelease(pass)

  local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
  wgpuCommandEncoderRelease(encoder)
  wgpuQueueSubmit(renderer.queue, 1, &cmd)
  wgpuCommandBufferRelease(cmd)

## if NEBULA_TARGET ~= 'wasm' then
  wgpuSurfacePresent(renderer.surface)
## end
  wgpuTextureViewRelease(view)
  wgpuTextureRelease(surface_tex.texture)
end

-- =============================================================================
-- ★ Phase 4.9 L4: 框架内建辅助函数
-- =============================================================================

-- ★ P1-2 refactor: 编辑器功能已提取到 nebula_editor.nelua
-- 编辑器 builtin（status_bar / search_bar / edit_area）和 nebula_editor_main()
-- 在编译期被调用时会自动 require "nebula_editor"，非编辑器应用不会加载。

-- =============================================================================
-- ★ Phase 4.2.1: nebula_main_loop — 跨平台主循环宏
--
-- 封装 Native（阻塞式 while）与 Web（emscripten_set_main_loop 回调式）的
-- 循环结构差异，使 examples/*.nelua 的主循环收缩为单行宏调用。
--
-- 公理 A 合规：Native/Web 分支在 S1 阶段消解，生成代码中不存在运行时分支。
--
-- 使用方式（替代原来的 while not nebula_should_close() do ... end）：
--
--   -- 声明 input 和 prev_time（仍在应用层，保持透明性）
--   local input: NebulaInputState
--   local prev_time = glfwGetTime()
--   nebula_main_loop(&renderer, &form, &input, prev_time, 0.09, 0.09, 0.10)
--   nebula_shutdown(&renderer)
--
-- 参数说明：
--   renderer_ptr  — *NebulaRenderer
--   app_ptr       — *AppType（auto 泛型）
--   input_ptr     — *NebulaInputState
--   prev_time_ptr — *float64（帧间时间戳，由调用方声明并传入）
--   clear_r/g/b   — float64，背景清除色
--
-- 注意：宏不封装业务逻辑（如 Enter 键打印表单内容），业务逻辑仍保留在应用层。
-- 如需在帧循环中插入业务逻辑，请继续使用手写 while 循环，或等待 Phase 4.3
-- 的可编程帧钩子（frame hook）机制。
-- =============================================================================

## if NEBULA_TARGET == 'wasm' then
-- Web 端：全局帧状态（Emscripten 回调无法捕获局部变量）
global _nebula_ml_renderer:  *NebulaRenderer = nilptr
global _nebula_ml_input:     *NebulaInputState = nilptr
global _nebula_ml_prev_time: float64 = 0.0
global _nebula_ml_clear_r:   float64 = 0.0
global _nebula_ml_clear_g:   float64 = 0.0
global _nebula_ml_clear_b:   float64 = 0.0
## end

-- =============================================================================
-- nebula_main_loop: 跨平台主循环宏
--
-- ★ WASM 修正: 帧回调函数不再预定义为全局函数（旧方案导致类型擦除错误）。
-- 现在由宏在调用处生成类型化的回调函数，保证 nebula_frame_render 的泛型
-- 参数 `app: auto` 能正确推导出具体的 App 类型。
-- =============================================================================
## function nebula_main_loop(renderer_ptr, app_ptr, input_ptr, prev_time_ptr, cr, cg, cb)
  ## if NEBULA_TARGET == 'wasm' then
  -- Web: 生成类型化帧回调（捕获调用处的具体 App 类型）
  _nebula_ml_renderer  = #[renderer_ptr]#
  _nebula_ml_input     = #[input_ptr]#
  _nebula_ml_prev_time = $#[prev_time_ptr]#
  _nebula_ml_clear_r   = #[cr]#
  _nebula_ml_clear_g   = #[cg]#
  _nebula_ml_clear_b   = #[cb]#
  -- ★ 类型化帧回调：app 指针类型在宏展开时已确定，无类型擦除
  global function _nebula_wasm_frame(): void
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - _nebula_ml_prev_time)
    _nebula_ml_prev_time = now
    nebula_collect_input(_nebula_window, _nebula_ml_input, dt)
    nebula_frame_render(_nebula_ml_renderer, #[app_ptr]#, _nebula_ml_input, dt,
      _nebula_ml_clear_r, _nebula_ml_clear_g, _nebula_ml_clear_b)
  end
  emscripten_set_main_loop(_nebula_wasm_frame, 0, 1)
  -- ★ emscripten_set_main_loop with simulate_infinite_loop=1 不会返回
  #[app_ptr]#:deinit()
  ## else
  -- Native: 传统阻塞循环
  while not nebula_should_close() do
    glfwPollEvents()
    local _now = glfwGetTime()
    local _dt  = (@float32)(_now - $#[prev_time_ptr]#)
    $#[prev_time_ptr]# = _now
    nebula_collect_input(_nebula_window, #[input_ptr]#, _dt)
    nebula_frame_render(#[renderer_ptr]#, #[app_ptr]#, #[input_ptr]#, _dt,
      #[cr]#, #[cg]#, #[cb]#)
  end
  -- ★ Phase 4.2.2-fix: 循环退出后自动释放 App GPU 资源（公理 B）
  #[app_ptr]#:deinit()
  ## end
## end
