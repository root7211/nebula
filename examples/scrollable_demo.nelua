-- =============================================================================
-- scrollable_demo.nelua
-- Nebula GUI Compiler — Phase 4.4 S1
--
-- ★ Scrollable 容器组件 demo
--   · 注册 "scrollable" 自定义原语（依赖 hoverable）
--   · 滚轮 + 滚动条拖拽双重交互
--   · Scissor rect 裁剪（超出容器的子元素不可见）
--   · 手动渲染循环（不走 nebula_frame_render，因为需要在 draw 前设置 scissor）
--
-- 验证点：
--   1. register_primitive API 在容器场景下的组合能力
--   2. scroll_dy 输入字段的端到端链路
--   3. Scissor rect 裁剪正确性
--   4. 多子元素 + 滚动偏移的渲染正确性
-- =============================================================================
## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- ★ Register custom "scrollable" primitive (before nebula_annotate)
-- =============================================================================
##[[
-- scrollable 原语：管理可滚动容器的状态
-- 依赖 hoverable（需要 hovered 状态来决定是否响应滚轮）
-- 状态字段：
--   scroll_offset_y  : 当前 Y 轴滚动偏移（像素）
--   max_scroll       : 最大可滚动距离（content_height - view_height）
--   is_dragging_bar  : 是否正在拖拽滚动条
--   drag_start_y     : 拖拽开始时的鼠标 Y
--   drag_start_offset: 拖拽开始时的 scroll_offset_y
nebula_register_primitive("scrollable", {
  dependencies = {"hoverable"},
  context_fields = {
    {name="scroll_offset_y",  type="float32"},
    {name="max_scroll",       type="float32"},
    {name="is_dragging_bar",  type="boolean"},
    {name="drag_start_y",     type="float32"},
    {name="drag_start_offset",type="float32"},
  },
  state_transitions = {
    {guard="self.is_dragging_bar", target="Draggingbar", priority=40},
  },
  process_body = function(spec, lines)
    -- 1. 更新 max_scroll（内容高度可能每帧变化）
    table.insert(lines, "  self.max_scroll = self.visual.content_height - self.visual.size.y")
    table.insert(lines, "  if self.max_scroll < 0.0 then self.max_scroll = 0.0 end")

    -- 2. 滚轮滚动（仅在 hovered 状态下响应）
    table.insert(lines, "  if self.hover.is_hovered then")
    table.insert(lines, "    local scroll_speed = 30.0")
    table.insert(lines, "    self.scroll_offset_y = self.scroll_offset_y - input.scroll_dy * scroll_speed")
    table.insert(lines, "  end")

    -- 3. 滚动条拖拽逻辑
    table.insert(lines, "  if self.click.just_clicked then")
    table.insert(lines, "    -- 检测点击是否在滚动条轨道区域内")
    table.insert(lines, "    local bar_x = self.visual.pos.x + self.visual.size.x - 10.0")
    table.insert(lines, "    if input.mouse_x >= bar_x then")
    table.insert(lines, "      self.is_dragging_bar = true")
    table.insert(lines, "      self.drag_start_y = input.mouse_y")
    table.insert(lines, "      self.drag_start_offset = self.scroll_offset_y")
    table.insert(lines, "    end")
    table.insert(lines, "  end")
    table.insert(lines, "  if not input.mouse_left_down then")
    table.insert(lines, "    self.is_dragging_bar = false")
    table.insert(lines, "  end")
    table.insert(lines, "  if self.is_dragging_bar then")
    table.insert(lines, "    local dy = input.mouse_y - self.drag_start_y")
    table.insert(lines, "    local scroll_ratio = self.visual.size.y / self.visual.content_height")
    table.insert(lines, "    if scroll_ratio > 1.0 then scroll_ratio = 1.0 end")
    table.insert(lines, "    self.scroll_offset_y = self.drag_start_offset + dy / scroll_ratio")
    table.insert(lines, "  end")

    -- 4. Clamp scroll_offset_y
    table.insert(lines, "  if self.scroll_offset_y < 0.0 then self.scroll_offset_y = 0.0 end")
    table.insert(lines, "  if self.scroll_offset_y > self.max_scroll then self.scroll_offset_y = self.max_scroll end")
  end,
})
]]

-- =============================================================================
-- Visual specification: Scrollable container (track + thumb)
-- =============================================================================
global ScrollableVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,

  -- container colors
  default_bg_color:      Color,
  default_border_color:  Color,
  default_border_width:  float32,
  default_track_color:   Color,
  default_thumb_color:   Color,

  -- hovered colors
  hovered_bg_color:      Color,
  hovered_border_color:  Color,
  hovered_border_width:  float32,
  hovered_track_color:   Color,
  hovered_thumb_color:   Color,

  -- dragging bar colors
  draggingbar_bg_color:      Color,
  draggingbar_border_color:  Color,
  draggingbar_border_width:  float32,
  draggingbar_track_color:   Color,
  draggingbar_thumb_color:   Color,

  -- ★ content_height is set at runtime, not a visual property
  -- We'll store it on the Context as a custom field via the scrollable primitive
  -- Actually, let's add it to the Visual since it's a layout concern
  content_height: float32,
}

##[[
nebula_annotate("ScrollableVisual", {
  states     = {"default", "hovered", "draggingbar"},
  primitives = {"hoverable", "clickable", "scrollable"},
  transitions = {
    {from="default",      to="hovered",     on="hover_enter"},
    {from="hovered",      to="default",     on="hover_leave"},
    {from="hovered",      to="draggingbar", on="drag_start"},
    {from="draggingbar",  to="hovered",     on="drag_end"},
  },
})
]]
## nebula_derive("ScrollableVisual")

-- =============================================================================
-- ButtonVisual (for child items inside scrollable)
-- =============================================================================
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default",  to="hovered", on="hover_enter"},
    {from="hovered",  to="default", on="hover_leave"},
    {from="hovered",  to="pressed", on="press"},
    {from="pressed",  to="hovered", on="release"},
  },
})
]]
## nebula_derive("ButtonVisual")

-- =============================================================================
-- Derive ScrollableApp (scrollable container + child buttons)
-- Both types registered so app_factory creates their pipelines,
-- but we manually manage the draw order with scissor rect.
-- =============================================================================
##[[
  nebula_app_begin("ScrollableApp")
    nebula_app_register_component("scroll_area", "ScrollableVisual")
    -- Register child buttons (8 instances of same type) so app_factory creates pipe_button
    nebula_app_register_component("child0", "ButtonVisual")
    nebula_app_register_component("child1", "ButtonVisual")
    nebula_app_register_component("child2", "ButtonVisual")
    nebula_app_register_component("child3", "ButtonVisual")
    nebula_app_register_component("child4", "ButtonVisual")
    nebula_app_register_component("child5", "ButtonVisual")
    nebula_app_register_component("child6", "ButtonVisual")
    nebula_app_register_component("child7", "ButtonVisual")
  nebula_app_end()
]]
## nebula_derive_app("ScrollableApp")

-- =============================================================================
-- Main program
-- =============================================================================
local NUM_CHILDREN <comptime> = 8
local CHILD_H      <comptime> = 50.0
local CHILD_GAP    <comptime> = 8.0
local CONTENT_H    <comptime> = NUM_CHILDREN * CHILD_H + (NUM_CHILDREN - 1) * CHILD_GAP

local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H, "Nebula — Scrollable Demo (Phase 4.4 S1)", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end

  nebula_input_install_callbacks(window)

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  local app: ScrollableApp
  if not app:init(&renderer, WIN_W, WIN_H) then return 1 end

  -- Initialize scrollable container
  app.scroll_area:init(ScrollableVisual{
    pos  = Vec2{ x = 200.0, y = 80.0 },
    size = Vec2{ x = 400.0, y = 440.0 },
    radius = 8.0,

    default_bg_color      = Color{ r=0.12, g=0.12, b=0.16, a=1.0 },
    default_border_color  = Color{ r=0.30, g=0.30, b=0.35, a=1.0 },
    default_border_width  = 1.0,
    default_track_color   = Color{ r=0.20, g=0.20, b=0.25, a=1.0 },
    default_thumb_color   = Color{ r=0.45, g=0.45, b=0.50, a=1.0 },

    hovered_bg_color      = Color{ r=0.14, g=0.14, b=0.18, a=1.0 },
    hovered_border_color  = Color{ r=0.40, g=0.60, b=1.00, a=1.0 },
    hovered_border_width  = 2.0,
    hovered_track_color   = Color{ r=0.22, g=0.22, b=0.28, a=1.0 },
    hovered_thumb_color   = Color{ r=0.55, g=0.65, b=0.90, a=1.0 },

    draggingbar_bg_color      = Color{ r=0.16, g=0.16, b=0.22, a=1.0 },
    draggingbar_border_color  = Color{ r=0.50, g=0.80, b=1.00, a=1.0 },
    draggingbar_border_width  = 2.5,
    draggingbar_track_color   = Color{ r=0.25, g=0.25, b=0.32, a=1.0 },
    draggingbar_thumb_color   = Color{ r=0.65, g=0.80, b=1.00, a=1.0 },

    content_height = CONTENT_H,
  })

  -- Pre-init child button visuals (positions will be adjusted per-frame based on scroll)
  -- Pre-init child button visuals (positions will be adjusted per-frame based on scroll)
  do
    local ci: int32 = 0
    while ci < NUM_CHILDREN do
      local hue = 0.15 + 0.08 * (@float32)(ci)
      -- Access app.child0 .. app.child7 via index trick:
      -- Since Nelua doesn't support dynamic field access, we use a helper
      local bv = ButtonVisual{
        pos  = Vec2{ x = 210.0, y = 0.0 },
        size = Vec2{ x = 380.0, y = CHILD_H },
        radius = 6.0,
        default_bg_color     = Color{ r=hue, g=hue+0.02, b=hue+0.08, a=1.0 },
        default_border_color = Color{ r=hue+0.15, g=hue+0.15, b=hue+0.20, a=1.0 },
        default_border_width = 1.0,
        hovered_bg_color     = Color{ r=hue+0.08, g=hue+0.10, b=hue+0.18, a=1.0 },
        hovered_border_color = Color{ r=0.40, g=0.60, b=1.00, a=1.0 },
        hovered_border_width = 2.0,
        pressed_bg_color     = Color{ r=hue+0.12, g=hue+0.14, b=hue+0.22, a=1.0 },
        pressed_border_color = Color{ r=0.50, g=0.80, b=1.00, a=1.0 },
        pressed_border_width = 2.0,
      }
      if ci == 0 then app.child0:init(bv)
      elseif ci == 1 then app.child1:init(bv)
      elseif ci == 2 then app.child2:init(bv)
      elseif ci == 3 then app.child3:init(bv)
      elseif ci == 4 then app.child4:init(bv)
      elseif ci == 5 then app.child5:init(bv)
      elseif ci == 6 then app.child6:init(bv)
      elseif ci == 7 then app.child7:init(bv)
      end
      ci = ci + 1
    end
  end

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  -- =============================================================================
  -- Main loop (manual rendering — no nebula_frame_render)
  -- =============================================================================
  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(window, &input, dt)

    -- 1. Update all registered components (app:update handles scroll_area + child0-7)
    app:update(&input, dt)

    -- 2. Update child button positions based on scroll offset (adjust Y before draw)
    -- Note: app:update already called childN:update for hit testing;
    -- we just need to adjust Y positions for visual rendering
    local _sy = app.scroll_area.scroll_offset_y
    local _base_y = app.scroll_area.visual.pos.y + 8.0
    app.child0.visual.pos.y = _base_y + 0.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child1.visual.pos.y = _base_y + 1.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child2.visual.pos.y = _base_y + 2.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child3.visual.pos.y = _base_y + 3.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child4.visual.pos.y = _base_y + 4.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child5.visual.pos.y = _base_y + 5.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child6.visual.pos.y = _base_y + 6.0 * (CHILD_H + CHILD_GAP) - _sy
    app.child7.visual.pos.y = _base_y + 7.0 * (CHILD_H + CHILD_GAP) - _sy

    -- 3. Begin render pass
    local surface_tex: WGPUSurfaceTexture
    wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
    local status = surface_tex.status
    if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
       status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal then
      goto frame_skip
    end

    local view_desc = WGPUTextureViewDescriptor{
      nextInChain     = nilptr,
      label           = wgpu_str_null(),
      format          = renderer.format,
      dimension       = 2,
      baseMipLevel    = 0,
      mipLevelCount   = 1,
      baseArrayLayer  = 0,
      arrayLayerCount = 1,
      aspect          = WGPUTextureAspect_All,
    }
    local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

    local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)
    local clear_color_att = WGPURenderPassColorAttachment{
      nextInChain   = nilptr,
      view          = view,
      depthSlice    = 0xFFFFFFFF,
      resolveTarget = nilptr,
      loadOp        = WGPULoadOp_Clear,
      storeOp       = WGPUStoreOp_Store,
      clearValue    = WGPUColor{ r = 0.09, g = 0.09, b = 0.10, a = 1.0 },
    }
    local pass_desc = WGPURenderPassDescriptor{
      nextInChain             = nilptr,
      label                   = wgpu_str_null(),
      colorAttachmentCount    = 1,
      colorAttachments        = &clear_color_att,
      depthStencilAttachment  = nilptr,
      occlusionQuerySet       = nilptr,
      timestampWrites         = nilptr,
    }
    local pass = wgpuCommandEncoderBeginRenderPass(encoder, &pass_desc)

    -- 4. Draw scrollable container (outside scissor — always fully visible)
    -- Manual draw: upload scroll_area uniforms and draw it
    do
      local uniforms = app.scroll_area:to_uniforms(app.vw, app.vh)
      app.pipe_scrollable:upload(renderer, &uniforms, 1)
      app.pipe_scrollable:draw_instanced(pass, 1)
    end

    -- 5. Set scissor rect for children (clip to scrollable area)
    local sx = (@uint32)(app.scroll_area.visual.pos.x)
    local sy = (@uint32)(app.scroll_area.visual.pos.y)
    local sw = (@uint32)(app.scroll_area.visual.size.x)
    local sh = (@uint32)(app.scroll_area.visual.size.y)
    wgpuRenderPassEncoderSetScissorRect(pass, sx, sy, sw, sh)

    -- 6. Draw child buttons within scissor rect
    do
      local batch: [8]ButtonUniforms
      batch[0] = app.child0:to_uniforms(app.vw, app.vh)
      batch[1] = app.child1:to_uniforms(app.vw, app.vh)
      batch[2] = app.child2:to_uniforms(app.vw, app.vh)
      batch[3] = app.child3:to_uniforms(app.vw, app.vh)
      batch[4] = app.child4:to_uniforms(app.vw, app.vh)
      batch[5] = app.child5:to_uniforms(app.vw, app.vh)
      batch[6] = app.child6:to_uniforms(app.vw, app.vh)
      batch[7] = app.child7:to_uniforms(app.vw, app.vh)
      app.pipe_button:upload(renderer, &batch[0], 8)
      app.pipe_button:draw_instanced(pass, 8)
    end

    -- 7. Reset scissor rect to full viewport
    wgpuRenderPassEncoderSetScissorRect(pass, 0, 0, (@uint32)(WIN_W), (@uint32)(WIN_H))

    -- 8. End pass, submit, present
    wgpuRenderPassEncoderEnd(pass)
    wgpuRenderPassEncoderRelease(pass)

    local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
    wgpuCommandEncoderRelease(encoder)
    wgpuQueueSubmit(renderer.queue, 1, &cmd)
    wgpuCommandBufferRelease(cmd)

    wgpuSurfacePresent(renderer.surface)
    wgpuTextureViewRelease(view)
    wgpuTextureRelease(surface_tex.texture)

    ::frame_skip::
  end

  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("nebula: clean exit\n")
  return 0
end

main()
