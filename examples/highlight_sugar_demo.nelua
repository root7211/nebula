-- =============================================================================
-- highlight_sugar_demo.nelua
-- Nebula GUI Compiler — Phase 4.5-S2
--
-- 语法高亮编辑器的全糖化版本：
--   · nebula_inject_buffers — 自动注入 buffer 类型（替代手动 4 行注入）
--   · nebula_component — 合并 annotate + derive（替代 22+ 行声明）
--   · nebula_app + 混合管线自动编排 — 统一 components 数组注册，
--     自动从 Visual 的 text_mode 检测 dense 管线（替代 dense_texts 分离声明）
--   · nebula_init / nebula_should_close / nebula_shutdown — 统一生命周期
--
-- 对比 highlight_editor_demo.nelua（旧写法 ~370 行声明+初始化）
-- 本文件将编排样板代码从 ~80 行减少到 ~15 行
-- =============================================================================
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "text_runtime"
require "nebula_cursor"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function snprintf(buf: cstring, size: csize, fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 1280
local WIN_H <comptime> = 800

local LINENUM_COLS <comptime> = 5
local LINENUM_CELL_W <comptime> = 10.0
local LINENUM_CELL_H <comptime> = 16.0
local EDIT_COLS <comptime> = 120
local EDIT_ROWS <comptime> = 50
local EDIT_CELL_W <comptime> = 10.0
local EDIT_CELL_H <comptime> = 16.0

-- =============================================================================
-- ★ Phase 4.7-S4: 语法高亮规则（编译期注入，与 highlight_editor_demo 相同）
-- =============================================================================
##[[
  nebula_highlight_rules("nelua", {
    keywords = {
      { words = {"if", "else", "elseif", "then", "end", "for", "while",
                 "do", "repeat", "until", "return", "break", "goto", "in",
                 "switch", "case", "continue", "defer"},
        color = 0xC586C0FF },
      { words = {"local", "global", "function", "require", "record", "enum",
                 "union", "type"},
        color = 0x569CD6FF },
      { words = {"true", "false", "nil", "nilptr"},
        color = 0x4EC9B0FF },
      { words = {"int8", "int16", "int32", "int64",
                 "uint8", "uint16", "uint32", "uint64",
                 "float32", "float64", "boolean", "cstring",
                 "cint", "csize", "pointer", "void", "auto",
                 "byte", "isize", "usize"},
        color = 0x4DC9A0FF },
    },
    line_comment = "--",
    line_comment_color = 0x6A9955FF,
    string_color       = 0xCE9178FF,
    number_color       = 0xB5CEA8FF,
  })
]]
## nebula_derive_highlighter("nelua")

-- =============================================================================
-- ★ Phase 4.5 S1: 自动注入 buffer 类型（替代手动 4 行 ##[[ ]] 注入）
-- =============================================================================
## nebula_inject_buffers({ primitives = {"multiline_editable"}, max_text_len = 128, max_lines = 32 })

-- =============================================================================
-- Visual 类型定义
-- =============================================================================
global EditorBgVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,

  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,

  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,

  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,

  pixel_height: float32,
  text_origin_x: float32,
  content_height: float32,

  multi_buf: NebulaMultiBuf128_32,
  gap_buf: NebulaBuf128,
}

-- ★ Phase 4.5 S1: 1 行替代 22+ 行 annotate + states + transitions + derive
## nebula_component("EditorBgVisual", {
##   primitives   = {"multiline_editable"},
##   max_text_len = 128,
##   max_lines    = 32,
##   component_id = 1,
## })

-- DenseText Visual 类型（轻量 record + 1 行 nebula_component）
global LineNumDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("LineNumDenseVisual", { text_mode = "dense", max_chars = 1024 })

global EditAreaDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("EditAreaDenseVisual", { text_mode = "dense", max_chars = 8192 })

-- =============================================================================
-- 颜色辅助（与 highlight_editor_demo 相同）
-- =============================================================================
local function _fg_normal(): uint32 return nebula_pack_rgba8(210, 210, 220, 255) end
local function _bg_normal(): uint32 return nebula_pack_rgba8(22, 22, 30, 255) end
local function _bg_linenum(): uint32 return nebula_pack_rgba8(28, 28, 38, 255) end
local function _fg_linenum(): uint32 return nebula_pack_rgba8(90, 90, 110, 255) end
local function _fg_separator(): uint32 return nebula_pack_rgba8(50, 50, 70, 255) end
local function _bg_cursor_line(): uint32 return nebula_pack_rgba8(35, 35, 50, 255) end
local function _bg_cursor(): uint32 return nebula_pack_rgba8(200, 200, 230, 255) end
local function _fg_cursor(): uint32 return nebula_pack_rgba8(22, 22, 30, 255) end

-- =============================================================================
-- 行号 Producer（与 highlight_editor_demo 相同）
-- =============================================================================
global function fill_line_nums(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local editor = &app.editor
  local mb = &editor.visual.multi_buf
  local origin_x: float32 = app.dense_layout_line_nums_x
  local origin_y: float32 = app.dense_layout_line_nums_y + 4.0
  local idx: uint32 = 0
  local scroll_row: uint32 = (@uint32)(editor.scroll_offset_y / (LINENUM_CELL_H + 2.0))
  local visible_rows: uint32 = EDIT_ROWS

  local row: uint32 = 0
  while row < visible_rows and idx < max do
    local buf_row = row + scroll_row
    local is_cursor_line = (buf_row == editor.cursor_row)
    local bg = is_cursor_line and _bg_cursor_line() or _bg_linenum()

    if buf_row < mb.line_count then
      local num = buf_row + 1
      local d3 = num / 1000
      local d2 = (num % 1000) / 100
      local d1 = (num % 100) / 10
      local d0 = num % 10
      local num_chars: [4]uint32 = {
        d3 > 0 and (48 + d3) or 32,
        (d3 > 0 or d2 > 0) and (48 + d2) or 32,
        (d3 > 0 or d2 > 0 or d1 > 0) and (48 + d1) or 32,
        48 + d0
      }
      local nc: uint32 = 0
      while nc < 4 and idx < max do
        nebula_dense_grid_fill_instance(&instances[idx], row, nc, num_chars[nc], origin_x, origin_y, LINENUM_CELL_W, LINENUM_CELL_H, _fg_linenum(), bg)
        idx = idx + 1; nc = nc + 1
      end
      if idx < max then
        nebula_dense_grid_fill_instance(&instances[idx], row, 4, 124, origin_x, origin_y, LINENUM_CELL_W, LINENUM_CELL_H, _fg_separator(), bg)
        idx = idx + 1
      end
    else
      local nc: uint32 = 0
      while nc < 4 and idx < max do
        nebula_dense_grid_fill_instance(&instances[idx], row, nc, nc == 0 and 126 or 32, origin_x, origin_y, LINENUM_CELL_W, LINENUM_CELL_H, _fg_linenum(), _bg_linenum())
        idx = idx + 1; nc = nc + 1
      end
      if idx < max then
        nebula_dense_grid_fill_instance(&instances[idx], row, 4, 124, origin_x, origin_y, LINENUM_CELL_W, LINENUM_CELL_H, _fg_separator(), _bg_linenum())
        idx = idx + 1
      end
    end
    row = row + 1
  end
  $count = idx
end

-- =============================================================================
-- ★ 编辑区 Producer（带语法高亮，与 highlight_editor_demo 相同）
-- =============================================================================
global function fill_edit_area(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local editor = &app.editor
  local mb = &editor.visual.multi_buf
  local origin_x: float32 = app.dense_layout_edit_area_x
  local origin_y: float32 = app.dense_layout_edit_area_y + 4.0
  local idx: uint32 = 0
  local scroll_row: uint32 = (@uint32)(editor.scroll_offset_y / (EDIT_CELL_H + 2.0))
  local visible_rows: uint32 = EDIT_ROWS
  local hl_colors: [256]uint32

  local row: uint32 = 0
  while row < visible_rows and idx < max do
    local buf_row = row + scroll_row
    local is_cursor_line = (buf_row == editor.cursor_row)
    local bg = is_cursor_line and _bg_cursor_line() or _bg_normal()

    if buf_row < mb.line_count then
      local line = mb:get_line(buf_row)
      local flat: [256]uint8
      local line_len = line:flatten(&flat[0], 255)
      nebula_highlight_scan_nelua(&flat[0], (@uint32)(line_len), _fg_normal(), &hl_colors[0])

      local cursor_byte: int32 = -1
      if is_cursor_line then cursor_byte = (@int32)(editor.cursor_col) end

      local byte_i: uint32 = 0
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        local ch: uint32 = 32
        local fg = _fg_normal()
        local this_bg = bg
        if byte_i < line_len then
          ch = (@uint32)(flat[byte_i])
          fg = hl_colors[byte_i]
          if ch >= 0xC0 and ch <= 0xDF then ch = 0x3F; byte_i = byte_i + 1
          elseif ch >= 0xE0 and ch <= 0xEF then ch = 0x3F; byte_i = byte_i + 2
          elseif ch >= 0xF0 then ch = 0x3F; byte_i = byte_i + 3 end
          byte_i = byte_i + 1
        end
        if cursor_byte >= 0 and (@uint32)(cursor_byte) == byte_i - 1 then
          this_bg = _bg_cursor(); fg = _fg_cursor()
        end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, ch, origin_x, origin_y, EDIT_CELL_W, EDIT_CELL_H, fg, this_bg)
        idx = idx + 1; col = col + 1
      end
      while col < EDIT_COLS and idx < max do
        local this_bg = bg
        if cursor_byte >= 0 and byte_i == line_len and col == byte_i then this_bg = _bg_cursor() end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, EDIT_CELL_W, EDIT_CELL_H, _fg_normal(), this_bg)
        idx = idx + 1; col = col + 1
      end
    else
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, EDIT_CELL_W, EDIT_CELL_H, _fg_normal(), _bg_normal())
        idx = idx + 1; col = col + 1
      end
    end
    row = row + 1
  end
  $count = idx
end

