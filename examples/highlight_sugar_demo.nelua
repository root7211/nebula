-- =============================================================================
-- ★ Phase 4.5 S2: 统一生命周期（nebula_init + nebula_should_close + nebula_shutdown）
-- ★ WASM fix: 添加 emscripten_set_main_loop 支持
-- =============================================================================

## if NEBULA_TARGET == 'wasm' then
global _wasm_hlsugar_renderer: *NebulaRenderer = nilptr
global _wasm_hlsugar_app: *HighlightSugarApp = nilptr
global _wasm_hlsugar_input: NebulaInputState
global _wasm_hlsugar_prev_time: float64 = 0.0

global function _wasm_hlsugar_frame(): void
  glfwPollEvents()
  local now = glfwGetTime()
  local dt = (@float32)(now - _wasm_hlsugar_prev_time)
  _wasm_hlsugar_prev_time = now
  nebula_collect_input(_nebula_window, &_wasm_hlsugar_input, dt)
  _wasm_hlsugar_app.editor.visual.content_height = (@float32)(_wasm_hlsugar_app.editor.line_count) * (EDIT_CELL_H + 2.0)
  nebula_frame_render(_wasm_hlsugar_renderer, _wasm_hlsugar_app, &_wasm_hlsugar_input, dt, 0.04, 0.04, 0.06)
end
## end

local function main(): int32
  local renderer: NebulaRenderer
  local app: HighlightSugarApp

  if not nebula_init(&renderer, &app,
    "Nebula Phase 4.5-S2 — Highlight Sugar Demo", WIN_W, WIN_H) then
    return 1
  end

  -- Initialize editor visual
  app.editor:init(EditorBgVisual{
    pos  = Vec2{ x = 0.0, y = 0.0 },
    size = Vec2{ x = (@float32)(WIN_W), y = (@float32)(WIN_H) },
    radius = 0.0,

    default_bg_color     = Color{ r=0.08, g=0.08, b=0.12, a=1.0 },
    default_border_color = Color{ r=0.15, g=0.15, b=0.25, a=1.0 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.08, g=0.08, b=0.12, a=1.0 },
    hovered_border_color = Color{ r=0.20, g=0.30, b=0.60, a=1.0 },
    hovered_border_width = 1.0,
    pressed_bg_color     = Color{ r=0.10, g=0.10, b=0.16, a=1.0 },
    pressed_border_color = Color{ r=0.30, g=0.50, b=0.90, a=1.0 },
    pressed_border_width = 1.0,

    pixel_height = 16.0,
    text_origin_x = 58.0,
    content_height = 700.0,
  })

  app.editor.cursor_row = 0
  app.editor.cursor_col = 0
  app.editor.line_count = 1
  app.editor.visual.multi_buf:init()

  -- Pre-fill demo text
  local demo_lines: [12]cstring = {
    "-- Phase 4.5-S2: Full sugar highlight editor",
    "-- nebula_component + nebula_app + auto pipeline",
    "",
    "local function fibonacci(n: int32): int32",
    "  if n <= 1 then return n end",
    "  return fibonacci(n - 1) + fibonacci(n - 2)",
    "end",
    "",
    "local msg: cstring = \"hello world\"",
    "local count: uint32 = 42",
    "local pi: float64 = 3.14159",
    "global flag: boolean = true"
  }

  local li: int32 = 0
  while li < 12 do
    if li > 0 then app.editor.visual.multi_buf:insert_newline() end
    local line = app.editor.visual.multi_buf:get_line((@uint32)(li))
    local src = (@*[0]uint8)(demo_lines[li])
    local si: uint16 = 0
    while src[si] ~= 0 do line:insert_char(src[si]); si = si + 1 end
    li = li + 1
  end

  app.editor.line_count = app.editor.visual.multi_buf.line_count
  app.editor.cursor_row = 0
  app.editor.cursor_col = 0
  app.editor.visual.multi_buf.cursor_row = 0
  app.editor.visual.multi_buf.cursor_col = 0

  printf("=== Phase 4.5-S2: Highlight Sugar Demo ===\n")
  printf("  Sugar: nebula_component + nebula_app (auto pipeline detection)\n")
  printf("  Lifecycle: nebula_init + nebula_should_close + nebula_shutdown\n")
  printf("  Lines: %d pre-filled\n", (@int32)(app.editor.line_count))

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  ## if NEBULA_TARGET == 'wasm' then
  _wasm_hlsugar_renderer = &renderer
  _wasm_hlsugar_app = &app
  _wasm_hlsugar_prev_time = glfwGetTime()
  emscripten_set_main_loop(_wasm_hlsugar_frame, 0, 1)
  ## else
  while not nebula_should_close() do
    nebula_poll_events()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(_nebula_window, &input, dt)

    app.editor.visual.content_height = (@float32)(app.editor.line_count) * (EDIT_CELL_H + 2.0)

    nebula_frame_render(&renderer, &app, &input, dt, 0.04, 0.04, 0.06)
  end
  ## end

  app:deinit()
  nebula_shutdown(&renderer)
  printf("nebula: highlight sugar demo clean exit\n")
  return 0
end

main()
