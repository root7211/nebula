-- =============================================================================
-- dynamic_list_demo.nelua
-- Nebula GUI Compiler — Phase 3.9
--
-- ★ Phase 3.9: Slot Producer 重构
--   · 使用 nebula_app_register_slot（producer 模式）将动态列表纳入 ListApp 编排
--   · 废弃手动 Arena 分配 + 外部全局变量（arena_var/count_var/data_var）
--   · 引入 list_item_producer 纯函数，声明式描述数据生产逻辑
--   · 主循环从 ~80 行 WGPU 样板收缩到 3 行（collect_input + frame_render）
--   · Arena 生命周期由 app_factory 自动管理（mark/rewind 局部回收）
--
-- 与 Phase 3.7 的对比：
--   · 删除手动 pipe: ListItemPipeline 声明和初始化
--   · 删除手动 arena_backing / arena 声明和初始化
--   · 删除手动 nebula_arena_reset / nebula_arena_alloc_array 调用
--   · 删除手动 WGPU 渲染样板（surface_texture / encoder / pass / submit / present）
--   · 业务逻辑（滚动、hover 检测、实例数据构建）集中在 list_item_producer 函数中
--
-- 演示能力：运行时动态列表与实例渲染（Instancing）
--   · 10,000 个列表项，支持鼠标 hover 高亮
--   · 列表支持鼠标滚轮滚动
--   · 1 次 Draw Call 渲染所有可见项（约 15 项）
-- =============================================================================
## cinclude "<stdio.h>"
## cinclude "<math.h>"
require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "nebula_arena"
global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
local WIN_W <comptime> = 800
local WIN_H <comptime> = 600
-- 列表参数（编译期常量）
local LIST_ITEM_COUNT    <comptime> = 10000
local LIST_ITEM_W        <comptime> = 760.0
local LIST_ITEM_H        <comptime> = 40.0
local LIST_ITEM_GAP      <comptime> = 4.0
local LIST_ITEM_STRIDE   <comptime> = LIST_ITEM_H + LIST_ITEM_GAP
local LIST_ITEM_X        <comptime> = 20.0
local LIST_ITEM_RADIUS   <comptime> = 8.0
local LIST_VISIBLE_COUNT <comptime> = 16  -- 窗口内最多可见的列表项数（含半遮挡）
-- =============================================================================
-- Phase 3.7: 声明 ListItemVisual，通过 nebula_derive 自动派生 standard_instanced 管线
-- =============================================================================
global ListItemVisual = @record{
  pos:          Vec2,
  size:         Vec2,
  bg_color:     Color,
  border_color: Color,
  border_width: float32,
  radius:       float32,
}
##[[
nebula_annotate("ListItemVisual", {
  states        = {},
  max_instances = 16,  -- 对应 LIST_VISIBLE_COUNT
})
nebula_derive("ListItemVisual")
]]
-- =============================================================================
-- ★ Phase 3.9: 运行时状态（全局，供 Producer 函数访问）
-- =============================================================================
global list_scroll_y:   float32 = 0.0   -- 当前滚动偏移（像素）
global list_hovered_id: int32   = -1    -- 当前 hover 的列表项索引（-1 = 无）
global list_mouse_x:    float32 = 0.0
global list_mouse_y:    float32 = 0.0
global list_scroll_dy:  float32 = 0.0
-- =============================================================================
-- ★ Phase 3.9: Slot Producer 函数（原语 4）
--
-- 签名约定（由 app_factory.lua 生成的调用代码决定）：
--   function(app: *<App>, arena: *NebulaArena,
--            slot_data: *[0]<T>Uniforms, slot_count: *uint32, max: uint32): void
--
-- 此函数是纯函数：不修改 App 状态，仅写入 slot_data 和 slot_count。
-- Arena 由框架自动管理（mark/rewind），Producer 可从中分配临时 L2 数据。
-- =============================================================================
global function list_item_producer(
    app:        *ListApp,
    arena:      *NebulaArena,
    slot_data:  *[0]ListItemUniforms,
    slot_count: *uint32,
    max:        uint32): void
  -- 处理滚轮输入（更新全局滚动状态）
  if list_scroll_dy ~= 0.0 then
    list_scroll_y = list_scroll_y - list_scroll_dy * LIST_ITEM_STRIDE
    local max_scroll: float32 = (@float32)(LIST_ITEM_COUNT) * LIST_ITEM_STRIDE - (@float32)(WIN_H)
    if max_scroll < 0.0 then max_scroll = 0.0 end
    if list_scroll_y < 0.0 then list_scroll_y = 0.0 end
    if list_scroll_y > max_scroll then list_scroll_y = max_scroll end
    list_scroll_dy = 0.0
  end

  -- 计算当前可见的第一个列表项索引
  local first_visible: int32 = (@int32)(list_scroll_y / LIST_ITEM_STRIDE)
  if first_visible < 0 then first_visible = 0 end

  -- 鼠标 hover 检测（仅对可见项）
  list_hovered_id = -1
  local hi: int32 = 0
  while hi < LIST_VISIBLE_COUNT do
    local item_idx: int32 = first_visible + hi
    if item_idx >= LIST_ITEM_COUNT then break end
    local item_y: float32 = (@float32)(item_idx) * LIST_ITEM_STRIDE - list_scroll_y
    if list_mouse_y >= item_y and list_mouse_y < item_y + LIST_ITEM_H then
      list_hovered_id = item_idx
      break
    end
    hi = hi + 1
  end

  -- 构建可见列表项的 Uniforms 数组
  local count: uint32 = 0
  local i: int32 = 0
  while i < LIST_VISIBLE_COUNT and count < max do
    local item_idx: int32 = first_visible + i
    if item_idx >= LIST_ITEM_COUNT then break end
    local item_y: float32 = (@float32)(item_idx) * LIST_ITEM_STRIDE - list_scroll_y
    -- 裁剪：完全在屏幕外的项不提交
    if item_y + LIST_ITEM_H > 0.0 and item_y < (@float32)(WIN_H) then
      local is_hovered: boolean = (item_idx == list_hovered_id)
      slot_data[count] = ListItemUniforms{
        pos  = Vec2{ x = LIST_ITEM_X, y = item_y },
        size = Vec2{ x = LIST_ITEM_W, y = LIST_ITEM_H },
        bg_color = is_hovered
          and Color{ r=0.227, g=0.239, b=0.322, a=1.0 }
          or  Color{ r=0.165, g=0.176, b=0.227, a=1.0 },
        border_color = is_hovered
          and Color{ r=0.333, g=0.400, b=0.667, a=1.0 }
          or  Color{ r=0.200, g=0.200, b=0.200, a=0.6 },
        border_width = is_hovered and 1.5 or 1.0,
        radius       = LIST_ITEM_RADIUS,
      }
      count = count + 1
    end
    i = i + 1
  end
  $slot_count = count
end
-- =============================================================================
-- ★ Phase 3.9: 使用 nebula_derive_app 宏声明并派生 ListApp
--   · nebula_app_register_slot（producer 模式）将动态列表纳入一等公民编排
-- =============================================================================
##[[
  nebula_app_begin("ListApp", { arena_size = LIST_VISIBLE_COUNT * 64 + 256 })
    nebula_app_register_slot("list_items", "ListItemVisual", {
      max_instances = LIST_VISIBLE_COUNT,
      producer      = "list_item_producer",
    })
  nebula_app_end()
]]
## nebula_derive_app("ListApp")
-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)
  local window = glfwCreateWindow(WIN_W, WIN_H,
    "Nebula Phase 3.9 — Dynamic List Demo (10,000 Instances, Producer)", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end
  nebula_input_install_callbacks(window)
  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end
  -- ★ Phase 3.9: ListApp:init 自动初始化 ListItemPipeline + 内嵌 FrameArena
  local list_app: ListApp
  if not list_app:init(&renderer, WIN_W, WIN_H) then
    printf("nebula: failed to init ListApp\n")
    return 1
  end
  local input: NebulaInputState
  local prev_time = glfwGetTime()
  local frame_count: uint32 = 0
  printf("nebula: dynamic_list_demo started — %d items, %d max visible\n",
    LIST_ITEM_COUNT, LIST_VISIBLE_COUNT)
  -- =============================================================================
  -- ★ Phase 3.9: 主循环收缩到 3 行
  -- =============================================================================
  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(window, &input, dt)

    -- 将输入状态传递给 Producer 全局变量
    list_mouse_x   = input.mouse_x
    list_mouse_y   = input.mouse_y
    list_scroll_dy = input.scroll_dy

    -- ★ Phase 3.9: nebula_frame_render 内部自动调用 list_item_producer
    nebula_frame_render(&renderer, &list_app, &input, dt, 0.08, 0.08, 0.10)

    frame_count = frame_count + 1
    if frame_count % 600 == 0 then
      printf("nebula: frame=%u  scroll=%.1f  hovered=%d  arena_used=%zu bytes\n",
        frame_count, list_scroll_y, list_hovered_id,
        nebula_arena_used(&list_app.arena))
    end
  end

  printf("nebula: dynamic_list_demo exiting after %u frames\n", frame_count)
  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  return 0
end
main()
