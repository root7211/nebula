-- =============================================================================
-- login_v2_demo.nelua
-- Nebula GUI Compiler — Phase 5.4
--
-- ★ 精美登录界面演示 — L2 声明式 API
--
-- 设计：深色主题 + 几何 Logo + 卡片式布局
--   · 卡片：360×460，圆角 20，微妙边框
--   · Logo：80×80 圆角矩形（品牌标识区）
--   · 标题栏：蓝色分隔线
--   · 输入框：hover 变亮 + focus 蓝色边框
--   · 复选框："记住我"
--   · 登录按钮：hover 提亮 + press 下沉反馈
--
-- 对比 login_demo（Phase 3.9 L0 手动 API）：
--   · 代码量从 ~180 行降至 ~80 行
--   · 使用 nebula_visual / nebula_app / nebula_main 声明式 API
--   · 布局从手动坐标改为 init_themed 自动填充
-- =============================================================================
require "nebula"

-- =============================================================================
-- Visual 类型声明（L2 Sugar：从 primitives 自动推导 states/transitions/record）
-- =============================================================================

-- 卡片背景（无交互，纯装饰）
## nebula_visual("CardVisual", { primitives = {} })

-- Logo 区域（纯装饰，hover 微亮）
## nebula_visual("LogoVisual", { primitives = {"hoverable"} })

-- 标题栏（纯装饰，无交互）
## nebula_visual("TitleBarVisual", { primitives = {} })

-- 输入框（hover 变亮 + focus 蓝色边框）
## nebula_visual("InputVisual", { primitives = {"hoverable", "clickable", "focusable", "editable"} })

-- 复选框（点击切换）
## nebula_visual("CheckboxVisual", { primitives = {"hoverable", "clickable", "toggleable"} })

-- 登录按钮（hover 提亮 + press 下沉）
## nebula_visual("LoginButtonVisual", { primitives = {"hoverable", "clickable"} })

