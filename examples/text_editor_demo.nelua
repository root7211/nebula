-- DenseText 管线（行号 + 编辑区，手写 Producer 需显式声明）
global LineNumDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("LineNumDenseVisual", { text_mode = "dense", max_chars = 1024 })

global EditAreaDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("EditAreaDenseVisual", { text_mode = "dense", max_chars = 8192 })

-- =============================================================================
-- ★ Sugar: 内置行号 Producer（替代 ~53 行手写 fill_line_nums）
-- =============================================================================
## nebula_builtin_line_nums("editor", { cell_w = 10.0, cell_h = 16.0, rows = 50 })

-- =============================================================================
-- 编辑区 Producer（语法高亮 — 领域特定，无法通用化）
-- =============================================================================
global function fill_edit_area(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local editor = &app.editor
  local mb = &editor.visual.multi_buf
  local origin_x: float32 = app.dense_layout_edit_area_x
  local origin_y: float32 = app.dense_layout_edit_area_y + 4.0
  local idx: uint32 = 0
  local scroll_row: uint32 = (@uint32)(editor.scroll_offset_y / (CELL_H + 2.0))
  local visible_rows: uint32 = EDIT_ROWS
  local hl_colors: [512]uint32

  -- ★ Phase 4.8 S1: compute ordered selection bounds
  local sel_active: boolean = (editor.sel_anchor_row ~= editor.cursor_row) or (editor.sel_anchor_col ~= editor.cursor_col)
  local sel_sr: uint32 = 0
  local sel_sc: uint32 = 0
  local sel_er: uint32 = 0
  local sel_ec: uint32 = 0
  if sel_active then
    if editor.sel_anchor_row < editor.cursor_row or (editor.sel_anchor_row == editor.cursor_row and editor.sel_anchor_col < editor.cursor_col) then
      sel_sr = editor.sel_anchor_row; sel_sc = editor.sel_anchor_col
      sel_er = editor.cursor_row; sel_ec = editor.cursor_col
    else
      sel_sr = editor.cursor_row; sel_sc = editor.cursor_col
      sel_er = editor.sel_anchor_row; sel_ec = editor.sel_anchor_col
    end
  end

  local row: uint32 = 0
  while row < visible_rows and idx < max do
    local buf_row = row + scroll_row
    local is_cursor_line = (buf_row == editor.cursor_row)
    local bg = is_cursor_line and nebula_theme_bg_cursor_line() or nebula_theme_bg_normal()

    if buf_row < mb.line_count then
      local line = mb:get_line(buf_row)
      local flat: [512]uint8
      local line_len = line:flatten(&flat[0], 511)
      nebula_highlight_scan_nelua(&flat[0], (@uint32)(line_len), nebula_theme_fg_normal(), &hl_colors[0])

      local cursor_byte: int32 = -1
      if is_cursor_line then cursor_byte = (@int32)(editor.cursor_col) end

      local byte_i: uint32 = 0
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        local ch: uint32 = 32
        local fg = nebula_theme_fg_normal()
        local this_bg = bg
        if byte_i < line_len then
          ch = (@uint32)(flat[byte_i])
          fg = hl_colors[byte_i]
          if ch >= 0xC0 and ch <= 0xDF then ch = 0x3F; byte_i = byte_i + 1
          elseif ch >= 0xE0 and ch <= 0xEF then ch = 0x3F; byte_i = byte_i + 2
          elseif ch >= 0xF0 then ch = 0x3F; byte_i = byte_i + 3 end
          byte_i = byte_i + 1
        end
        -- ★ Phase 4.8 S1: selection background override
        if sel_active then
          local in_sel: boolean = false
          if buf_row > sel_sr and buf_row < sel_er then
            in_sel = true  -- entire row is selected
          elseif buf_row == sel_sr and buf_row == sel_er then
            -- single-row selection
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte >= sel_sc and prev_byte < sel_ec then in_sel = true end
          elseif buf_row == sel_sr then
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte >= sel_sc then in_sel = true end
          elseif buf_row == sel_er then
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte < sel_ec then in_sel = true end
          end
          if in_sel then this_bg = nebula_theme_bg_selected() end
        end
        if cursor_byte >= 0 and (@uint32)(cursor_byte) == byte_i - 1 then
          this_bg = nebula_theme_bg_cursor(); fg = nebula_theme_fg_cursor()
        end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, ch, origin_x, origin_y, CELL_W, CELL_H, fg, this_bg)
        idx = idx + 1; col = col + 1
      end
      while col < EDIT_COLS and idx < max do
        local this_bg = bg
        -- ★ Phase 4.8 S1: selection bg for trailing empty cells
        if sel_active then
          if buf_row > sel_sr and buf_row < sel_er then
            this_bg = nebula_theme_bg_selected()
          elseif buf_row == sel_sr and buf_row ~= sel_er and byte_i >= sel_sc then
            this_bg = nebula_theme_bg_selected()
          end
        end
        if cursor_byte >= 0 and byte_i == line_len and col == byte_i then this_bg = nebula_theme_bg_cursor() end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, CELL_W, CELL_H, nebula_theme_fg_normal(), this_bg)
        idx = idx + 1; col = col + 1
      end
    else
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, CELL_W, CELL_H, nebula_theme_fg_normal(), nebula_theme_bg_normal())
        idx = idx + 1; col = col + 1
      end
    end
    row = row + 1
  end
  $count = idx
end

