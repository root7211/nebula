-- =============================================================================
-- text_editor_demo.nelua
-- Nebula GUI Compiler — Phase 4.7-S7 + Phase 4.8-S1
--
-- 文本编辑器原型——Phase 4.7 收官 demo + Phase 4.8 S1 选区可视化 + 系统剪贴板：
--   · S1: CJK multiline editable（UTF-8 aware gap buffer）
--   · S2: DenseText App 编排（Producer 模式）
--   · S3: 行号显示（内置 Producer）
--   · S4: 语法高亮（编译期规则注入 + 运行时 per-char 着色）
--   · S5: Undo/Redo（Ctrl+Z / Ctrl+Y）
--   · S6: File I/O（load_file / save_file）
--   · S7: 集成验收
--   · Phase 4.8-S1: 选区可视化（Shift+Arrow 选区扩展 + 蓝色背景高亮）+ 系统剪贴板（Ctrl+C/V/X/A）
--
-- ★ Sugar:
--   · nebula_visual — 自动生成 Visual record + buffer 注入 + DenseText 伴生管线
--   · nebula_theme — 内置暗色主题
--   · nebula_builtin_line_nums — 内置行号 Producer
--   · nebula_app — 默认 layout（1280x800）+ 混合管线自动编排
--
-- Usage:
--   ./text_editor_demo                     # 空缓冲区
--   ./text_editor_demo path/to/file.nelua  # 打开文件
--
-- 快捷键:
--   Ctrl+S          保存文件
--   Ctrl+Z          撤销
--   Ctrl+Y/Shift+Z  重做
--   Ctrl+C/V/X/A    复制/粘贴/剪切/全选
-- =============================================================================
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function snprintf(buf: cstring, size: csize, fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

-- =============================================================================
-- 常量
-- =============================================================================
local EDIT_COLS <comptime> = 120
local EDIT_ROWS <comptime> = 50
local CELL_W <comptime> = 10.0
local CELL_H <comptime> = 16.0

-- =============================================================================
-- 全局状态
-- =============================================================================
global _editor_file_path: [512]uint8
global _editor_has_file: boolean = false
global _editor_modified: boolean = false

-- =============================================================================
-- 语法高亮规则
-- =============================================================================
##[[
  nebula_highlight_rules("nelua", {
    keywords = {
      { words = {"if", "else", "elseif", "then", "end", "for", "while",
                 "do", "repeat", "until", "return", "break", "goto", "in",
                 "switch", "case", "continue", "defer"},
        color = 0xC586C0FF },
      { words = {"local", "global", "function", "require", "record", "enum",
                 "union", "type"},
        color = 0x569CD6FF },
