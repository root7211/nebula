-- =============================================================================
-- text_editor_demo.nelua
-- Nebula GUI Compiler — Phase 4.8-S6 集成验收
--
-- 文本编辑器原型——Phase 4.7 收官 demo + Phase 4.8 增强：
--   · S1: CJK multiline editable（UTF-8 aware gap buffer）
--   · S2: DenseText App 编排（Producer 模式）
--   · S3: 行号显示（内置 Producer）
--   · S4: 语法高亮（编译期规则注入 + 运行时 per-char 着色）
--   · S5: Undo/Redo（Ctrl+Z / Ctrl+Y）
--   · S6: File I/O（load_file / save_file）
--   · S7: 集成验收
--   · Phase 4.8-S1: 选区可视化（Shift+Arrow 选区扩展 + 蓝色背景高亮）+ 系统剪贴板（Ctrl+C/V/X/A）
--   · Phase 4.8-S2: 搜索与替换（Ctrl+F 搜索 / Ctrl+H 替换 / F3 下一个匹配 / 固定布局 Producer 方案）
--   · Phase 4.8-S3: 状态栏（文件名 + 行列号 + 行数 + 编码 + 行尾符）+ 光标行高亮
--   · Phase 4.8-S4: 多语言语法高亮（nelua/lua/c/python/json/markdown + 扩展名自动检测）
--   · Phase 4.8-S5: 自动缩进（Tab 4 空格 / Shift+Tab 反缩进 / Enter 保持缩进）
--   · Phase 4.8-NL: 嵌套布局（editor_body = row{ line_nums, edit_area } + status_bar + search_bar）
--
-- ★ Sugar:
--   · nebula_visual — 自动生成 Visual record + buffer 注入 + DenseText 伴生管线
--   · nebula_theme — 内置暗色主题
--   · nebula_builtin_line_nums — 内置行号 Producer
--   · nebula_app — 默认 layout（1280x800）+ 混合管线自动编排 + 嵌套布局
--
-- Usage:
--   ./text_editor_demo                     # 空缓冲区
--   ./text_editor_demo path/to/file.nelua  # 打开文件
--
-- 快捷键:
--   Ctrl+S          保存文件
--   Ctrl+Z          撤销
--   Ctrl+Y/Shift+Z  重做
--   Ctrl+C/V/X/A    复制/粘贴/剪切/全选
--   Ctrl+F          搜索
--   Ctrl+H          搜索与替换
--   F3 / Enter      下一个匹配
--   Escape          关闭搜索栏
--   Tab             插入 4 空格（编辑区） / 切换搜索/替换框（搜索栏）
--   Shift+Tab       反缩进
-- =============================================================================
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function snprintf(buf: cstring, size: csize, fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

-- =============================================================================
-- 常量
-- =============================================================================
local EDIT_COLS <comptime> = 120
local EDIT_ROWS <comptime> = 50
local CELL_W <comptime> = 10.0
local CELL_H <comptime> = 16.0

-- =============================================================================
-- 全局状态
-- =============================================================================
global _editor_file_path: [512]uint8
global _editor_has_file: boolean = false
global _editor_modified: boolean = false
global _editor_highlight_id: uint32 = 0  -- 0=none, 1=nelua, 2=lua, 3=c, 4=python, 5=json, 6=markdown

-- ★ Phase 4.8-S2: 搜索状态（固定布局，零堆分配）
global _search_active: boolean = false   -- 搜索栏是否激活
global _search_replace: boolean = false  -- 是否为替换模式（Ctrl+H）
global _search_buf: [256]uint8           -- 搜索关键字 buffer
global _search_len: uint32 = 0           -- 当前关键字长度
global _search_cursor: uint32 = 0        -- 搜索框光标位置
global _replace_buf: [256]uint8          -- 替换文本 buffer
global _replace_len: uint32 = 0          -- 替换文本长度
global _replace_cursor: uint32 = 0       -- 替换框光标位置

-- 匹配结果（固定数组，零堆分配——公理 B）
global MatchPos = @record{ row: uint32, col: uint32 }
global _search_matches: [512]MatchPos
global _search_match_count: uint32 = 0
global _search_current: uint32 = 0       -- 当前高亮的匹配索引

-- =============================================================================
-- 语法高亮规则（多语言 — Phase 4.8-S4）
-- =============================================================================
