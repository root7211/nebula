-- =============================================================================
-- 窗口标题更新
-- =============================================================================
local function update_window_title(cursor_row: uint32, cursor_col: uint32): void
  local title: [256]uint8
  local fname: cstring
  if _editor_has_file then
    local last_slash: int32 = -1
    local fi: uint32 = 0
    while _editor_file_path[fi] ~= 0 and fi < 511 do
      if _editor_file_path[fi] == 47 then last_slash = (@int32)(fi) end
      fi = fi + 1
    end
    local start: uint32 = last_slash >= 0 and (@uint32)(last_slash + 1) or 0
    fname = (@cstring)(&_editor_file_path[start])
  else
    fname = "[untitled]"
  end
  local mod_mark: cstring = _editor_modified and " [+]" or ""
  snprintf((@cstring)(&title[0]), 255,
    "%s%s — Ln %d, Col %d — Nebula Editor",
    fname, mod_mark,
    (@int32)(cursor_row + 1), (@int32)(cursor_col + 1))
  glfwSetWindowTitle(_nebula_window, (@cstring)(&title[0]))
end

-- =============================================================================
-- Main
-- =============================================================================
local function main(): int32
  local renderer: NebulaRenderer
  local app: TextEditorApp

  if not nebula_init(&renderer, &app, "Nebula Editor", TextEditorApp_WIN_WIDTH, TextEditorApp_WIN_HEIGHT) then
    return 1
  end

  -- ★ Sugar: init_themed 替代手写 EditorBgVisual{...}（15行 → 1行）
  app.editor:init_themed(
    Vec2{x = 0.0, y = 0.0},
    Vec2{x = (@float32)(TextEditorApp_WIN_WIDTH), y = (@float32)(TextEditorApp_WIN_HEIGHT)},
    0.0)

  -- 加载文件
  if _editor_has_file then
    -- ★ Phase 4.8-S4: 根据文件扩展名自动检测语法高亮
    local path_len: uint32 = 0
    while _editor_file_path[path_len] ~= 0 and path_len < 511 do
      path_len = path_len + 1
    end
    _editor_highlight_id = nebula_highlight_detect_ext(&_editor_file_path[0], path_len)

    if app.editor.visual.multi_buf:load_file((@cstring)(&_editor_file_path[0])) then
      app.editor.line_count = app.editor.visual.multi_buf.line_count
      app.editor.cursor_row = 0
      app.editor.cursor_col = 0
      printf("nebula: loaded '%s' (%d lines, highlight=%d)\n",
        (@cstring)(&_editor_file_path[0]), (@int32)(app.editor.line_count),
        (@int32)(_editor_highlight_id))
    else
      printf("nebula: cannot open '%s', starting empty buffer\n",
        (@cstring)(&_editor_file_path[0]))
      _editor_has_file = false
    end
  else
    -- 无文件时默认使用 nelua 高亮（ID=1）
    _editor_highlight_id = 1
  end

  _editor_modified = false
  update_window_title(0, 0)

  printf("=== Phase 4.8-S2: Text Editor Demo ===\n")
  printf("  Features: syntax highlight | line numbers | undo/redo | file I/O | search\n")
  printf("  Keys:     Ctrl+S save | Ctrl+Z undo | Ctrl+Y redo | Ctrl+F find | Ctrl+H replace\n")

  local input: NebulaInputState
  local prev_time = glfwGetTime()
  local prev_undo_cursor: uint32 = 0
  local title_timer: float32 = 0.0

  while not nebula_should_close() do
    nebula_poll_events()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(_nebula_window, &input, dt)

    -- Ctrl+S 保存
    if input.key_pressed == NebulaKey.Save then
      if _editor_has_file then
        if app.editor.visual.multi_buf:save_file((@cstring)(&_editor_file_path[0])) then
          _editor_modified = false
          prev_undo_cursor = app.editor.undo_stack.cursor
          printf("nebula: saved '%s' (%d lines)\n",
            (@cstring)(&_editor_file_path[0]), (@int32)(app.editor.line_count))
          update_window_title(app.editor.cursor_row, app.editor.cursor_col)
        else
          printf("nebula: FAILED to save '%s'\n", (@cstring)(&_editor_file_path[0]))
        end
      else
        printf("nebula: no file path (pass file as command-line argument)\n")
      end
    end

    -- ★ Phase 4.8-S2: Ctrl+F / Ctrl+H 搜索栏切换
    if input.key_pressed == NebulaKey.Find then
      _search_active = not _search_active
      _search_replace = false
      if _search_active then
        _search_len = 0; _search_cursor = 0
        _search_match_count = 0; _search_current = 0
      end
    end
    if input.key_pressed == NebulaKey.Replace then
      _search_active = not _search_active
      _search_replace = true
      if _search_active then
        _search_len = 0; _search_cursor = 0
        _replace_len = 0; _replace_cursor = 0
        _search_match_count = 0; _search_current = 0
      end
    end

    -- ★ Phase 4.8-S2: 搜索栏激活时拦截键盘输入
    if _search_active then
      -- Escape 关闭搜索栏
      if input.key_pressed == NebulaKey.Escape then
        _search_active = false
        _search_replace = false
      -- Enter / F3 → 跳转到下一个匹配
      elseif input.key_pressed == NebulaKey.FindNext or input.key_pressed == NebulaKey.Enter then
        if _search_match_count > 0 then
          _search_current = (_search_current + 1) % _search_match_count
          search_goto_current(&app)
        end
      -- Backspace → 删除搜索框字符
      elseif input.key_pressed == NebulaKey.Backspace then
        if _search_cursor > 0 then
          _search_cursor = _search_cursor - 1
          _search_len = _search_len - 1
          -- 移除字符：左移
          local si: uint32 = _search_cursor
          while si < _search_len do
            _search_buf[si] = _search_buf[si + 1]
            si = si + 1
          end
          scan_matches(&app.editor.visual.multi_buf)
        elseif _search_replace and _replace_cursor > 0 then
          -- 在替换模式下，如果搜索框空了，backspace 操作替换 buffer
          _replace_cursor = _replace_cursor - 1
          _replace_len = _replace_len - 1
          local ri: uint32 = _replace_cursor
          while ri < _replace_len do
            _replace_buf[ri] = _replace_buf[ri + 1]
            ri = ri + 1
          end
        end
      -- Tab → 切换焦点到替换框（仅在替换模式下）
      elseif input.key_pressed == NebulaKey.Tab and _search_replace then
        -- 简单切换：如果光标在搜索框→移到替换框，反之亦然
        -- 用一个 flag 判断（简化：用 _replace_cursor > 0 来推断）
        -- 实际用 _search_cursor / _replace_cursor 本身即可
      -- 字符输入 → 写入搜索/替换 buffer
      else
        -- 检查 char_input
        local ci: uint8 = 0
        while ci < input.char_count do
          local ch: uint32 = input.char_input[ci]
          if ch >= 32 and ch < 127 then  -- 仅 ASCII 可打印字符
            if _search_replace and _replace_cursor < 255 then
              -- 写入替换 buffer
              if _replace_cursor < _replace_len then
                local ri2: uint32 = _replace_len
                while ri2 > _replace_cursor do
                  _replace_buf[ri2] = _replace_buf[ri2 - 1]
                  ri2 = ri2 - 1
                end
              end
              _replace_buf[_replace_cursor] = (@uint8)(ch)
              _replace_cursor = _replace_cursor + 1
              _replace_len = _replace_len + 1
            elseif _search_cursor < 255 then
              -- 写入搜索 buffer
              if _search_cursor < _search_len then
                local si2: uint32 = _search_len
                while si2 > _search_cursor do
                  _search_buf[si2] = _search_buf[si2 - 1]
                  si2 = si2 - 1
                end
              end
              _search_buf[_search_cursor] = (@uint8)(ch)
              _search_cursor = _search_cursor + 1
              _search_len = _search_len + 1
              scan_matches(&app.editor.visual.multi_buf)
              -- 自动跳转到第一个匹配
              if _search_match_count > 0 then
                _search_current = 0
                search_goto_current(&app)
              end
            end
          end
          ci = ci + 1
        end
      end
      -- 阻止键盘事件传播到 editor
      input.key_pressed = NebulaKey.None
      input.char_count = 0
    end

    -- ★ Phase 4.8-S2: Ctrl+R 替换当前 / Ctrl+Shift+A 替换全部（搜索栏激活时）
    if _search_active and _search_replace then
      if input.key_pressed == NebulaKey.Replace then
        search_replace_current(&app, &app.editor.visual.multi_buf)
      end
    end

    -- 修改检测
    if app.editor.undo_stack.cursor ~= prev_undo_cursor then
      _editor_modified = true
    end

    app.editor.visual.content_height = (@float32)(app.editor.line_count) * (CELL_H + 2.0)

    title_timer = title_timer + dt
    if title_timer > 0.2 then
      title_timer = 0.0
      update_window_title(app.editor.cursor_row, app.editor.cursor_col)
    end

    nebula_frame_render(&renderer, &app, &input, dt, 0.04, 0.04, 0.06)
  end

  app:deinit()
  nebula_shutdown(&renderer)
  printf("nebula: text editor clean exit\n")
  return 0
end

main()
