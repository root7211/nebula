-- DenseText 管线（行号 + 编辑区，手写 Producer 需显式声明）
global LineNumDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("LineNumDenseVisual", { text_mode = "dense", max_chars = 1024 })

global EditAreaDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("EditAreaDenseVisual", { text_mode = "dense", max_chars = 8192 })

global StatusBarDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("StatusBarDenseVisual", { text_mode = "dense", max_chars = 256 })

-- ★ Phase 4.8-S2: 搜索栏 DenseText（固定布局 flex_basis=24）
global SearchBarDenseVisual = @record{ pos: Vec2, size: Vec2 }
## nebula_component("SearchBarDenseVisual", { text_mode = "dense", max_chars = 256 })

-- =============================================================================
-- ★ Sugar: 内置行号 Producer（替代 ~53 行手写 fill_line_nums）
-- =============================================================================
## nebula_builtin_line_nums("editor", { cell_w = 10.0, cell_h = 16.0, rows = 50 })

-- =============================================================================
-- 编辑区 Producer（语法高亮 — 领域特定，无法通用化）
-- =============================================================================
global function fill_edit_area(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local editor = &app.editor
  local mb = &editor.visual.multi_buf
  local origin_x: float32 = app.dense_layout_edit_area_x
  local origin_y: float32 = app.dense_layout_edit_area_y + 4.0
  local idx: uint32 = 0
  local scroll_row: uint32 = (@uint32)(editor.scroll_offset_y / (CELL_H + 2.0))
  local visible_rows: uint32 = EDIT_ROWS
  local hl_colors: [512]uint32

  -- ★ Phase 4.8 S1: compute ordered selection bounds
  local sel_active: boolean = (editor.sel_anchor_row ~= editor.cursor_row) or (editor.sel_anchor_col ~= editor.cursor_col)
  local sel_sr: uint32 = 0
  local sel_sc: uint32 = 0
  local sel_er: uint32 = 0
  local sel_ec: uint32 = 0
  if sel_active then
    if editor.sel_anchor_row < editor.cursor_row or (editor.sel_anchor_row == editor.cursor_row and editor.sel_anchor_col < editor.cursor_col) then
      sel_sr = editor.sel_anchor_row; sel_sc = editor.sel_anchor_col
      sel_er = editor.cursor_row; sel_ec = editor.cursor_col
    else
      sel_sr = editor.cursor_row; sel_sc = editor.cursor_col
      sel_er = editor.sel_anchor_row; sel_ec = editor.sel_anchor_col
    end
  end

  local row: uint32 = 0
  while row < visible_rows and idx < max do
    local buf_row = row + scroll_row
    local is_cursor_line = (buf_row == editor.cursor_row)
    local bg = is_cursor_line and nebula_theme_bg_cursor_line() or nebula_theme_bg_normal()

    if buf_row < mb.line_count then
      local line = mb:get_line(buf_row)
      local flat: [512]uint8
      local line_len = line:flatten(&flat[0], 511)
      nebula_highlight_dispatch(_editor_highlight_id, &flat[0], (@uint32)(line_len), nebula_theme_fg_normal(), &hl_colors[0])

      local cursor_byte: int32 = -1
      if is_cursor_line then cursor_byte = (@int32)(editor.cursor_col) end

      local byte_i: uint32 = 0
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        local ch: uint32 = 32
        local fg = nebula_theme_fg_normal()
        local this_bg = bg
        if byte_i < line_len then
          ch = (@uint32)(flat[byte_i])
          fg = hl_colors[byte_i]
          if ch >= 0xC0 and ch <= 0xDF then ch = 0x3F; byte_i = byte_i + 1
          elseif ch >= 0xE0 and ch <= 0xEF then ch = 0x3F; byte_i = byte_i + 2
          elseif ch >= 0xF0 then ch = 0x3F; byte_i = byte_i + 3 end
          byte_i = byte_i + 1
        end
        -- ★ Phase 4.8 S1: selection background override
        if sel_active then
          local in_sel: boolean = false
          if buf_row > sel_sr and buf_row < sel_er then
            in_sel = true  -- entire row is selected
          elseif buf_row == sel_sr and buf_row == sel_er then
            -- single-row selection
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte >= sel_sc and prev_byte < sel_ec then in_sel = true end
          elseif buf_row == sel_sr then
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte >= sel_sc then in_sel = true end
          elseif buf_row == sel_er then
            local prev_byte = byte_i > 0 and (byte_i - 1) or 0
            if prev_byte < sel_ec then in_sel = true end
          end
          if in_sel then this_bg = nebula_theme_bg_selected() end
        end
        if cursor_byte >= 0 and (@uint32)(cursor_byte) == byte_i - 1 then
          this_bg = nebula_theme_bg_cursor(); fg = nebula_theme_fg_cursor()
        end
        -- ★ Phase 4.8-S2: search match highlight (公理 C: GPU direct)
        if _search_active and _search_len > 0 then
          local prev_b: uint32 = byte_i > 0 and (byte_i - 1) or 0
          local mi: uint32 = 0
          while mi < _search_match_count do
            local mp = _search_matches[mi]
            if mp.row == buf_row and prev_b >= mp.col and prev_b < mp.col + _search_len then
              if mi == _search_current then
                this_bg = nebula_theme_bg_search_current()
              else
                this_bg = nebula_theme_bg_search_match()
              end
            end
            mi = mi + 1
          end
        end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, ch, origin_x, origin_y, CELL_W, CELL_H, fg, this_bg)
        idx = idx + 1; col = col + 1
      end
      while col < EDIT_COLS and idx < max do
        local this_bg = bg
        -- ★ Phase 4.8 S1: selection bg for trailing empty cells
        if sel_active then
          if buf_row > sel_sr and buf_row < sel_er then
            this_bg = nebula_theme_bg_selected()
          elseif buf_row == sel_sr and buf_row ~= sel_er and byte_i >= sel_sc then
            this_bg = nebula_theme_bg_selected()
          end
        end
        if cursor_byte >= 0 and byte_i == line_len and col == byte_i then this_bg = nebula_theme_bg_cursor() end
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, CELL_W, CELL_H, nebula_theme_fg_normal(), this_bg)
        idx = idx + 1; col = col + 1
      end
    else
      local col: uint32 = 0
      while col < EDIT_COLS and idx < max do
        nebula_dense_grid_fill_instance(&instances[idx], row, col, 32, origin_x, origin_y, CELL_W, CELL_H, nebula_theme_fg_normal(), nebula_theme_bg_normal())
        idx = idx + 1; col = col + 1
      end
    end
    row = row + 1
  end
  $count = idx
end

-- =============================================================================
-- 状态栏 Producer（Phase 4.8-S3）
-- 显示: Ln {row}, Col {col} | UTF-8 | LF | {lines} lines | {modified}
-- =============================================================================
global function fill_status_bar(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local editor = &app.editor
  local origin_x: float32 = app.dense_layout_status_bar_x
  local origin_y: float32 = app.dense_layout_status_bar_y + 4.0
  local bg = nebula_theme_bg_status()
  local fg = nebula_theme_fg_status()
  local fg_accent = nebula_theme_fg_status_accent()
  local idx: uint32 = 0
  local STATUS_COLS <comptime> = 128

  -- Format status string into a buffer
  local buf: [256]uint8
  local row_1 = (@int32)(editor.cursor_row + 1)
  local col_1 = (@int32)(editor.cursor_col + 1)
  local lines = (@int32)(editor.visual.multi_buf.line_count)
  local mod_str: cstring = _editor_modified and " [+]" or ""
  local file_str: cstring
  if _editor_has_file then
    -- Extract filename from path
    local last_slash: int32 = -1
    local fi: uint32 = 0
    while _editor_file_path[fi] ~= 0 and fi < 511 do
      if _editor_file_path[fi] == 47 then last_slash = (@int32)(fi) end
      fi = fi + 1
    end
    local start: uint32 = last_slash >= 0 and (@uint32)(last_slash + 1) or 0
    file_str = (@cstring)(&_editor_file_path[start])
  else
    file_str = "[untitled]"
  end

  local slen = snprintf((@cstring)(&buf[0]), 255,
    " %s%s  |  Ln %d, Col %d  |  %d lines  |  UTF-8  |  LF",
    file_str, mod_str, row_1, col_1, lines)
  if slen < 0 then slen = 0 end
  if slen > 255 then slen = 255 end
  local str_len: uint32 = (@uint32)(slen)

  -- Render the status bar (single row)
  local col: uint32 = 0
  while col < STATUS_COLS and idx < max do
    local ch: uint32 = 32
    local cell_fg = fg
    if col < str_len then
      ch = (@uint32)(buf[col])
      -- Accent color for Ln/Col values (digits after "Ln " and "Col ")
    end
    nebula_dense_grid_fill_instance(&instances[idx], 0, col, ch, origin_x, origin_y, CELL_W, CELL_H, cell_fg, bg)
    idx = idx + 1; col = col + 1
  end
  $count = idx
end

-- =============================================================================
-- ★ Phase 4.8-S2: 匹配扫描（朴素 O(n*m)，文件小够用）
-- =============================================================================
global function scan_matches(mb: auto): void
  _search_match_count = 0
  _search_current = 0
  if _search_len == 0 then return end

  local total_lines: uint32 = mb.line_count
  local row: uint32 = 0
  while row < total_lines and _search_match_count < 512 do
    local ln = mb:get_line(row)
    local flat: [256]uint8
    local line_len = ln:flatten(&flat[0], 255)
    -- 朴素滑窗匹配
    local end_pos: uint32 = line_len > _search_len and (line_len - _search_len + 1) or 0
    local ci: uint32 = 0
    while ci < end_pos and _search_match_count < 512 do
      local match: boolean = true
      local k: uint32 = 0
      while k < _search_len do
        if flat[ci + k] ~= _search_buf[k] then match = false; break end
        k = k + 1
      end
      if match then
        _search_matches[_search_match_count].row = row
        _search_matches[_search_match_count].col = ci
        _search_match_count = _search_match_count + 1
        ci = ci + _search_len  -- 跳过已匹配部分（不重叠匹配）
      else
        ci = ci + 1
      end
    end
    row = row + 1
  end
end

-- ★ Phase 4.8-S2: 跳转到当前匹配（更新光标位置）
local function search_goto_current(app: auto): void
  if _search_match_count == 0 then return end
  if _search_current >= _search_match_count then _search_current = 0 end
  local m = _search_matches[_search_current]
  app.editor.cursor_row = m.row
  app.editor.cursor_col = m.col
  -- 确保匹配行可见（更新 scroll_offset_y）
  local visible_top = app.editor.scroll_offset_y
  local visible_bot = visible_top + app.editor.visual.size.y / 18.0
  if (@float32)(m.row) < visible_top or (@float32)(m.row) > visible_bot then
    app.editor.scroll_offset_y = (@float32)(m.row) * 18.0 - app.editor.visual.size.y * 0.5
    if app.editor.scroll_offset_y < 0.0 then app.editor.scroll_offset_y = 0.0 end
  end
end

local function search_replace_current(app: auto, mb: auto): void
  if _search_match_count == 0 or _replace_len == 0 then return end
  if _search_current >= _search_match_count then return end
  local m = _search_matches[_search_current]
  local ln = mb:get_line(m.row)
  -- 删除匹配区域 [m.col, m.col + _search_len)
  ln:delete_range(m.col, m.col + _search_len)
  -- 插入替换文本
  local ins_i: uint32 = 0
  while ins_i < _replace_len do
    ln:insert_char(_replace_buf[ins_i])
    ins_i = ins_i + 1
  end
  -- 标记已修改
  _editor_modified = true
  -- 重新扫描
  scan_matches(mb)
  if _search_current >= _search_match_count and _search_match_count > 0 then
    _search_current = _search_match_count - 1
  end
  search_goto_current(app)
end

local function search_replace_all(app: auto, mb: auto): void
  if _search_match_count == 0 or _replace_len == 0 then return end
  local count: uint32 = _search_match_count
  -- 从后往前替换，避免位置偏移
  local i: int32 = (@int32)(count) - 1
  while i >= 0 do
    local m = _search_matches[(@uint32)(i)]
    local ln = mb:get_line(m.row)
    ln:delete_range(m.col, m.col + _search_len)
    local ins_j: uint32 = 0
    while ins_j < _replace_len do
      ln:insert_char(_replace_buf[ins_j])
      ins_j = ins_j + 1
    end
    i = i - 1
  end
  _editor_modified = true
  scan_matches(&app.editor.visual.multi_buf)
end

-- =============================================================================
-- ★ Phase 4.8-S2: 搜索栏 Producer
-- 搜索栏始终占 flex_basis=24，通过 Producer 切换渲染内容
-- =============================================================================
global function fill_search_bar(
  app: auto, instances: *[0]DenseCharInstance, count: *uint32, max: uint32
): void
  local origin_x: float32 = app.dense_layout_search_bar_x
  local origin_y: float32 = app.dense_layout_search_bar_y + 4.0
  local bg = nebula_theme_bg_status()
  local fg = nebula_theme_fg_status()
  local fg_label = nebula_theme_fg_search_label()
  local idx: uint32 = 0
  local SB_COLS <comptime> = 128

  if not _search_active then
    -- 隐藏状态：填充编辑区同色背景（视觉融入）
    local hide_bg = nebula_theme_bg_normal()
    local col: uint32 = 0
    while col < SB_COLS and idx < max do
      nebula_dense_grid_fill_instance(&instances[idx], 0, col, 32, origin_x, origin_y, CELL_W, CELL_H, hide_bg, hide_bg)
      idx = idx + 1; col = col + 1
    end
  else
    -- 显示状态：渲染搜索框
    -- 格式: " Find: {query}  [{current}/{total}]"  或  " Replace: {query} → {replacement}  [{c}/{t}]"
    local buf: [256]uint8
    local slen: int32 = 0
    if _search_replace then
      -- 替换模式
      local repl_str: [256]uint8
      local ri: uint32 = 0
      while ri < _replace_len and ri < 255 do repl_str[ri] = _replace_buf[ri]; ri = ri + 1 end
      repl_str[ri] = 0
      local qstr: [256]uint8
      local qi: uint32 = 0
      while qi < _search_len and qi < 255 do qstr[qi] = _search_buf[qi]; qi = qi + 1 end
      qstr[qi] = 0
      slen = snprintf((@cstring)(&buf[0]), 255,
        " Replace: %s -> %s  [%d/%d]",
        (@cstring)(&qstr[0]), (@cstring)(&repl_str[0]),
        (@int32)(_search_current + 1), (@int32)(_search_match_count))
    else
      -- 搜索模式
      local qstr: [256]uint8
      local qi: uint32 = 0
      while qi < _search_len and qi < 255 do qstr[qi] = _search_buf[qi]; qi = qi + 1 end
      qstr[qi] = 0
      slen = snprintf((@cstring)(&buf[0]), 255,
        " Find: %s  [%d/%d]",
        (@cstring)(&qstr[0]),
        (@int32)(_search_current + 1), (@int32)(_search_match_count))
    end
    if slen < 0 then slen = 0 end
    if slen > 255 then slen = 255 end
    local str_len: uint32 = (@uint32)(slen)

    -- 搜索栏标签部分（" Find:" 或 " Replace:"）用 label 颜色
    local label_end: uint32 = 0
    if _search_replace then label_end = 10  -- " Replace: " 长度
    else label_end = 7 end                   -- " Find: " 长度

    local col: uint32 = 0
    while col < SB_COLS and idx < max do
      local ch: uint32 = 32
      local cell_fg = fg
      if col < str_len then
        ch = (@uint32)(buf[col])
        if col < label_end then cell_fg = fg_label end
      end
      -- 光标位置高亮
      local cell_bg = bg
      local cursor_pos = label_end + _search_cursor
      if col == cursor_pos then
        cell_bg = nebula_theme_bg_cursor()
        cell_fg = nebula_theme_fg_cursor()
      end
      nebula_dense_grid_fill_instance(&instances[idx], 0, col, ch, origin_x, origin_y, CELL_W, CELL_H, cell_fg, cell_bg)
      idx = idx + 1; col = col + 1
    end
  end
  $count = idx
end

-- =============================================================================
-- App 声明（嵌套布局：editor_body = row{ line_nums, edit_area } + status_bar）
-- =============================================================================
