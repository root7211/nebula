-- =============================================================================
-- layout_demo.nelua
-- Nebula GUI Compiler — Phase 3.11
--
-- ★ Phase 3.11: Layout-App 统一注册（原语 7 完整实现）
--   · 删除独立的 nebula_layout_node / nebula_layout_solve 调用块（约 95 行）
--   · 删除 get_layout_pos / get_layout_size 辅助函数
--   · 布局约束通过 nebula_app_set_root_layout + layout 字段直接声明
--   · nebula_app_end 自动解算坐标，注入到 LayoutApp:init
--   · nebula_init / nebula_should_close / nebula_shutdown 消除 GLFW/WGPU 样板
--   · main() 收缩到 ~30 行
--
-- 布局结构（与 Phase 3.9 完全相同，但声明方式统一）：
--   Root (column, center, 800x600)
--   └── Card (column, start, padding=24, gap=12, 400xauto)
--       ├── Header Row (row, space_between, height=36)
--       │   ├── Title Rect（120x36）
--       │   └── Close Button（36x36）
--       ├── Email Input（stretch x 44）
--       ├── Password Input（stretch x 44）
--       └── Button Row (row, center, gap=12, height=48)
--           ├── Cancel Button（140x48）
--           └── Login Button（180x48）
-- =============================================================================
## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- 视觉规格 + 注解 + 派生
-- =============================================================================

-- ---- 卡片背景 ----
global CardVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
}
##[[ nebula_annotate("CardVisual", { states={"default"}, primitives={}, transitions={} }) ]]
## nebula_derive("CardVisual")

-- ---- 标题占位矩形 ----
global SimpleRectVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color: Color,
  hovered_bg_color: Color,
}
##[[
nebula_annotate("SimpleRectVisual", {
  states     = {"default", "hovered"},
  primitives = {"hoverable"},
  transitions = {
    {from="default", to="hovered", on="hover_enter"},
    {from="hovered", to="default", on="hover_leave"},
  },
})
]]
## nebula_derive("SimpleRectVisual")

-- ---- 输入框 ----
global InputVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  focused_bg_color:     Color,
  focused_border_color: Color,
  focused_border_width: float32,
}
##[[
nebula_annotate("InputVisual", {
  states     = {"default", "hovered", "focused"},
  primitives = {"hoverable", "clickable", "focusable"},
  transitions = {
    {from="default", to="hovered",  on="hover_enter"},
    {from="hovered", to="default",  on="hover_leave"},
    {from="default", to="focused",  on="focus_gain"},
    {from="hovered", to="focused",  on="focus_gain"},
    {from="focused", to="default",  on="focus_lose"},
  },
})
]]
## nebula_derive("InputVisual")

-- ---- 按钮 ----
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", on="hover_enter"},
    {from="hovered", to="default", on="hover_leave"},
    {from="hovered", to="pressed", on="press"},
    {from="pressed", to="hovered", on="release"},
  },
})
]]
## nebula_derive("ButtonVisual")

-- =============================================================================
-- ★ Phase 3.11: Layout-App 统一注册
--   · nebula_app_set_root_layout 声明根节点布局约束
--   · 每个组件通过 layout 字段携带自身的布局约束
--   · 嵌套容器通过 layout.children 声明子节点布局
--   · nebula_app_end 自动解算所有坐标，注入到 LayoutApp:init
-- =============================================================================
##[[
  -- ★ Phase 3.11: 声明根节点布局（column 方向，居中对齐，视口 800x600）
  nebula_app_set_root_layout("LayoutApp", {
    direction = "column",
    justify   = "center",
    align     = "center",
    width     = 800,
    height    = 600,
    gap       = 0,
  })

  nebula_app_begin("LayoutApp")
    -- 卡片容器：400xauto，内部 column 布局，padding=24，gap=12
    -- 子组件通过 layout.children 声明，坐标由布局引擎递归解算
    nebula_app_register_component("card", "CardVisual", {
      layout = {
        width     = 400,
        direction = "column",
        justify   = "start",
        align     = "stretch",
        padding   = 24,
        gap       = 12,
        children  = {
          -- Header Row：row 方向，space_between，高度 36
          { name="header_row_placeholder", width=400-24*2, height=36,
            direction="row", justify="space_between", align="center",
            children = {
              { name="title_rect",  width=120, height=36 },
              { name="close_btn",   width=36,  height=36 },
            },
          },
          -- 输入框：stretch 宽度（由父节点 align=stretch 决定），高度 44
          { name="email_input",    height=44 },
          { name="password_input", height=44 },
          -- Button Row：row 方向，居中，gap=12，高度 48
          { name="button_row_placeholder", height=48,
            direction="row", justify="center", align="center", gap=12,
            children = {
              { name="cancel_btn", width=140, height=48 },
              { name="login_btn",  width=180, height=48 },
            },
          },
        },
      },
    })
    nebula_app_register_component("title_rect",     "SimpleRectVisual")
    nebula_app_register_component("close_btn",      "ButtonVisual")
    nebula_app_register_component("email_input",    "InputVisual", {component_id=1})
    nebula_app_register_component("password_input", "InputVisual", {component_id=2})
    nebula_app_register_component("cancel_btn",     "ButtonVisual")
    nebula_app_register_component("login_btn",      "ButtonVisual")
  nebula_app_end()
]]
## nebula_derive_app("LayoutApp")

-- =============================================================================
-- 主程序
-- ★ Phase 3.11: 使用 nebula_init / nebula_should_close / nebula_shutdown
--   消除 GLFW/WGPU 样板代码，main() 收缩到 ~30 行
-- ★ WASM fix: 添加 emscripten_set_main_loop 支持，避免阻塞式循环冻结浏览器
-- =============================================================================

-- ★ WASM: 全局变量必须在顶层作用域声明（Nelua 限制）
## if NEBULA_TARGET == 'wasm' then
global _wasm_layout_renderer: *NebulaRenderer = nilptr
global _wasm_layout_app: *LayoutApp = nilptr
global _wasm_layout_input: NebulaInputState
global _wasm_layout_prev_time: float64 = 0.0

global function _wasm_layout_frame(): void
  glfwPollEvents()
  local now = glfwGetTime()
  local dt = (@float32)(now - _wasm_layout_prev_time)
  _wasm_layout_prev_time = now
  nebula_collect_input(_nebula_window, &_wasm_layout_input, dt)
  nebula_frame_render(_wasm_layout_renderer, _wasm_layout_app, &_wasm_layout_input, dt, 0.09, 0.09, 0.10)
end
## end

local function main(): int32
  local renderer: NebulaRenderer
  local app: LayoutApp

  -- ★ Phase 3.11: 一行初始化（封装 GLFW + WGPU + App:init）
  if not nebula_init(&renderer, &app, "Nebula Phase 3.11 — Layout Demo", WIN_W, WIN_H) then
    printf("nebula: init failed\n")
    return 1
  end

  -- 初始化各组件的视觉规格（仅颜色/半径等外观属性；pos/size 由布局引擎注入）
  app.card:init(CardVisual{
    radius = 16.0,
    default_bg_color     = Color{ r=0.13, g=0.13, b=0.15, a=1.0 },
    default_border_color = Color{ r=0.25, g=0.25, b=0.28, a=1.0 },
    default_border_width = 1.0,
  })
  app.title_rect:init(SimpleRectVisual{
    radius = 6.0,
    default_bg_color = Color{ r=0.25, g=0.25, b=0.30, a=1.0 },
    hovered_bg_color = Color{ r=0.35, g=0.35, b=0.42, a=1.0 },
  })
  app.close_btn:init(ButtonVisual{
    radius = 6.0,
    default_bg_color     = Color{ r=0.20, g=0.20, b=0.22, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.30, b=0.34, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.50, g=0.20, b=0.20, a=1.0 },
    hovered_border_color = Color{ r=0.70, g=0.30, b=0.30, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.70, g=0.15, b=0.15, a=1.0 },
    pressed_border_color = Color{ r=0.90, g=0.40, b=0.40, a=1.0 },
    pressed_border_width = 2.0,
  })
  app.email_input:init(InputVisual{
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  app.email_input.component_id = 1
  app.password_input:init(InputVisual{
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  app.password_input.component_id = 2
  app.cancel_btn:init(ButtonVisual{
    radius = 8.0,
    default_bg_color     = Color{ r=0.20, g=0.20, b=0.22, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.28, g=0.28, b=0.32, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.15, g=0.15, b=0.18, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.60, b=0.70, a=1.0 },
    pressed_border_width = 2.0,
  })
  app.login_btn:init(ButtonVisual{
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.44, b=0.90, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.52, b=1.00, a=0.6 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.30, g=0.52, b=1.00, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.70, b=1.00, a=0.8 },
    hovered_border_width = 0.0,
    pressed_bg_color     = Color{ r=0.15, g=0.32, b=0.75, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.80, b=1.00, a=1.0 },
    pressed_border_width = 2.0,
  })

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  ## if NEBULA_TARGET == 'wasm' then
  -- Web: 设置全局状态，注册帧回调，交出控制权
  _wasm_layout_renderer = &renderer
  _wasm_layout_app = &app
  _wasm_layout_prev_time = glfwGetTime()
  emscripten_set_main_loop(_wasm_layout_frame, 0, 1)
  ## else
  -- Native: 传统阻塞循环
  while not nebula_should_close() do
    nebula_poll_events()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(_nebula_window, &input, dt)
    nebula_frame_render(&renderer, &app, &input, dt, 0.09, 0.09, 0.10)
  end
  ## end

  -- ★ Phase 3.11: 一行清理
  nebula_shutdown(&renderer)
  printf("nebula: clean exit\n")
  return 0
end
main()
