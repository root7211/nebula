-- =============================================================================
-- layout_demo.nelua
-- Nebula GUI Compiler — Phase 3.9
--
-- ★ Phase 3.9 重写：从 Phase 3.1 手动渲染循环迁移到 App 编排体系
--
-- 与 Phase 3.1 的对比：
--   · 删除手动 7 个 Pipeline 声明和初始化（由 nebula_derive_app 自动生成）
--   · 删除手动 7 个 Context:update 调用（由 LayoutApp:update 自动处理）
--   · 删除手动 7 个 to_uniforms + upload + draw_instanced 调用
--   · 删除约 60 行 WGPU 渲染样板代码（由 nebula_frame_render 封装）
--   · 主循环收缩到 3 行（glfwPollEvents + nebula_collect_input + nebula_frame_render）
--   · 保留编译期 Flexbox 布局解算（原语 7 的先行实践）
--
-- 布局结构：
--   Root (column, center)
--   └── Card (column, start, padding=24, gap=12)
--       ├── Header Row (row, space_between)
--       │   ├── Title Rect（占位）
--       │   └── Close Button
--       ├── Email Input
--       ├── Password Input
--       └── Button Row (row, center, gap=12)
--           ├── Cancel Button
--           └── Login Button
-- =============================================================================
## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- Phase 3.1: 编译期 Flexbox 布局声明与解算
-- =============================================================================
##[[
  local root = nebula_layout_node({
    name      = "root",
    direction = "column",
    justify   = "center",
    align     = "center",
    width     = 800,
    height    = 600,
    children  = {
      nebula_layout_node({
        name      = "card",
        type_name = "CardVisual",
        direction = "column",
        justify   = "start",
        align     = "stretch",
        padding   = 24,
        gap       = 12,
        width     = 400,
        children  = {
          nebula_layout_node({
            name      = "header_row",
            direction = "row",
            justify   = "space_between",
            align     = "center",
            height    = 36,
            children  = {
              nebula_layout_node({
                name      = "title_rect",
                type_name = "SimpleRectVisual",
                width     = 120,
                height    = 36,
              }),
              nebula_layout_node({
                name      = "close_btn",
                type_name = "ButtonVisual",
                width     = 36,
                height    = 36,
              }),
            },
          }),
          nebula_layout_node({
            name      = "email_input",
            type_name = "InputVisual",
            height    = 44,
          }),
          nebula_layout_node({
            name      = "password_input",
            type_name = "InputVisual",
            height    = 44,
          }),
          nebula_layout_node({
            name      = "button_row",
            direction = "row",
            justify   = "center",
            align     = "center",
            gap       = 12,
            height    = 48,
            children  = {
              nebula_layout_node({
                name      = "cancel_btn",
                type_name = "ButtonVisual",
                width     = 140,
                height    = 48,
              }),
              nebula_layout_node({
                name      = "login_btn",
                type_name = "ButtonVisual",
                width     = 180,
                height    = 48,
              }),
            },
          }),
        },
      }),
    },
  })

  nebula_layout_solve(root, 800, 600)

  print("[layout] Phase 3.9 — Compile-time Flexbox layout solved:")
  nebula_layout_dump(root)

  local layout_results = nebula_layout_collect(root)

  function get_layout_pos(name)
    local r = layout_results[name]
    assert(r, "layout: node '" .. name .. "' not found in results")
    return r.x, r.y
  end

  function get_layout_size(name)
    local r = layout_results[name]
    assert(r, "layout: node '" .. name .. "' not found in results")
    return r.w, r.h
  end
]]

-- =============================================================================
-- 视觉规格 + 注解 + 派生
-- =============================================================================

-- ---- 卡片背景 ----
global CardVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
}
##[[ nebula_annotate("CardVisual", { states={"default"}, primitives={}, transitions={} }) ]]
## nebula_derive("CardVisual")

-- ---- 标题占位矩形 ----
global SimpleRectVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color: Color,
  hovered_bg_color: Color,
}
##[[
nebula_annotate("SimpleRectVisual", {
  states     = {"default", "hovered"},
  primitives = {"hoverable"},
  transitions = {
    {from="default", to="hovered", on="hover_enter"},
    {from="hovered", to="default", on="hover_leave"},
  },
})
]]
## nebula_derive("SimpleRectVisual")

-- ---- 输入框 ----
global InputVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  focused_bg_color:     Color,
  focused_border_color: Color,
  focused_border_width: float32,
}
##[[
nebula_annotate("InputVisual", {
  states     = {"default", "hovered", "focused"},
  primitives = {"hoverable", "clickable", "focusable"},
  transitions = {
    {from="default", to="hovered",  on="hover_enter"},
    {from="hovered", to="default",  on="hover_leave"},
    {from="default", to="focused",  on="focus_gain"},
    {from="hovered", to="focused",  on="focus_gain"},
    {from="focused", to="default",  on="focus_lose"},
  },
})
]]
## nebula_derive("InputVisual")

-- ---- 按钮 ----
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", on="hover_enter"},
    {from="hovered", to="default", on="hover_leave"},
    {from="hovered", to="pressed", on="press"},
    {from="pressed", to="hovered", on="release"},
  },
})
]]
## nebula_derive("ButtonVisual")

-- =============================================================================
-- ★ Phase 3.9: 使用 nebula_derive_app 宏声明并派生 LayoutApp
--   · 7 个组件全部纳入 App 编排，自动生成 Pipeline + update + draw
--   · 编译期 Flexbox 布局解算结果将在 main() 中注入到各组件的 init 调用中
-- =============================================================================
##[[
  nebula_app_begin("LayoutApp")
    nebula_app_register_component("card",           "CardVisual")
    nebula_app_register_component("title_rect",     "SimpleRectVisual")
    nebula_app_register_component("close_btn",      "ButtonVisual")
    nebula_app_register_component("email_input",    "InputVisual", {component_id=1})
    nebula_app_register_component("password_input", "InputVisual", {component_id=2})
    nebula_app_register_component("cancel_btn",     "ButtonVisual")
    nebula_app_register_component("login_btn",      "ButtonVisual")
  nebula_app_end()
]]
## nebula_derive_app("LayoutApp")

-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H,
    "Nebula Phase 3.9 — Layout Demo (Compile-Time Flexbox)", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end

  nebula_input_install_callbacks(window)

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  -- LayoutApp:init 自动初始化所有 7 个 Pipeline + 内嵌 FrameArena
  local app: LayoutApp
  if not app:init(&renderer, WIN_W, WIN_H) then return 1 end

  -- ★ Phase 3.9 + Phase 3.1: 使用编译期 Flexbox 解算的坐标初始化各组件
  app.card:init(CardVisual{
    pos    = Vec2{ x = #[get_layout_pos("card")]#,  y = #[select(2, get_layout_pos("card"))]# },
    size   = Vec2{ x = #[get_layout_size("card")]#, y = #[select(2, get_layout_size("card"))]# },
    radius = 16.0,
    default_bg_color     = Color{ r=0.13, g=0.13, b=0.15, a=1.0 },
    default_border_color = Color{ r=0.25, g=0.25, b=0.28, a=1.0 },
    default_border_width = 1.0,
  })

  app.title_rect:init(SimpleRectVisual{
    pos    = Vec2{ x = #[get_layout_pos("title_rect")]#,  y = #[select(2, get_layout_pos("title_rect"))]# },
    size   = Vec2{ x = #[get_layout_size("title_rect")]#, y = #[select(2, get_layout_size("title_rect"))]# },
    radius = 6.0,
    default_bg_color = Color{ r=0.25, g=0.25, b=0.30, a=1.0 },
    hovered_bg_color = Color{ r=0.35, g=0.35, b=0.42, a=1.0 },
  })

  app.close_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("close_btn")]#,  y = #[select(2, get_layout_pos("close_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("close_btn")]#, y = #[select(2, get_layout_size("close_btn"))]# },
    radius = 6.0,
    default_bg_color     = Color{ r=0.20, g=0.20, b=0.22, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.30, b=0.34, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.50, g=0.20, b=0.20, a=1.0 },
    hovered_border_color = Color{ r=0.70, g=0.30, b=0.30, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.70, g=0.15, b=0.15, a=1.0 },
    pressed_border_color = Color{ r=0.90, g=0.40, b=0.40, a=1.0 },
    pressed_border_width = 2.0,
  })

  app.email_input:init(InputVisual{
    pos    = Vec2{ x = #[get_layout_pos("email_input")]#,  y = #[select(2, get_layout_pos("email_input"))]# },
    size   = Vec2{ x = #[get_layout_size("email_input")]#, y = #[select(2, get_layout_size("email_input"))]# },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  app.email_input.component_id = 1

  app.password_input:init(InputVisual{
    pos    = Vec2{ x = #[get_layout_pos("password_input")]#,  y = #[select(2, get_layout_pos("password_input"))]# },
    size   = Vec2{ x = #[get_layout_size("password_input")]#, y = #[select(2, get_layout_size("password_input"))]# },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  app.password_input.component_id = 2

  app.cancel_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("cancel_btn")]#,  y = #[select(2, get_layout_pos("cancel_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("cancel_btn")]#, y = #[select(2, get_layout_size("cancel_btn"))]# },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.22, b=0.25, a=1.0 },
    default_border_color = Color{ r=0.35, g=0.35, b=0.40, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.30, g=0.30, b=0.35, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.50, b=0.58, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.60, b=0.68, a=1.0 },
    pressed_border_width = 2.0,
  })

  app.login_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("login_btn")]#,  y = #[select(2, get_layout_pos("login_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("login_btn")]#, y = #[select(2, get_layout_size("login_btn"))]# },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.44, b=0.90, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.52, b=1.00, a=0.6 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.30, g=0.52, b=1.00, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.70, b=1.00, a=0.8 },
    hovered_border_width = 0.0,
    pressed_bg_color     = Color{ r=0.15, g=0.32, b=0.75, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.80, b=1.00, a=1.0 },
    pressed_border_width = 2.0,
  })

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  printf("nebula: layout_demo started — 7 components positioned by compile-time Flexbox\n")

  -- =============================================================================
  -- ★ Phase 3.9: 主循环收缩到 3 行
  -- =============================================================================
  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(window, &input, dt)

    -- 业务逻辑：按钮点击响应
    if app.close_btn.click.just_clicked then
      printf("nebula: close button clicked\n")
    end
    if app.login_btn.click.just_clicked then
      printf("nebula: login button clicked\n")
    end
    if app.cancel_btn.click.just_clicked then
      printf("nebula: cancel button clicked\n")
    end

    -- ★ Phase 3.9: nebula_frame_render 封装全部渲染
    nebula_frame_render(&renderer, &app, &input, dt, 0.08, 0.08, 0.10)
  end

  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("nebula: clean exit\n")
  return 0
end

main()
