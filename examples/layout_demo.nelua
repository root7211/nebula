-- =============================================================================
-- layout_demo.nelua
-- Nebula GUI Compiler — Phase 3.1 子阶段 Demo
--
-- 演示已合入仓库的 Phase 3.1 编译期 Flexbox 布局系统：
--   · 使用 nebula_layout_node / nebula_layout_solve 在编译期声明布局树
--   · 编译期自动解算所有组件的绝对坐标和尺寸
--   · 解算结果直接注入到 Visual 初始化代码中
--   · 运行时零布局计算开销
--
-- 布局结构：
--   Root (column, center)
--   └── Card (column, center, padding=24, gap=12)
--       ├── Header Row (row, space_between)
--       │   ├── Title Rect (占位)
--       │   └── Close Button
--       ├── Email Input
--       ├── Password Input
--       └── Button Row (row, center, gap=12)
--           ├── Cancel Button
--           └── Login Button
-- =============================================================================

## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- Phase 3.1: 编译期布局声明与解算
-- =============================================================================
##[[
  -- 声明布局树
  local root = nebula_layout_node({
    name      = "root",
    direction = "column",
    justify   = "center",
    align     = "center",
    width     = 800,
    height    = 600,
    children  = {
      nebula_layout_node({
        name      = "card",
        type_name = "CardVisual",
        direction = "column",
        justify   = "start",
        align     = "stretch",
        padding   = 24,
        gap       = 12,
        width     = 400,
        children  = {
          -- Header row
          nebula_layout_node({
            name      = "header_row",
            direction = "row",
            justify   = "space_between",
            align     = "center",
            height    = 36,
            children  = {
              nebula_layout_node({
                name      = "title_rect",
                type_name = "SimpleRectVisual",
                width     = 120,
                height    = 36,
              }),
              nebula_layout_node({
                name      = "close_btn",
                type_name = "ButtonVisual",
                width     = 36,
                height    = 36,
              }),
            },
          }),
          -- Email input
          nebula_layout_node({
            name      = "email_input",
            type_name = "InputVisual",
            height    = 44,
          }),
          -- Password input
          nebula_layout_node({
            name      = "password_input",
            type_name = "InputVisual",
            height    = 44,
          }),
          -- Button row
          nebula_layout_node({
            name      = "button_row",
            direction = "row",
            justify   = "center",
            align     = "center",
            gap       = 12,
            height    = 48,
            children  = {
              nebula_layout_node({
                name      = "cancel_btn",
                type_name = "ButtonVisual",
                width     = 140,
                height    = 48,
              }),
              nebula_layout_node({
                name      = "login_btn",
                type_name = "ButtonVisual",
                width     = 180,
                height    = 48,
              }),
            },
          }),
        },
      }),
    },
  })

  -- 编译期解算
  nebula_layout_solve(root, 800, 600)

  -- 编译期调试输出
  print("[layout] Phase 3.1 — Compile-time Flexbox layout solved:")
  nebula_layout_dump(root)

  -- 收集结果
  local layout_results = nebula_layout_collect(root)

  -- 辅助函数：从解算结果中获取 pos 和 size
  function get_layout_pos(name)
    local r = layout_results[name]
    assert(r, "layout: node '" .. name .. "' not found in results")
    return r.x, r.y
  end

  function get_layout_size(name)
    local r = layout_results[name]
    assert(r, "layout: node '" .. name .. "' not found in results")
    return r.w, r.h
  end
]]

-- =============================================================================
-- 视觉规格 + 注解 + 派生
-- =============================================================================

-- ---- 卡片背景 ----
global CardVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
}
##[[
nebula_annotate("CardVisual", { states={"default"}, primitives={}, transitions={} })
]]
## nebula_derive("CardVisual")

-- ---- 标题占位矩形（仅 default + hoverable） ----
global SimpleRectVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:  Color,
  hovered_bg_color:  Color,
}
##[[
nebula_annotate("SimpleRectVisual", {
  states     = {"default", "hovered"},
  primitives = {"hoverable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.15},
    {from="hovered", to="default", tween="ease_out", duration=0.15},
  },
})
]]
## nebula_derive("SimpleRectVisual")

-- ---- 输入框 ----
global InputVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  focused_bg_color:     Color,
  focused_border_color: Color,
  focused_border_width: float32,
}
##[[
nebula_annotate("InputVisual", {
  states     = {"default", "hovered", "focused"},
  primitives = {"hoverable", "clickable", "focusable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.12},
    {from="hovered", to="default", tween="ease_out", duration=0.12},
    {from="hovered", to="focused", tween="ease_out", duration=0.10},
    {from="focused", to="hovered", tween="ease_out", duration=0.10},
    {from="focused", to="default", tween="ease_out", duration=0.15},
  },
})
]]
## nebula_derive("InputVisual")

-- ---- 按钮 ----
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.15},
    {from="hovered", to="default", tween="ease_out", duration=0.15},
    {from="hovered", to="pressed", tween="none",     duration=0.0},
    {from="pressed", to="hovered", tween="ease_out", duration=0.1},
  },
})
]]
## nebula_derive("ButtonVisual")

-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H,
    "Nebula Phase 3.1 — Layout Demo (Compile-Time Flexbox)", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  -- ★ Phase 3.1: 管线初始化（每种 Visual 类型一个管线）
  local pipe_card:       CardPipeline
  local pipe_title:      SimpleRectPipeline
  local pipe_close:      ButtonPipeline
  local pipe_email:      InputPipeline
  local pipe_password:   InputPipeline
  local pipe_cancel:     ButtonPipeline
  local pipe_login:      ButtonPipeline
  if not pipe_card:init(&renderer)     then return 1 end
  if not pipe_title:init(&renderer)    then return 1 end
  if not pipe_close:init(&renderer)    then return 1 end
  if not pipe_email:init(&renderer)    then return 1 end
  if not pipe_password:init(&renderer) then return 1 end
  if not pipe_cancel:init(&renderer)   then return 1 end
  if not pipe_login:init(&renderer)    then return 1 end

  -- ★ Phase 3.1: 使用编译期布局解算的坐标初始化组件
  -- 坐标和尺寸由 nebula_layout_solve 在编译期计算完成

  local card: CardContext
  card:init(CardVisual{
    pos    = Vec2{ x = #[get_layout_pos("card")]#, y = #[select(2, get_layout_pos("card"))]# },
    size   = Vec2{ x = #[get_layout_size("card")]#, y = #[select(2, get_layout_size("card"))]# },
    radius = 16.0,
    default_bg_color     = Color{ r=0.13, g=0.13, b=0.15, a=1.0 },
    default_border_color = Color{ r=0.25, g=0.25, b=0.28, a=1.0 },
    default_border_width = 1.0,
  })

  local title_rect: SimpleRectContext
  title_rect:init(SimpleRectVisual{
    pos    = Vec2{ x = #[get_layout_pos("title_rect")]#, y = #[select(2, get_layout_pos("title_rect"))]# },
    size   = Vec2{ x = #[get_layout_size("title_rect")]#, y = #[select(2, get_layout_size("title_rect"))]# },
    radius = 6.0,
    default_bg_color = Color{ r=0.25, g=0.25, b=0.30, a=1.0 },
    hovered_bg_color = Color{ r=0.35, g=0.35, b=0.42, a=1.0 },
  })

  local close_btn: ButtonContext
  close_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("close_btn")]#, y = #[select(2, get_layout_pos("close_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("close_btn")]#, y = #[select(2, get_layout_size("close_btn"))]# },
    radius = 6.0,
    default_bg_color     = Color{ r=0.20, g=0.20, b=0.22, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.30, b=0.34, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.50, g=0.20, b=0.20, a=1.0 },
    hovered_border_color = Color{ r=0.70, g=0.30, b=0.30, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.70, g=0.15, b=0.15, a=1.0 },
    pressed_border_color = Color{ r=0.90, g=0.40, b=0.40, a=1.0 },
    pressed_border_width = 2.0,
  })

  local email_input: InputContext
  email_input:init(InputVisual{
    pos    = Vec2{ x = #[get_layout_pos("email_input")]#, y = #[select(2, get_layout_pos("email_input"))]# },
    size   = Vec2{ x = #[get_layout_size("email_input")]#, y = #[select(2, get_layout_size("email_input"))]# },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  email_input.component_id = 1

  local password_input: InputContext
  password_input:init(InputVisual{
    pos    = Vec2{ x = #[get_layout_pos("password_input")]#, y = #[select(2, get_layout_pos("password_input"))]# },
    size   = Vec2{ x = #[get_layout_size("password_input")]#, y = #[select(2, get_layout_size("password_input"))]# },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
  })
  password_input.component_id = 2

  local cancel_btn: ButtonContext
  cancel_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("cancel_btn")]#, y = #[select(2, get_layout_pos("cancel_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("cancel_btn")]#, y = #[select(2, get_layout_size("cancel_btn"))]# },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.22, b=0.25, a=1.0 },
    default_border_color = Color{ r=0.35, g=0.35, b=0.40, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.30, g=0.30, b=0.35, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.50, b=0.58, a=1.0 },
    hovered_border_width = 1.5,
    pressed_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.60, b=0.68, a=1.0 },
    pressed_border_width = 2.0,
  })

  local login_btn: ButtonContext
  login_btn:init(ButtonVisual{
    pos    = Vec2{ x = #[get_layout_pos("login_btn")]#, y = #[select(2, get_layout_pos("login_btn"))]# },
    size   = Vec2{ x = #[get_layout_size("login_btn")]#, y = #[select(2, get_layout_size("login_btn"))]# },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.44, b=0.90, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.52, b=1.00, a=0.6 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.30, g=0.52, b=1.00, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.70, b=1.00, a=0.8 },
    hovered_border_width = 0.0,
    pressed_bg_color     = Color{ r=0.15, g=0.32, b=0.75, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.80, b=1.00, a=1.0 },
    pressed_border_width = 2.0,
  })

  -- Phase 2.4: 统一输入状态
  local input: NebulaInputState
  local prev_time = glfwGetTime()

  printf("=== Phase 3.1 Layout Demo: all components positioned by compile-time Flexbox ===\n")

  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now

    nebula_collect_input(window, &input, dt)

    -- 更新所有组件
    card:update(&input, dt)
    title_rect:update(&input, dt)
    close_btn:update(&input, dt)
    email_input:update(&input, dt)
    password_input:update(&input, dt)
    cancel_btn:update(&input, dt)
    login_btn:update(&input, dt)

    -- 渲染
    local surface_tex: WGPUSurfaceTexture
    wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
    local status = surface_tex.status
    if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
       status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal then
      continue
    end
    local view_desc = WGPUTextureViewDescriptor{
      nextInChain     = nilptr, label = wgpu_str_null(),
      format          = renderer.format,
      dimension       = 2,
      baseMipLevel    = 0, mipLevelCount = 1,
      baseArrayLayer  = 0, arrayLayerCount = 1,
      aspect          = 1, usage = 0,
    }
    local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

    -- Uniforms
    local u_card     = card:to_uniforms(WIN_W, WIN_H)
    local u_title    = title_rect:to_uniforms(WIN_W, WIN_H)
    local u_close    = close_btn:to_uniforms(WIN_W, WIN_H)
    local u_email    = email_input:to_uniforms(WIN_W, WIN_H)
    local u_pwd      = password_input:to_uniforms(WIN_W, WIN_H)
    local u_cancel   = cancel_btn:to_uniforms(WIN_W, WIN_H)
    local u_login    = login_btn:to_uniforms(WIN_W, WIN_H)
    pipe_card:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_card:upload(&renderer, &u_card, 1)
    pipe_title:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_title:upload(&renderer, &u_title, 1)
    pipe_close:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_close:upload(&renderer, &u_close, 1)
    pipe_email:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_email:upload(&renderer, &u_email, 1)
    pipe_password:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_password:upload(&renderer, &u_pwd, 1)
    pipe_cancel:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_cancel:upload(&renderer, &u_cancel, 1)
    pipe_login:update_viewport(&renderer, WIN_W, WIN_H)

    pipe_login:upload(&renderer, &u_login, 1)

    local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)
    local clear_color = WGPURenderPassColorAttachment{
      nextInChain = nilptr, view = view, depthSlice = 0xFFFFFFFF,
      resolveTarget = nilptr,
      loadOp  = WGPULoadOp_Clear,
      storeOp = WGPUStoreOp_Store,
      clearValue = WGPUColor{ r=0.08, g=0.08, b=0.10, a=1.0 },
    }
    local rp_desc = WGPURenderPassDescriptor{
      nextInChain            = nilptr,
      label                  = wgpu_str_null(),
      colorAttachmentCount   = 1,
      colorAttachments       = &clear_color,
      depthStencilAttachment = nilptr,
      occlusionQuerySet      = nilptr,
      timestampWrites        = nilptr,
    }
    local pass = wgpuCommandEncoderBeginRenderPass(encoder, &rp_desc)

    -- 按 Z 序绘制：卡片背景 → 标题 → 关闭按钮 → 输入框 → 按钮
    pipe_card:draw_instanced(pass, 1)
    pipe_title:draw_instanced(pass, 1)
    pipe_close:draw_instanced(pass, 1)
    pipe_email:draw_instanced(pass, 1)
    pipe_password:draw_instanced(pass, 1)
    pipe_cancel:draw_instanced(pass, 1)
    pipe_login:draw_instanced(pass, 1)

    wgpuRenderPassEncoderEnd(pass)
    wgpuRenderPassEncoderRelease(pass)

    local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
    wgpuQueueSubmit(renderer.queue, 1, &cmd)
    wgpuCommandBufferRelease(cmd)
    wgpuCommandEncoderRelease(encoder)

    wgpuTextureViewRelease(view)
    wgpuSurfacePresent(renderer.surface)
  end

  glfwDestroyWindow(window)
  glfwTerminate()
  return 0
end

main()
