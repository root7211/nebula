-- =============================================================================
-- shadow_demo.nelua
-- Nebula GUI Compiler — Phase 2.5 Demo
--
-- 展示多 Pass 渲染（Shadow / Blur）效果：
--   · 组件声明 shadow_color / shadow_offset / shadow_blur 字段
--   · nebula_derive 自动检测并生成 4-Pass 阴影管线
--   · 渲染循环中调用 draw_shadow() 编排多 Pass，再调用 draw() 绘制主组件
--
-- 架构：
--   Pass 1: 阴影遮罩（组件 SDF 偏移后渲染到离屏纹理 A）
--   Pass 2: 水平高斯模糊（纹理 A → 纹理 B）
--   Pass 3: 垂直高斯模糊（纹理 B → 纹理 A）
--   Pass 4: Surface 主 Pass（先合成模糊阴影，再绘制主组件）
-- =============================================================================

## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "primitives"
require "renderer"
require "app"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

-- =============================================================================
-- 第一步：定义 ShadowButtonVisual 形状
--
-- 与普通 ButtonVisual 的区别：
--   · 新增 shadow_color（每状态可动画）
--   · 新增 shadow_offset（Vec2，base 字段）
--   · 新增 shadow_blur（float32，base 字段）
-- =============================================================================
global ShadowButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,

  -- 阴影参数（base 字段，不参与状态动画）
  shadow_offset: Vec2,
  shadow_blur:   float32,

  -- 每状态的视觉属性
  default_bg_color:  Color,
  hovered_bg_color:  Color,
  pressed_bg_color:  Color,

  default_border_color: Color,
  hovered_border_color: Color,
  pressed_border_color: Color,

  default_border_width: float32,
  hovered_border_width: float32,
  pressed_border_width: float32,

  default_shadow_color: Color,
  hovered_shadow_color: Color,
  pressed_shadow_color: Color,
}

-- =============================================================================
-- 第二步：声明状态拓扑、交互原语、动画转换规则
-- =============================================================================
##[[
nebula_annotate("ShadowButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.15},
    {from="hovered", to="default", tween="ease_out", duration=0.15},
    {from="hovered", to="pressed", tween="none",     duration=0.0},
    {from="pressed", to="hovered", tween="ease_out", duration=0.1},
  },
})
]]

-- =============================================================================
-- 第三步：★ 一行代码自动派生（Phase 2.5 自动检测阴影字段，生成 4-Pass 管线）
-- =============================================================================
## nebula_derive("ShadowButtonVisual")

-- =============================================================================
-- 主程序
-- =============================================================================
local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

local function main(): int32
  if glfwInit() == 0 then
    printf("glfw: init failed\n")
    return 1
  end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H, "Nebula Phase 2.5 - Shadow Demo", nilptr, nilptr)
  if window == nilptr then
    printf("glfw: window creation failed\n")
    return 1
  end

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  -- Phase 2.5: 阴影管线需要窗口尺寸来创建离屏纹理
  local shadow_pipeline: ShadowButtonPipeline
  if not shadow_pipeline:init(&renderer, WIN_W, WIN_H) then return 1 end

  local button_vis = ShadowButtonVisual{
    pos    = Vec2{ x = 300.0, y = 250.0 },
    size   = Vec2{ x = 200.0, y = 60.0 },
    radius = 12.0,

    -- 阴影参数
    shadow_offset = Vec2{ x = 4.0, y = 6.0 },
    shadow_blur   = 8.0,

    -- default 状态
    default_bg_color     = Color{ r=0.22, g=0.22, b=0.24, a=1.0 },
    default_border_color = Color{ r=0.4,  g=0.4,  b=0.45, a=1.0 },
    default_border_width = 1.0,
    default_shadow_color = Color{ r=0.0,  g=0.0,  b=0.0,  a=0.4 },

    -- hovered 状态
    hovered_bg_color     = Color{ r=0.28, g=0.28, b=0.32, a=1.0 },
    hovered_border_color = Color{ r=0.4,  g=0.6,  b=1.0,  a=1.0 },
    hovered_border_width = 2.0,
    hovered_shadow_color = Color{ r=0.0,  g=0.2,  b=0.6,  a=0.5 },

    -- pressed 状态
    pressed_bg_color     = Color{ r=0.16, g=0.16, b=0.20, a=1.0 },
    pressed_border_color = Color{ r=0.6,  g=0.8,  b=1.0,  a=1.0 },
    pressed_border_width = 2.5,
    pressed_shadow_color = Color{ r=0.0,  g=0.0,  b=0.0,  a=0.2 },
  }

  local button: ShadowButtonContext
  button:init(button_vis)

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()

    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now

    nebula_collect_input(window, &input, dt)
    button:update(&input, dt)

    -- Surface 纹理获取
    local surface_tex: WGPUSurfaceTexture
    wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
    local status = surface_tex.status
    if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
       status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal then
      continue
    end

    local view_desc = WGPUTextureViewDescriptor{
      nextInChain     = nilptr,
      label           = wgpu_str_null(),
      format          = renderer.format,
      dimension       = 2,
      baseMipLevel    = 0,
      mipLevelCount   = 1,
      baseArrayLayer  = 0,
      arrayLayerCount = 1,
      aspect          = 1,
      usage           = 0,
    }
    local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

    -- 更新 uniforms（主管线 + 阴影遮罩共享）
    local u = button:to_uniforms(WIN_W, WIN_H)
    shadow_pipeline:update_uniforms(&renderer, &u)

    -- 创建 CommandEncoder
    local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)

    -- Phase 2.5: 执行阴影的 3 个离屏 Pass（mask → blur_h → blur_v）
    shadow_pipeline:draw_shadow(encoder, view, &renderer, button_vis.shadow_blur)

    -- Pass 4: Surface 主 Pass
    local clear_color = WGPURenderPassColorAttachment{
      nextInChain   = nilptr,
      view          = view,
      depthSlice    = 0xFFFFFFFF,
      resolveTarget = nilptr,
      loadOp        = WGPULoadOp_Clear,
      storeOp       = WGPUStoreOp_Store,
      clearValue    = WGPUColor{ r=0.09, g=0.09, b=0.10, a=1.0 },
    }
    local pass_desc = WGPURenderPassDescriptor{
      nextInChain             = nilptr,
      label                   = wgpu_str_null(),
      colorAttachmentCount    = 1,
      colorAttachments        = &clear_color,
      depthStencilAttachment  = nilptr,
      occlusionQuerySet       = nilptr,
      timestampWrites         = nilptr,
    }
    local pass = wgpuCommandEncoderBeginRenderPass(encoder, &pass_desc)

    -- TODO Phase 2.5.next: 在此处先绘制模糊阴影纹理（tex_a），
    -- 需要一个全屏纹理合成管线。当前版本先跳过合成步骤，
    -- 仅绘制主组件以验证多 Pass 架构正确性。
    shadow_pipeline:draw(pass)

    wgpuRenderPassEncoderEnd(pass)
    wgpuRenderPassEncoderRelease(pass)

    local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
    wgpuCommandEncoderRelease(encoder)
    wgpuQueueSubmit(renderer.queue, 1, &cmd)
    wgpuCommandBufferRelease(cmd)

    wgpuSurfacePresent(renderer.surface)
    wgpuTextureViewRelease(view)
    wgpuTextureRelease(surface_tex.texture)
  end

  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("nebula: clean exit\n")
  return 0
end

main()
