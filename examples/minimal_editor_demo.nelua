-- minimal_editor_demo.nelua — Nebula GUI Compiler
-- 文档愿景验证：最小编辑器（~30 行框架代码）
-- 操作：点击窗口获取焦点后可输入文字

require "nebula"

## nebula_visual("EditorVisual", {
##   primitives   = {"multiline_editable"},
##   max_text_len = 256,
##   max_lines    = 256,
##   component_id = 1,
## })
## nebula_app("EditorApp", {
##   layout = { direction = "row", width = 1280, height = 800 },
##   components = {
##     { name = "editor", type = "EditorVisual" },
##   },
## })

local function main(): int32
  local renderer: NebulaRenderer
  local app: EditorApp
  if not nebula_init(&renderer, &app, "Minimal Editor", 1280, 800) then
    return 1
  end
  app.editor:init_themed(Vec2{x = 0.0, y = 0.0}, Vec2{x = 1280.0, y = 800.0}, 0.0)

  local input: NebulaInputState
  while not nebula_should_close() do
    local dt = nebula_frame_begin(&input)
    app.editor.visual.content_height = (@float32)(app.editor.line_count) * 18.0
    nebula_frame_render(&renderer, &app, &input, dt, 0.09, 0.09, 0.10)
  end
  app:deinit()
  nebula_shutdown(&renderer)
  printf("minimal_editor: clean exit\n")
  return 0
end

main()
