-- =============================================================================
-- slug_bench.nelua
-- Nebula GUI Compiler — Phase 4.2.2 D-4.1-C Benchmark
--
-- Storage Buffer 可扩展性性能基准测试。
--
-- 验收标准（PLAN_PHASE4_2_3_CJK §2.4）：
--   · 10K 实例退化 < 20%（vs 1K 基线）→ DISMISSED
--   · 退化 ≥ 20% → SUSTAINED
--
-- Usage:  ./build.sh slug_bench
-- =============================================================================

## cinclude "<stdio.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- 极简 Visual 规格
-- =============================================================================
global BenchVisual = @record{
  pos: Vec2,
  size: Vec2,
  default_bg_color: Color,
  default_border_color: Color,
  default_border_width: float32,
}

##[[
nebula_annotate("BenchVisual", {
  states = {"default"},
  primitives = {},
  transitions = {},
})
]]
## nebula_derive("BenchVisual")

-- =============================================================================
-- App 派生：1 个静态组件 + 1 个 legacy Slot
-- =============================================================================
##[[
  nebula_app_begin("BenchApp")
    nebula_app_register_component("bench0", "BenchVisual")
    nebula_app_register_slot("bench_slot", "BenchVisual", {
      max_instances = 10016,
      legacy_count_var = "bench_count",
      legacy_data_var  = "bench_data",
    })
  nebula_app_end()
]]
## nebula_derive_app("BenchApp")

-- =============================================================================
-- 编译期注入 bench_data / bench_count / fill_bench_data
--
-- 关键技巧：在用户的 ##[[...]] 块中重新注入 BenchVisualUniforms record
-- （通过 nebula_gen_uniform_layout 获取 layout.nelua_record_source），
-- 然后再注入引用该类型的代码。这样 Nelua 分析器在同一 AST 块中能找到类型。
-- =============================================================================
##[[
  -- 1. 重新注入 BenchVisualUniforms record（解决类型不可见问题）
  local layout = nebula_gen_uniform_layout("BenchVisual", {
    record_name      = "BenchVisualUniforms",
    wgsl_struct_name = "Uniforms",
  })
  local rec_ast = aster.parse(layout.nelua_record_source, "<re-inject:BenchVisualUniforms>")
  for _, s in ipairs(rec_ast) do inject_statement(s) end

  -- 2. 注入全局 bench_data 和 bench_count
  local max_inst = 10016
  local function inject_code(code, tag)
    local ast = aster.parse(code, tag)
    for _, s in ipairs(ast) do inject_statement(s) end
  end

  inject_code(string.format("global bench_data: [%d]BenchVisualUniforms", max_inst), "<bench_data>")
  inject_code("global bench_count: uint32 = 0", "<bench_count>")

  -- 3. 注入 fill_bench_data 函数
  -- BenchVisualUniforms 字段: pos(Vec2), size(Vec2), bg_color(Color), border_color(Color),
  --   border_width(float32), _pad0(float32), viewport(Vec2) — 总 64 bytes
  local fn_src = table.concat({
    "global function fill_bench_data(count: uint32): void",
    "  bench_count = count",
    "  local cols: uint32 = 100",
    "  local rows: uint32 = (count + cols - 1) / cols",
    "  local cell_w = 800.0 / (@float32)(cols)",
    "  local cell_h = 600.0 / (@float32)(rows)",
    "  local rect_w = cell_w * 0.9",
    "  local rect_h = cell_h * 0.9",
    "  local i: uint32 = 0",
    "  while i < count do",
    "    local col = i % cols",
    "    local row = i / cols",
    "    bench_data[i] = BenchVisualUniforms{",
    "      pos = Vec2{ x = (@float32)(col) * cell_w + cell_w * 0.05,",
    "                  y = (@float32)(row) * cell_h + cell_h * 0.05 },",
    "      size = Vec2{ x = rect_w, y = rect_h },",
    "      bg_color = Color{ r = 0.3, g = 0.6, b = 0.9, a = 1.0 },",
    "      border_color = Color{ r = 0.0, g = 0.0, b = 0.0, a = 0.0 },",
    "      border_width = 0.0,",
    "      _pad0 = 0.0,",
    "      viewport = Vec2{ x = 800.0, y = 600.0 },",
    "    }",
    "    i = i + 1",
    "  end",
    "end",
  }, "\n")
  inject_code(fn_src, "<fill_bench_data>")
]]

-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  printf("=============================================================\n")
  printf(" Nebula D-4.1-C: Storage Buffer Scalability Benchmark\n")
  printf(" Phase 4.2.2\n")
  printf("=============================================================\n\n")

  if glfwInit() == 0 then
    printf("glfw: init failed\n")
    return 1
  end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H,
    "Nebula D-4.1-C Benchmark", nilptr, nilptr)
  if window == nilptr then
    printf("glfw: window creation failed\n")
    return 1
  end

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then
    return 1
  end

  local app: BenchApp
  if not app:init(&renderer, WIN_W, WIN_H) then
    return 1
  end

  -- 初始化静态组件（占位，不绘制可见内容）
  app.bench0:init(BenchVisual{
    pos = Vec2{ x = 0.0, y = 0.0 },
    size = Vec2{ x = 0.0, y = 0.0 },
    default_bg_color = Color{ r = 0.0, g = 0.0, b = 0.0, a = 0.0 },
    default_border_color = Color{ r = 0.0, g = 0.0, b = 0.0, a = 0.0 },
    default_border_width = 0.0,
  })

  local BENCH_FRAMES: uint32 = 60
  local input: NebulaInputState

  printf("Running benchmark: %u frames per scale, warmup=3\n\n", BENCH_FRAMES)
  printf("  %-12s  %-9s  %-18s\n", "Scale", "Count", "Avg Frame Time")
  printf("  %-12s  %-9s  %-18s\n", "-----", "-----", "---------------")

  local counts: [3]uint32 = {1000, 5000, 10000}
  local labels: [3]cstring = {"1K-baseline", "5K-mid", "10K-target"}
  local avg_times: [3]float64 = {0.0, 0.0, 0.0}

  local bench_idx: uint32 = 0
  while bench_idx < 3 do
    local count = counts[bench_idx]
    local label = labels[bench_idx]

    fill_bench_data(count)

    -- Warmup
    local w: uint32 = 0
    while w < 3 do
      glfwPollEvents()
      local dt: float32 = 0.016
      nebula_frame_render(&renderer, &app, &input, dt, 0.05, 0.05, 0.07)
      w = w + 1
    end

    -- Measurement
    local t_start = glfwGetTime()
    local f: uint32 = 0
    while f < BENCH_FRAMES do
      glfwPollEvents()
      local dt: float32 = 0.016
      nebula_frame_render(&renderer, &app, &input, dt, 0.05, 0.05, 0.07)
      f = f + 1
    end
    local t_end = glfwGetTime()

    local actual = (@float64)(f)
    local total_sec = t_end - t_start
    local avg_ms = 0.0
    if actual > 0.0 then
      avg_ms = (total_sec / actual) * 1000.0
    end
    avg_times[bench_idx] = avg_ms
    printf("  %-12s  count=%5u  avg=%.3f ms/frame\n", label, count, avg_ms)

    bench_idx = bench_idx + 1
  end

  printf("\n=============================================================\n")
  printf(" D-4.1-C Results\n")
  printf("=============================================================\n\n")

  local t_1k = avg_times[0]
  if t_1k > 0.0 then
    local ratio_5k = avg_times[1] / t_1k
    local ratio_10k = avg_times[2] / t_1k
    local degrade_5k = (ratio_5k - 1.0) * 100.0
    local degrade_10k = (ratio_10k - 1.0) * 100.0

    printf("  1K baseline:    %.3f ms/frame\n", t_1k)
    printf("  5K (5x scale):  %.3f ms/frame  (degradation: %+.1f%%)\n", avg_times[1], degrade_5k)
    printf("  10K (10x scale): %.3f ms/frame  (degradation: %+.1f%%)\n", avg_times[2], degrade_10k)
    printf("\n  Verdict: ")
    if degrade_10k < 20.0 then
      printf("PASSED — degradation %.1f%% < 20%% threshold\n", degrade_10k)
      printf("  D-4.1-C: benchmark DISMISSED. Storage Buffer path viable at CJK scale.\n")
    else
      printf("FAILED — degradation %.1f%% >= 20%% threshold\n", degrade_10k)
      printf("  D-4.1-C: benchmark SUSTAINED. Migration to RGBA32Float texture needed.\n")
    end
  else
    printf("  ERROR: baseline benchmark failed.\n")
  end

  printf("\n  Environment:\n")
  printf("    Platform:  WSL2 / Linux (X11)\n")
  printf("    Renderer:  wgpu-native v29+\n")
  printf("    Window:    %d x %d\n", WIN_W, WIN_H)
  printf("    Uniforms:  64 bytes/instance\n")
  printf("    Path:      App + legacy Slot API\n")
  printf("    Draw:      wgpuRenderPassEncoderDraw(pass, 6, N, 0, 0)\n\n")

  app:deinit()
  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("bench: clean exit\n")
  return 0
end

main()
