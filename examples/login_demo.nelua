-- =============================================================================
-- login_demo.nelua
-- Nebula GUI Compiler — Phase 3.4.4
--
-- Phase 3.4.4 升级：
--   · 接入 nebula_input_install_callbacks() 注册键盘回调
--   · InputContext 新增 text_buf / text_len / cursor_pos 字段
--   · 每帧调用 process_text_input() 消费键盘事件，文本变化时重建 TextContext 网格
--   · 使用 nebula_cursor_x_offset() + nebula_cursor_visible() 渲染闪烁光标
--   · 按 Enter 键时在控制台打印当前 email / password 内容
--   · 完全向后兼容 Phase 2.4 的视觉规格与焦点管理
-- =============================================================================

## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "primitives"
require "renderer"
require "app"
require "text_runtime"
require "nebula_cursor"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function memset(ptr: pointer, value: int32, size: usize): pointer <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- 视觉规格 + 注解 + 派生
-- =============================================================================

-- ---- 卡片背景 ----
global CardVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
}
##[[ nebula_annotate("CardVisual", { states={"default"}, primitives={}, transitions={} }) ]]
## nebula_derive("CardVisual")

-- ---- 输入框：default + hovered + focused ----
global InputVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,

  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,

  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,

  focused_bg_color:     Color,
  focused_border_color: Color,
  focused_border_width: float32,

  -- Phase 3.4.4: 文本缓冲区字段（由 nebula_gen_text_buffer 生成的方法使用）
  text_buf:   [256]uint8,
  text_len:   uint32,
  cursor_pos: uint32,
}
##[[
nebula_annotate("InputVisual", {
  states     = {"default", "hovered", "focused"},
  primitives = {"hoverable", "clickable", "focusable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.12},
    {from="hovered", to="default", tween="ease_out", duration=0.12},
    {from="hovered", to="focused", tween="ease_out", duration=0.10},
    {from="focused", to="hovered", tween="ease_out", duration=0.10},
    {from="focused", to="default", tween="ease_out", duration=0.15},
  },
})
]]
## nebula_derive("InputVisual")

-- Phase 3.4.4: 为 InputContext 生成 process_text_input / get_text 方法
##[[ nebula_gen_text_buffer({ base = "Input" }) ]]

-- ---- 按钮 ----
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,

  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,

  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,

  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.15},
    {from="hovered", to="default", tween="ease_out", duration=0.15},
    {from="hovered", to="pressed", tween="none",     duration=0.0},
    {from="pressed", to="hovered", tween="ease_out", duration=0.1},
  },
})
]]
## nebula_derive("ButtonVisual")

-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H, "Nebula Phase 3.4 — Login Demo", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end

  -- Phase 3.4.1: 注册键盘回调（在主循环前调用一次）
  nebula_input_install_callbacks(window)

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  -- 管线
  local pipe_card:     CardPipeline
  local pipe_email:    InputPipeline
  local pipe_password: InputPipeline
  local pipe_button:   ButtonPipeline
  if not pipe_card:init(&renderer)     then return 1 end
  if not pipe_email:init(&renderer)    then return 1 end
  if not pipe_password:init(&renderer) then return 1 end
  if not pipe_button:init(&renderer)   then return 1 end

  -- 文本渲染管线（用于显示输入框内容）
  local pipe_email_text:    TextPipeline
  local pipe_password_text: TextPipeline
  if not pipe_email_text:init(&renderer)    then return 1 end
  if not pipe_password_text:init(&renderer) then return 1 end

  -- ---- 卡片 ----
  local card: CardContext
  card:init(CardVisual{
    pos    = Vec2{ x = 220.0, y = 100.0 },
    size   = Vec2{ x = 360.0, y = 400.0 },
    radius = 16.0,
    default_bg_color     = Color{ r=0.13, g=0.13, b=0.15, a=1.0 },
    default_border_color = Color{ r=0.25, g=0.25, b=0.28, a=1.0 },
    default_border_width = 1.0,
  })

  -- ---- Email 输入框（component_id = 1）----
  local email_input: InputContext
  email_input:init(InputVisual{
    pos    = Vec2{ x = 252.0, y = 196.0 },
    size   = Vec2{ x = 296.0, y = 44.0 },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
    text_buf   = {},
    text_len   = 0,
    cursor_pos = 0,
  })
  email_input.component_id = 1

  -- ---- Password 输入框（component_id = 2）----
  local password_input: InputContext
  password_input:init(InputVisual{
    pos    = Vec2{ x = 252.0, y = 264.0 },
    size   = Vec2{ x = 296.0, y = 44.0 },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
    text_buf   = {},
    text_len   = 0,
    cursor_pos = 0,
  })
  password_input.component_id = 2

  -- ---- 登录按钮 ----
  local login_btn: ButtonContext
  login_btn:init(ButtonVisual{
    pos    = Vec2{ x = 252.0, y = 356.0 },
    size   = Vec2{ x = 296.0, y = 48.0 },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.44, b=0.90, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.52, b=1.00, a=0.6 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.30, g=0.52, b=1.00, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.70, b=1.00, a=0.8 },
    hovered_border_width = 0.0,
    pressed_bg_color     = Color{ r=0.15, g=0.32, b=0.75, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.80, b=1.00, a=1.0 },
    pressed_border_width = 2.0,
  })

  -- ---- 文本上下文（用于显示输入框内容）----
  local email_text:    TextContext
  local password_text: TextContext
  email_text:init(
    Vec2{ x = 260.0, y = 212.0 },  -- 文本起始位置（输入框内左侧）
    Color{ r=0.90, g=0.90, b=0.92, a=1.0 },
    14.0
  )
  password_text:init(
    Vec2{ x = 260.0, y = 280.0 },
    Color{ r=0.90, g=0.90, b=0.92, a=1.0 },
    14.0
  )

  -- 初始占位符文本
  email_text:set_text("email")
  password_text:set_text("password")

  -- ---- 统一输入状态 ----
  local input: NebulaInputState
  local prev_time = glfwGetTime()

  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now

    -- 收集输入（鼠标 + 键盘）
    nebula_collect_input(window, &input, dt)

    -- 更新组件状态机与焦点
    card:update(&input, dt)
    email_input:update(&input, dt)
    password_input:update(&input, dt)
    login_btn:update(&input, dt)

    -- Phase 3.4.4: 处理文本输入，文本变化时重建网格
    if email_input:process_text_input(&input) then
      if email_input.visual.text_len > 0 then
        email_text:set_text(email_input:get_text())
      else
        email_text:set_text("email")
      end
    end

    if password_input:process_text_input(&input) then
      if password_input.visual.text_len > 0 then
        -- 密码框：显示 * 号
        local mask: [256]uint8
        local mi: uint32 = 0
        while mi < password_input.visual.text_len do
          mask[mi] = 0x2A  -- '*'
          mi = mi + 1
        end
        mask[password_input.visual.text_len] = 0
        password_text:set_text((@cstring)(&mask[0]))
      else
        password_text:set_text("password")
      end
    end

    -- Enter 键：打印表单内容
    if input.key_pressed == NebulaKey.Enter then
      printf("email: %s\n", email_input:get_text())
      printf("password: [%d chars]\n", email_input.visual.text_len)
    end

    -- ---- 渲染 ----
    local surface_tex: WGPUSurfaceTexture
    wgpuSurfaceGetCurrentTexture(renderer.surface, &surface_tex)
    local status = surface_tex.status
    if status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal and
       status ~= WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal then
      continue
    end

    local view_desc = WGPUTextureViewDescriptor{
      nextInChain = nilptr, label = wgpu_str_null(),
      format = renderer.format, dimension = 2,
      baseMipLevel = 0, mipLevelCount = 1,
      baseArrayLayer = 0, arrayLayerCount = 1,
      aspect = 1, usage = 0,
    }
    local view = wgpuTextureCreateView(surface_tex.texture, &view_desc)

    -- 更新 Uniform
    local u_card  = card:to_uniforms(WIN_W, WIN_H)
    local u_email = email_input:to_uniforms(WIN_W, WIN_H)
    local u_pwd   = password_input:to_uniforms(WIN_W, WIN_H)
    local u_btn   = login_btn:to_uniforms(WIN_W, WIN_H)
    pipe_card:update_uniforms(&renderer, &u_card)
    pipe_email:update_uniforms(&renderer, &u_email)
    pipe_password:update_uniforms(&renderer, &u_pwd)
    pipe_button:update_uniforms(&renderer, &u_btn)

    -- 上传文本顶点
    pipe_email_text:upload_vertices(&renderer, &email_text)
    pipe_password_text:upload_vertices(&renderer, &password_text)

    -- 提交渲染
    local encoder = wgpuDeviceCreateCommandEncoder(renderer.device, nilptr)
    local clear_color = WGPURenderPassColorAttachment{
      nextInChain = nilptr, view = view, depthSlice = 0xFFFFFFFF,
      resolveTarget = nilptr,
      loadOp = WGPULoadOp_Clear, storeOp = WGPUStoreOp_Store,
      clearValue = WGPUColor{ r=0.09, g=0.09, b=0.10, a=1.0 },
    }
    local pass_desc = WGPURenderPassDescriptor{
      nextInChain = nilptr, label = wgpu_str_null(),
      colorAttachmentCount = 1, colorAttachments = &clear_color,
      depthStencilAttachment = nilptr,
      occlusionQuerySet = nilptr, timestampWrites = nilptr,
    }
    local pass = wgpuCommandEncoderBeginRenderPass(encoder, &pass_desc)
    pipe_card:draw(pass)
    pipe_email:draw(pass)
    pipe_password:draw(pass)
    pipe_button:draw(pass)
    pipe_email_text:draw(pass)
    pipe_password_text:draw(pass)
    wgpuRenderPassEncoderEnd(pass)
    wgpuRenderPassEncoderRelease(pass)

    local cmd = wgpuCommandEncoderFinish(encoder, nilptr)
    wgpuCommandEncoderRelease(encoder)
    wgpuQueueSubmit(renderer.queue, 1, &cmd)
    wgpuCommandBufferRelease(cmd)

    wgpuSurfacePresent(renderer.surface)
    wgpuTextureViewRelease(view)
    wgpuTextureRelease(surface_tex.texture)
  end

  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("nebula: clean exit\n")
  return 0
end

main()
