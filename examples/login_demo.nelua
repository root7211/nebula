-- =============================================================================
-- login_demo.nelua
-- Nebula GUI Compiler — Phase 3.9
--
-- ★ Phase 3.9 重写：从 Phase 3.6 手动渲染循环迁移到 App 编排体系
--
-- 与 Phase 3.6 的对比：
--   · 删除手动 4 个 Pipeline 声明和初始化（由 nebula_derive_app 自动生成）
--   · 删除手动 2 个 TextPipeline 声明和初始化（由 nebula_app_register_text 自动生成）
--   · 删除手动 4 个 Context:update 调用（由 LoginApp:update 自动处理）
--   · 删除手动 process_text_input + get_text + set_text 联动逻辑（约 30 行）
--   · 删除手动密码掩码逻辑（由 nebula_app_register_text mask_password=true 自动处理）
--   · 删除约 60 行 WGPU 渲染样板代码（由 nebula_frame_render 封装）
--   · 删除独立文本 Render Pass（文本渲染纳入 nebula_frame_render 统一管理）
--   · 主循环收缩到 3 行（glfwPollEvents + nebula_collect_input + nebula_frame_render）
--
-- 演示能力：登录表单（卡片 + 两个可编辑输入框 + 登录按钮 + 文本标签）
-- =============================================================================
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula_core"
require "glfw_bindings"
require "wgpu_bindings"
require "renderer"
require "app"
require "text_runtime"
require "nebula_cursor"
require "nebula_arena"

global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end
global function memset(ptr: pointer, value: int32, size: usize): pointer <cimport, nodecl> end

local WIN_W <comptime> = 800
local WIN_H <comptime> = 600

-- =============================================================================
-- 视觉规格 + 注解 + 派生
-- =============================================================================

-- ---- 卡片背景 ----
global CardVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
}
##[[ nebula_annotate("CardVisual", { states={"default"}, primitives={}, transitions={} }) ]]
## nebula_derive("CardVisual")

-- ---- 输入框（Phase 3.6+ Gap Buffer 模式）----
##[[ local _buf_type, _buf_src = nebula_gen_gap_buffer_type(255) ]]
##[[ for _, _s in ipairs(aster.parse(_buf_src, "<gap_buffer:255>")) do inject_statement(_s) end ]]
global InputVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  focused_bg_color:     Color,
  focused_border_color: Color,
  focused_border_width: float32,
  pixel_height: float32,
  gap_buf:      NebulaBuf255,
}
##[[
nebula_annotate("InputVisual", {
  states     = {"default", "hovered", "focused"},
  primitives = {"hoverable", "clickable", "focusable", "editable"},
  transitions = {
    {from="default", to="hovered",  on="hover_enter"},
    {from="hovered", to="default",  on="hover_leave"},
    {from="default", to="focused",  on="focus_gain"},
    {from="hovered", to="focused",  on="focus_gain"},
    {from="focused", to="default",  on="focus_lose"},
  },
})
]]
## nebula_derive("InputVisual")

-- ---- 按钮 ----
global ButtonVisual = @record{
  pos:    Vec2,
  size:   Vec2,
  radius: float32,
  default_bg_color:     Color,
  default_border_color: Color,
  default_border_width: float32,
  hovered_bg_color:     Color,
  hovered_border_color: Color,
  hovered_border_width: float32,
  pressed_bg_color:     Color,
  pressed_border_color: Color,
  pressed_border_width: float32,
}
##[[
nebula_annotate("ButtonVisual", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", on="hover_enter"},
    {from="hovered", to="default", on="hover_leave"},
    {from="hovered", to="pressed", on="press"},
    {from="pressed", to="hovered", on="release"},
  },
})
]]
## nebula_derive("ButtonVisual")

-- ---- 文本渲染 Visual ----
global TextVisual = @record{
  pos:          Vec2,
  size:         Vec2,
  pixel_height: float32,
  default_text_color: Color,
}
##[[
nebula_annotate("TextVisual", {
  states = {"default"},
  primitives = {},
  transitions = {},
  text_mode = "ascii_sdf",
  max_chars = 256,
})
]]
## nebula_derive_text_visual("TextVisual")

-- =============================================================================
-- ★ Phase 3.9: 使用 nebula_derive_app 宏声明并派生 LoginApp
--   · nebula_app_register_text 将文本标签纳入一等公民编排
--   · email_label 绑定到 email_input（placeholder: "email"）
--   · password_label 绑定到 password_input（placeholder: "password"，掩码显示）
-- =============================================================================
##[[
  nebula_app_begin("LoginApp")
    nebula_app_register_component("card",           "CardVisual")
    nebula_app_register_component("email_input",    "InputVisual", {component_id=1})
    nebula_app_register_component("password_input", "InputVisual", {component_id=2})
    nebula_app_register_component("login_btn",      "ButtonVisual")
    -- ★ Phase 3.9: 文本组件一等公民注册
    nebula_app_register_text("email_label", "TextVisual", {
      bound_to      = "email_input",
      placeholder   = "email",
      mask_password = false,
    })
    nebula_app_register_text("password_label", "TextVisual", {
      bound_to      = "password_input",
      placeholder   = "password",
      mask_password = true,
    })
  nebula_app_end()
]]
## nebula_derive_app("LoginApp")

-- =============================================================================
-- 主程序
-- =============================================================================
local function main(): int32
  if glfwInit() == 0 then printf("glfw: init failed\n") return 1 end
  glfwWindowHint(GLFW_CLIENT_API, GLFW_NO_API)
  glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE)

  local window = glfwCreateWindow(WIN_W, WIN_H, "Nebula Phase 3.9 — Login Demo", nilptr, nilptr)
  if window == nilptr then printf("glfw: window creation failed\n") return 1 end

  nebula_input_install_callbacks(window)

  local renderer: NebulaRenderer
  if not renderer:init(window, WIN_W, WIN_H) then return 1 end

  -- LoginApp:init 自动初始化所有管线 + 内嵌 FrameArena（2MB）+ 文本管线（Phase 3.9）
  local login: LoginApp
  if not login:init(&renderer, WIN_W, WIN_H) then return 1 end

  -- 初始化各组件的视觉规格
  login.card:init(CardVisual{
    pos    = Vec2{ x = 220.0, y = 100.0 },
    size   = Vec2{ x = 360.0, y = 400.0 },
    radius = 16.0,
    default_bg_color     = Color{ r=0.13, g=0.13, b=0.15, a=1.0 },
    default_border_color = Color{ r=0.25, g=0.25, b=0.28, a=1.0 },
    default_border_width = 1.0,
  })

  login.email_input:init(InputVisual{
    pos    = Vec2{ x = 252.0, y = 196.0 },
    size   = Vec2{ x = 296.0, y = 44.0 },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
    pixel_height = 14.0,
  })
  login.email_input.visual.gap_buf:init()
  login.email_input.selection_anchor = 0
  login.email_input.is_dragging      = false
  login.email_input.component_id = 1

  login.password_input:init(InputVisual{
    pos    = Vec2{ x = 252.0, y = 264.0 },
    size   = Vec2{ x = 296.0, y = 44.0 },
    radius = 8.0,
    default_bg_color     = Color{ r=0.18, g=0.18, b=0.20, a=1.0 },
    default_border_color = Color{ r=0.32, g=0.32, b=0.36, a=1.0 },
    default_border_width = 1.0,
    hovered_bg_color     = Color{ r=0.20, g=0.20, b=0.23, a=1.0 },
    hovered_border_color = Color{ r=0.45, g=0.45, b=0.52, a=1.0 },
    hovered_border_width = 1.5,
    focused_bg_color     = Color{ r=0.16, g=0.18, b=0.24, a=1.0 },
    focused_border_color = Color{ r=0.35, g=0.60, b=1.00, a=1.0 },
    focused_border_width = 2.0,
    pixel_height = 14.0,
  })
  login.password_input.visual.gap_buf:init()
  login.password_input.selection_anchor = 0
  login.password_input.is_dragging      = false
  login.password_input.component_id = 2

  login.login_btn:init(ButtonVisual{
    pos    = Vec2{ x = 252.0, y = 356.0 },
    size   = Vec2{ x = 296.0, y = 48.0 },
    radius = 10.0,
    default_bg_color     = Color{ r=0.22, g=0.44, b=0.90, a=1.0 },
    default_border_color = Color{ r=0.30, g=0.52, b=1.00, a=0.6 },
    default_border_width = 0.0,
    hovered_bg_color     = Color{ r=0.30, g=0.52, b=1.00, a=1.0 },
    hovered_border_color = Color{ r=0.50, g=0.70, b=1.00, a=0.8 },
    hovered_border_width = 0.0,
    pressed_bg_color     = Color{ r=0.15, g=0.32, b=0.75, a=1.0 },
    pressed_border_color = Color{ r=0.60, g=0.80, b=1.00, a=1.0 },
    pressed_border_width = 2.0,
  })

  -- ★ Phase 3.9: 初始化文本组件视觉规格（一等公民）
  login.email_label:init(TextVisual{
    pos          = Vec2{ x = 260.0, y = 212.0 },
    size         = Vec2{ x = 0.0, y = 0.0 },
    pixel_height = 14.0,
    default_text_color = Color{ r=0.90, g=0.90, b=0.92, a=1.0 },
  })
  login.password_label:init(TextVisual{
    pos          = Vec2{ x = 260.0, y = 280.0 },
    size         = Vec2{ x = 0.0, y = 0.0 },
    pixel_height = 14.0,
    default_text_color = Color{ r=0.90, g=0.90, b=0.92, a=1.0 },
  })

  -- 设置初始占位符文本
  if not login.email_label:set_text(&renderer, "email") then return 1 end
  if not login.password_label:set_text(&renderer, "password") then return 1 end

  local input: NebulaInputState
  local prev_time = glfwGetTime()

  -- =============================================================================
  -- ★ Phase 3.9: 主循环收缩到 3 行
  -- =============================================================================
  while glfwWindowShouldClose(window) == 0 do
    glfwPollEvents()
    local now = glfwGetTime()
    local dt  = (@float32)(now - prev_time)
    prev_time = now
    nebula_collect_input(window, &input, dt)

    -- 业务逻辑：Enter 键打印表单内容（领域逻辑，保留在应用层）
    if input.key_pressed == NebulaKey.Enter then
      local flat_email: [256]uint8
      printf("email: %s\n", login.email_input:get_text(&flat_email[0], 255))
      printf("password: [%d chars]\n", (@uint32)(login.password_input:get_text_len()))
    end

    -- ★ Phase 3.9: nebula_frame_render 现在包含文本渲染（一等公民）
    nebula_frame_render(&renderer, &login, &input, dt, 0.09, 0.09, 0.10)
  end

  wgpuSurfaceRelease(renderer.surface)
  wgpuDeviceRelease(renderer.device)
  wgpuAdapterRelease(renderer.adapter)
  wgpuInstanceRelease(renderer.instance)
  glfwDestroyWindow(window)
  glfwTerminate()
  printf("nebula: clean exit\n")
  return 0
end

main()
