-- text_editor_demo_v3.nelua — Phase 4.9.1: ~50 行文本编辑器（vs 85 行 v2）
-- 功能等价: 多语言高亮 + 选区/剪贴板 + 搜索替换 + 行号/状态栏 + Undo/Redo + File I/O + 自动缩进
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula"

-- ★ L1: 多语言语法高亮（6 语言内置，一行搞定）
