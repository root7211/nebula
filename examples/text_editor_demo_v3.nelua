-- =============================================================================
-- text_editor_demo_v3.nelua
-- Nebula GUI Compiler — Phase 4.9.1 推荐写法
--
-- 使用最新 sugar API：
--   · require "nebula" 统一入口
--   · nebula_highlight_builtins() 一键注册多语言高亮
--   · nebula_visual() + nebula_app() 声明式组件编排
--   · builtin Producer（search_bar / line_nums / edit_area / status_bar）
--   · nebula_init / nebula_should_close / nebula_frame_begin / nebula_shutdown
--     保留显式主循环
--
-- 演示能力：完整文本编辑器
--   · 多语言语法高亮（nelua/lua/c/python/json/markdown）
--   · 搜索/替换（Ctrl+F / Ctrl+H）
--   · 行号 + 状态栏
--   · 选区 + 剪贴板（Ctrl+C/V/X/A）
--   · Undo/Redo（Ctrl+Z/Y）
--   · File I/O（Ctrl+S 保存）
--   · 自动缩进
-- =============================================================================
require "nebula"
## cinclude "<stdio.h>"  -- snprintf for title update

-- ★ 注册多语言高亮规则（编译期）
## nebula_highlight_builtins({"nelua", "lua", "c", "python", "json", "markdown"})

-- ★ 声明编辑器 Visual（multiline_editable 原语）
## nebula_visual("EditorBgVisual", {
##   primitives   = {"multiline_editable"},
##   max_text_len = 256,
##   max_lines    = 256,
##   component_id = 1,
## })

-- ★ App 编排：搜索栏 + 行号/编辑区（横向 row）+ 状态栏
## nebula_app("TextEditorApp", {
##   components = {
##     { name = "editor",      type = "EditorBgVisual" },
##     { name = "search_bar",  builtin = "search_bar", flex_basis = 24 },
##     { name = "editor_body", row = true, flex_grow = 1,
##       children = { "line_nums", "edit_area" } },
##     { name = "line_nums",   builtin = "line_nums", flex_basis = 50 },
##     { name = "edit_area",   builtin = "edit_area", flex_grow = 1 },
##     { name = "status_bar",  builtin = "status_bar", flex_basis = 24 },
##   },
## })

-- =============================================================================
-- 主程序
-- =============================================================================

-- ★ WASM: 全局变量 + 帧回调（Nelua 限制：全局必须在顶层声明）
## if NEBULA_TARGET == 'wasm' then
global _wasm_editor_renderer: *NebulaRenderer = nilptr
global _wasm_editor_app: *TextEditorApp = nilptr
global _wasm_editor_input: NebulaInputState
global _wasm_editor_prev_time: float64 = 0.0

global function _wasm_editor_frame(): void
  glfwPollEvents()
  local now = glfwGetTime()
  local dt = (@float32)(now - _wasm_editor_prev_time)
  _wasm_editor_prev_time = now
  nebula_collect_input(_nebula_window, &_wasm_editor_input, dt)
  nebula_frame_render(_wasm_editor_renderer, _wasm_editor_app, &_wasm_editor_input, dt, 0.09, 0.09, 0.10)
end
## end

local function main(): int32
  local renderer: NebulaRenderer
  local app: TextEditorApp

  if not nebula_init(&renderer, &app, "Nebula — Text Editor", 900, 640) then
    return 1
  end

  -- 如果命令行指定了文件，加载它
  -- app.editor:load_file("example.nelua")

  local input: NebulaInputState

  ## if NEBULA_TARGET == 'wasm' then
  _wasm_editor_renderer = &renderer
  _wasm_editor_app = &app
  _wasm_editor_prev_time = glfwGetTime()
  emscripten_set_main_loop(_wasm_editor_frame, 0, 1)
  ## else
  while not nebula_should_close() do
    local dt = nebula_frame_begin(&input)
    nebula_frame_render(&renderer, &app, &input, dt, 0.09, 0.09, 0.10)
  end
  ## end

  app:deinit()
  nebula_shutdown(&renderer)
  return 0
end

main()
