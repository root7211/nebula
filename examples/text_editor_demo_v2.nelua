-- text_editor_demo_v2.nelua — Phase 4.9: ~90 行文本编辑器（vs 885 行 v1）
-- 功能等价: 多语言高亮 + 选区/剪贴板 + 搜索替换 + 行号/状态栏 + Undo/Redo + File I/O + 自动缩进
## cinclude "<stdio.h>"
## cinclude "<string.h>"

require "nebula"

-- ★ L1: 多语言语法高亮（6 语言 + 分发 + 扩展名检测，一行搞定）
##[[ nebula_highlight_pack({
  { name="nelua", exts={"nelua"},
    keywords={
      {words={"if","else","elseif","then","end","for","while","do","repeat","until","return","break","goto","in","switch","case","continue","defer"}, color=0xC586C0FF},
      {words={"local","global","function","require","record","enum","union","type"}, color=0x569CD6FF},
      {words={"true","false","nil","nilptr"}, color=0x4EC9B0FF},
      {words={"int8","int16","int32","int64","uint8","uint16","uint32","uint64","float32","float64","boolean","cstring","cint","csize","pointer","void","auto","byte","isize","usize"}, color=0x4DC9A0FF},
    }, line_comment="--", line_comment_color=0x6A9955FF, string_color=0xCE9178FF, number_color=0xB5CEA8FF },
  { name="lua", exts={"lua","luau"},
    keywords={
      {words={"if","else","elseif","then","end","for","while","do","repeat","until","return","break","goto","in"}, color=0xC586C0FF},
      {words={"local","function","require","not","and","or"}, color=0x569CD6FF},
      {words={"true","false","nil"}, color=0x4EC9B0FF},
    }, line_comment="--", line_comment_color=0x6A9955FF, string_color=0xCE9178FF, number_color=0xB5CEA8FF },
  { name="c", exts={"c","h","cpp","hpp","cc","cxx"},
    keywords={
      {words={"if","else","for","while","do","switch","case","default","break","continue","return","goto"}, color=0xC586C0FF},
      {words={"struct","enum","union","typedef","extern","static","const","volatile","inline","register","sizeof","include","define","ifdef","ifndef","endif","pragma"}, color=0x569CD6FF},
      {words={"int","char","float","double","void","long","short","unsigned","signed","size_t","uint8_t","uint16_t","uint32_t","uint64_t","int8_t","int16_t","int32_t","int64_t","bool","NULL"}, color=0x4EC9B0FF},
    }, line_comment="//", line_comment_color=0x6A9955FF, string_color=0xCE9178FF, number_color=0xB5CEA8FF },
  { name="python", exts={"py","pyw"},
    keywords={
      {words={"if","elif","else","for","while","break","continue","return","pass","raise","try","except","finally","with","as","yield","assert"}, color=0xC586C0FF},
      {words={"def","class","import","from","lambda","global","nonlocal","del","and","or","not","is","in"}, color=0x569CD6FF},
      {words={"True","False","None","self","cls"}, color=0x4EC9B0FF},
      {words={"int","float","str","bool","list","dict","tuple","set","bytes","range","print","len","type","isinstance","super","property","staticmethod","classmethod","enumerate","zip","map","filter"}, color=0x4DC9A0FF},
    }, line_comment="#", line_comment_color=0x6A9955FF, string_color=0xCE9178FF, number_color=0xB5CEA8FF },
  { name="json", exts={"json","jsonc"},
    keywords={ {words={"true","false","null"}, color=0x4EC9B0FF} },
    string_color=0xCE9178FF, number_color=0xB5CEA8FF },
  { name="markdown", exts={"md","mdx","markdown"},
    keywords={ {words={"TODO","FIXME","NOTE","HACK","XXX"}, color=0xDCDCAAFF} },
    line_comment="#", line_comment_color=0x569CD6FF, string_color=0xCE9178FF, number_color=0xB5CEA8FF },
}) ]]

-- ★ Visual + DenseText 管线
## nebula_visual("EditorBgVisual", {
