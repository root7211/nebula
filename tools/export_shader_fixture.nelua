-- =============================================================================
-- tools/export_shader_fixture.nelua
-- Nebula GUI Compiler — Phase 2.3.4
--
-- 编译期着色器 Fixture 导出工具
--
-- Phase 2.3.4 更新：
--   · 改用 ButtonVisual 的紧凑 std140 布局（80 字节，无 force_viewport_align）
--   · 与 nebula_derive 生成的 ButtonUniforms 完全对应
--   · 验证 headless_test.c 中 sizeof(ButtonUniforms) == 80 的断言
--
-- 用法：
--   nelua -L src tools/export_shader_fixture.nelua
--   （编译期即完成导出，无需实际运行可执行文件）
-- =============================================================================

require "nebula_core"

##[[

-- ===== 定义 ButtonVisual 规格（与 button_demo.nelua 保持一致）=====
-- 注意：nebula_annotate 必须在 nebula_parse_shape 之前调用
nebula_annotate("ButtonVisual_fixture", {
  states     = {"default", "hovered", "pressed"},
  primitives = {"hoverable", "clickable"},
  transitions = {
    {from="default", to="hovered", tween="ease_out", duration=0.15},
    {from="hovered", to="default", tween="ease_out", duration=0.15},
    {from="hovered", to="pressed", tween="none",     duration=0.0},
    {from="pressed", to="hovered", tween="ease_out", duration=0.1},
  },
})

-- 手动构造 base_fields 和 state_fields（因为 ButtonVisual_fixture 是虚拟注解，
-- 没有对应的 Nelua record，我们直接用 nebula_gen_uniform_layout_from_fields）
-- ButtonVisual 字段：pos(Vec2), size(Vec2), radius(f32), bg_color(Color),
--                   border_color(Color), border_width(f32)
-- 紧凑 std140 布局（无 force_viewport_align）：
--   pos          Vec2   offset 0   (8B)
--   size         Vec2   offset 8   (8B)
--   radius       f32    offset 16  (4B)
--   _pad0        f32    offset 20  (4B)  <-- 对齐 bg_color 到 16
--   _pad1        f32    offset 24  (4B)
--   _pad2        f32    offset 28  (4B)
--   bg_color     Color  offset 32  (16B)
--   border_color Color  offset 48  (16B)
--   border_width f32    offset 64  (4B)
--   _pad3        f32    offset 68  (4B)  <-- 对齐 viewport 到 8
--   viewport     Vec2   offset 72  (8B)
--   (末尾对齐到 16: 72+8=80, 80%16==0，无需追加 pad)
--   total: 80 bytes
local shader_result, shader_layout = nebula_gen_wgsl_shader_from_fields({
  record_name      = "ButtonUniforms",
  wgsl_struct_name = "Uniforms",
  fields = {
    {name="pos",          type="Vec2"},
    {name="size",         type="Vec2"},
    {name="radius",       type="float32"},
    {name="bg_color",     type="Color"},
    {name="border_color", type="Color"},
    {name="border_width", type="float32"},
  },
  append_viewport      = true,
  -- 不传 force_viewport_align：使用 std140 原生紧凑对齐 → 80 字节
})

-- 验证生成的布局大小
assert(shader_layout.total_size == 80,
  ("export_shader_fixture: expected 80B compact layout, got %dB"):format(
    shader_layout.total_size))

-- ===== 生成 C 头文件内容 =====
local h_lines = {}

table.insert(h_lines, "/*")
table.insert(h_lines, " * fixture_shader.h")
table.insert(h_lines, " * Auto-generated by tools/export_shader_fixture.nelua (Phase 2.3.4)")
table.insert(h_lines, " * DO NOT EDIT — regenerate with: nelua -L src tools/export_shader_fixture.nelua")
table.insert(h_lines, " *")
table.insert(h_lines, (" * Phase 2.3.4: 使用 ButtonUniforms 紧凑 std140 布局（%d 字节）"):format(
  shader_layout.total_size))
table.insert(h_lines, " * 对应 nebula_derive(\"ButtonVisual\") 生成的 ButtonUniforms 记录")
table.insert(h_lines, " */")
table.insert(h_lines, "#ifndef NEBULA_FIXTURE_SHADER_H")
table.insert(h_lines, "#define NEBULA_FIXTURE_SHADER_H")
table.insert(h_lines, "")

-- C 基础类型定义
table.insert(h_lines, "/* ── 基础类型（与 nebula_core.nelua 一致） ── */")
table.insert(h_lines, "typedef struct { float x, y; }       Vec2;")
table.insert(h_lines, "typedef struct { float r, g, b, a; } Color;")
table.insert(h_lines, "")

-- C 结构体（按 layout_fields 严格生成，包含 _pad 字段）
table.insert(h_lines, ("/* ── ButtonUniforms：紧凑 std140 布局，total %d bytes ── */"):format(
  shader_layout.total_size))
table.insert(h_lines, "typedef struct {")
for _, f in ipairs(shader_layout.fields) do
  local c_type
  if f.type == "float32" then c_type = "float"
  elseif f.type == "Vec2"    then c_type = "Vec2"
  elseif f.type == "Color"   then c_type = "Color"
  else c_type = "float"
  end
  table.insert(h_lines, ("    %-8s %-20s /* offset %2d */"):format(
    c_type, f.name .. ";", f.offset))
end
table.insert(h_lines, ("} ButtonUniforms;      /* total: %d bytes */"):format(
  shader_layout.total_size))
table.insert(h_lines, "")

-- 偏移量宏（供 headless_test.c 断言使用）
table.insert(h_lines, "/* ── 关键字段偏移量（供 static_assert 验证） ── */")
for _, f in ipairs(shader_layout.fields) do
  if not f.is_pad then
    local macro_name = "NEBULA_OFFSET_" .. f.name:upper()
    table.insert(h_lines, ("#define %-30s %d"):format(macro_name, f.offset))
  end
end
table.insert(h_lines, ("#define NEBULA_BUTTON_UNIFORMS_SIZE       %d"):format(
  shader_layout.total_size))
table.insert(h_lines, "")

-- WGSL 着色器源码（转为 C 字符串数组）
table.insert(h_lines, "/* ── WGSL 着色器源码（由着色器组合器自动生成） ── */")
table.insert(h_lines, "static const char FIXTURE_WGSL[] = ")
local wgsl_source = shader_result.source
for line in (wgsl_source .. "\n"):gmatch("([^\n]*)\n") do
  local escaped = line:gsub('"', '\\"')
  table.insert(h_lines, '"' .. escaped .. '\\n"')
end
table.insert(h_lines, ";")
table.insert(h_lines, "")

-- 元信息注释
table.insert(h_lines, ("/* Shader features: [%s] */"):format(
  table.concat(shader_result.features, ", ")))
table.insert(h_lines, ("/* Uniform size: %d bytes (compact std140, no force_viewport_align) */"):format(
  shader_layout.total_size))
table.insert(h_lines, ("/* Required passes: %d */"):format(#shader_result.required_passes))
table.insert(h_lines, "")
table.insert(h_lines, "#endif /* NEBULA_FIXTURE_SHADER_H */")

local header_content = table.concat(h_lines, "\n") .. "\n"

-- 写入文件
local f = io.open("tools/fixture_shader.h", "w")
if not f then
  f = io.open(fs.scriptdir() .. "/../tools/fixture_shader.h", "w")
end
if not f then
  f = io.open(fs.scriptdir() .. "/fixture_shader.h", "w")
end

if f then
  f:write(header_content)
  f:close()
  print("[export] fixture_shader.h written (Phase 2.3.4, compact 80B layout)")
else
  print("[export] WARNING: could not write fixture_shader.h, printing to stdout:")
  print(header_content)
end

print("[export] Shader features: [" .. table.concat(shader_result.features, ", ") .. "]")
print("[export] ButtonUniforms size: " .. shader_layout.total_size .. " bytes (compact std140)")
]]

-- 运行时：仅打印确认信息
## cinclude "<stdio.h>"
global function printf(fmt: cstring, ...: cvarargs): int32 <cimport, nodecl> end

local function main(): int32
  printf("export_shader_fixture: fixture_shader.h generated (Phase 2.3.4, compact 80B layout).\n")
  return 0
end

main()
